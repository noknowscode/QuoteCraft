<!--
  Rounded containers are Toolkit CardContentControls (Material outlined card) tuned by lightweight keys, not Borders.

  StaticCardStyle: a surface that is not a button. It fills its slot like the Borders it replaced (the Material base
  style centres the card) and takes no keyboard focus. The Material hover, pressed and focus washes are off for every
  card (App.xaml, D16); a card that can be tapped holds a ListCardButtonStyle button, which carries the hover, pressed
  and focus states, Enter and Space, and the item's accessible name.
  No attached-property setters here: on WinAppSDK a style BasedOn a Toolkit template throws on them
  (microsoft/microsoft-ui-xaml#6388).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:utu="using:Uno.Toolkit.UI">

  <Style x:Key="StaticCardStyle" TargetType="utu:CardContentControl"
         BasedOn="{StaticResource MaterialOutlinedCardContentControlStyle}">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource OutlineVariantBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <!--
    A raised surface (the quote's line items and notes, the client's history, the preview document): the Material
    elevated card, whose ElevatedView draws the shadow on every head. WinAppSDK's XAML compiler cannot set
    Translation or Shadow on a Toolkit control (WMC0612), so the Borders' ThemeShadow could not move over.
  -->
  <Style x:Key="ElevatedSurfaceCardStyle" TargetType="utu:CardContentControl"
         BasedOn="{StaticResource MaterialElevatedCardContentControlStyle}">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
  </Style>

  <!-- A surface card with the standard inset (stat cards, list cards) -->
  <Style x:Key="PaddedCardStyle" TargetType="utu:CardContentControl" BasedOn="{StaticResource StaticCardStyle}">
    <Setter Property="Padding" Value="{StaticResource CardInset}" />
  </Style>

  <!--
    The tap target of a list card (quotes, clients, catalog categories and items): a Material text button that fills
    the card, so the card gets Material's hover, pressed and focus states, a keyboard stop with Enter and Space, and a
    button's name for screen readers. Put the item's name on it (AutomationProperties.Name) and the command with the
    item as its parameter.
  -->
  <Style x:Key="ListCardButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialTextButtonStyle}">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    <Setter Property="Padding" Value="{StaticResource CardInset}" />
    <Setter Property="MinHeight" Value="{StaticResource TouchTarget}" />
  </Style>

  <!-- A tinted panel without a stroke: search fields, totals, notes, notices -->
  <Style x:Key="TonalCardStyle" TargetType="utu:CardContentControl" BasedOn="{StaticResource StaticCardStyle}">
    <Setter Property="Background" Value="{ThemeResource SurfaceVariantBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
  </Style>

  <!-- The slate gradient banner (dialog headers, line totals) -->
  <Style x:Key="BannerCardStyle" TargetType="utu:CardContentControl" BasedOn="{StaticResource StaticCardStyle}">
    <Setter Property="Background" Value="{StaticResource BannerGradientFixedBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="{StaticResource BannerInset}" />
  </Style>

  <!--
    A round initials badge (clients, categories): set Width, Height and CornerRadius per use. Keep its alignment
    Stretch and place it with its parent: the Material template passes the card's alignment to its own root, so a
    centred card shrinks its fill to the text inside.
  -->
  <Style x:Key="AvatarCardStyle" TargetType="utu:CardContentControl" BasedOn="{StaticResource StaticCardStyle}">
    <Setter Property="Background" Value="{ThemeResource PrimaryContainerBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource OnPrimaryContainerBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

</ResourceDictionary>
