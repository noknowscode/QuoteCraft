<!--
  Rounded containers are Toolkit CardContentControls (Material outlined card) tuned by lightweight keys, not Borders.

  StaticCardStyle: a surface that is not a button. It fills its slot like the Borders it replaced (the Material base
  style centres the card), takes no keyboard focus, and its hover, pressed and focus washes are transparent: on
  touch, a swipe that starts on a Material card can leave the hover wash up (uno-scaffolding gotchas, MorningCard).
  Cards that react to the pointer get their states from Helpers/InteractionHelper.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:utu="using:Uno.Toolkit.UI">

  <Style x:Key="StaticCardStyle" TargetType="utu:CardContentControl"
         BasedOn="{StaticResource MaterialOutlinedCardContentControlStyle}">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource OutlineVariantBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="utu:ResourceExtensions.Resources">
      <Setter.Value>
        <ResourceDictionary>
          <SolidColorBrush x:Key="FilledCardContentBorderBrushPointerOver" Color="Transparent" />
          <SolidColorBrush x:Key="FilledCardContentBorderBrushPressed" Color="Transparent" />
          <SolidColorBrush x:Key="FilledCardContentBorderBrushFocused" Color="Transparent" />
        </ResourceDictionary>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A surface card with the standard inset (stat cards, list cards) -->
  <Style x:Key="PaddedCardStyle" TargetType="utu:CardContentControl" BasedOn="{StaticResource StaticCardStyle}">
    <Setter Property="Padding" Value="{StaticResource CardInset}" />
  </Style>

  <!-- A tinted panel without a stroke: search fields, totals, notes, notices -->
  <Style x:Key="TonalCardStyle" TargetType="utu:CardContentControl" BasedOn="{StaticResource StaticCardStyle}">
    <Setter Property="Background" Value="{ThemeResource SurfaceVariantBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
  </Style>

  <!-- The slate gradient banner (dialog headers, line totals) -->
  <Style x:Key="BannerCardStyle" TargetType="utu:CardContentControl" BasedOn="{StaticResource StaticCardStyle}">
    <Setter Property="Background" Value="{StaticResource BannerGradientFixedBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="{StaticResource BannerInset}" />
  </Style>

  <!--
    A round initials badge (clients, categories): set Width, Height and CornerRadius per use. Keep its alignment
    Stretch and place it with its parent: the Material template passes the card's alignment to its own root, so a
    centred card shrinks its fill to the text inside.
  -->
  <Style x:Key="AvatarCardStyle" TargetType="utu:CardContentControl" BasedOn="{StaticResource StaticCardStyle}">
    <Setter Property="Background" Value="{ThemeResource PrimaryContainerBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource OnPrimaryContainerBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="AutomationProperties.AccessibilityView" Value="Raw" />
  </Style>

</ResourceDictionary>
