<!--
  Layout values the theme has no token for. Spacing, radius and control sizes come from the Material theme's tokens:
  Space* and Space*Thickness with their Horizontal, Vertical, Top, Bottom, Left and Right forms, Radius*CornerRadius,
  ControlHeight*, IconSize* and TouchTargetMinSize (on this theme SpaceN00 is N x 8 px and RadiusN00 N x 4 px; see
  App.xaml). Inline glyphs take the type-scale size of the text they sit in (BodySmallFontSize...).
  What stays here: insets whose two axes differ (no token says "16 left and right, 12 top and bottom"), every page's
  frame per size class, content widths and column widths, the shell's dimensions, the sizes of avatars, logos and
  marks, rules, the half-rounded corners of a document's header, and the SplitLayout breakpoints.
  Literals here, not references: WinUI cannot StaticResource across sibling merged dictionaries.

  Size classes (utu:Responsive, the Toolkit's default breakpoints):
    Narrow  (below 600)      phones: bottom tab bar, one pane, 16 px sides
    Normal  (600 to 800)     small tablets: bottom tab bar, one pane, 24 px sides
    Wide    (800 to 1080)    side rail, one pane, 32 px sides
    Widest  (1080 and up)    side rail, list and detail side by side, content capped at PageMaxWidth
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:utu="using:Uno.Toolkit.UI">

  <!--
    Breakpoints: the Toolkit defaults (Narrow 300, Normal 600, Wide 800, Widest 1080) everywhere, with one exception for
    two-column splits inside a pane (the quote and client detail with their side column, Settings with its live quote
    preview). From 1080 the side rail (156) and the list (380) leave the detail about 470 px, where a 300 px side column
    squeezes the line-item table below its content. They split at 1400 instead, where the detail has the ~800 px both
    columns need (measured at 1080 x 640 and 1920 x 640).
  -->
  <utu:ResponsiveLayout x:Key="SplitLayout" Narrowest="150" Narrow="300" Normal="600" Wide="800" Widest="1400" />

  <!-- Two-axis insets: h left and right, v top and bottom -->
  <Thickness x:Key="Inset8x4">8,4</Thickness>
  <Thickness x:Key="Inset12x4">12,4</Thickness>
  <Thickness x:Key="Inset12x8">12,8</Thickness>
  <Thickness x:Key="Inset16x8">16,8</Thickness>
  <Thickness x:Key="Inset16x12">16,12</Thickness>
  <Thickness x:Key="Inset20x12">20,12</Thickness>
  <Thickness x:Key="Inset20x16">20,16</Thickness>
  <Thickness x:Key="Inset24x12">24,12</Thickness>
  <Thickness x:Key="Inset32x16">32,16</Thickness>
  <Thickness x:Key="Inset32x24">32,24</Thickness>
  <!-- A status pill, a compact number field, the banner and its compact button, the onboarding's wide button -->
  <Thickness x:Key="PillInset">8,2</Thickness>
  <Thickness x:Key="CompactFieldInset">10,6</Thickness>
  <Thickness x:Key="BannerInset">20,16</Thickness>
  <Thickness x:Key="ButtonInsetCompact">16,6</Thickness>
  <Thickness x:Key="ButtonInsetWide">32,12</Thickness>

  <!-- Offsets: a list row's 1 px separator, the unread dot against the first text line, the unread badge on the bell,
       a text button whose leading icon lines up with the content edge below it -->
  <Thickness x:Key="RowSeparatorGap">0,0,0,1</Thickness>
  <Thickness x:Key="DotMargin">0,6,12,0</Thickness>
  <Thickness x:Key="BadgeOffset">4,-4,0,0</Thickness>
  <Thickness x:Key="LeadingIconNudge">-12,0,0,0</Thickness>
  <!-- A card's section label: card inset on the sides, a little less below -->
  <Thickness x:Key="SectionLabelInset">16,16,16,8</Thickness>
  <!-- The detail's side column (client, details, totals) beside the line items -->
  <Thickness x:Key="SideColumnMargin">8,0,16,0</Thickness>

  <!-- Page header band (title, count, search, primary action). Narrow stacks the search under the title row. -->
  <Thickness x:Key="PageHeaderInsetNarrow">16,8</Thickness>
  <x:Double x:Key="PageHeaderHeight">64</x:Double>
  <x:Double x:Key="SearchMaxWidth">360</x:Double>
  <!-- On Narrow the search has its own row and fills it (Narrow ends at 600) -->
  <x:Double x:Key="SearchMaxWidthNarrow">600</x:Double>
  <x:Double x:Key="SearchMinWidth">240</x:Double>

  <!-- Bands under the header (analytics cards, chips) and the list pane -->
  <Thickness x:Key="BandInsetNarrow">16,12</Thickness>
  <Thickness x:Key="BandInsetNormal">24,12</Thickness>
  <Thickness x:Key="BandInsetWide">32,12</Thickness>
  <Thickness x:Key="ChipBandInsetNarrow">16,8,16,4</Thickness>
  <Thickness x:Key="ChipBandInsetNormal">24,8,24,4</Thickness>
  <Thickness x:Key="ListInsetNarrow">12,8,12,16</Thickness>
  <Thickness x:Key="ListInsetNormal">20,8,20,16</Thickness>
  <Thickness x:Key="ListInsetWidest">12,8,12,16</Thickness>

  <!-- Detail panes and full-page forms -->
  <Thickness x:Key="PaneInsetNarrow">16,16,16,24</Thickness>
  <Thickness x:Key="PaneInsetNormal">24,20,24,32</Thickness>
  <Thickness x:Key="PaneInsetWide">32,24,32,32</Thickness>
  <Thickness x:Key="PaneInsetWidest">36,28,36,32</Thickness>
  <!-- The quote preview: the gutter around the document, and the document's own margins from Normal up (Narrow:
       Space200Thickness) -->
  <Thickness x:Key="PreviewGutterNarrow">8,16</Thickness>
  <Thickness x:Key="PreviewGutterWide">40,32</Thickness>
  <Thickness x:Key="DocumentInsetWide">32,24</Thickness>

  <!-- Content widths -->
  <x:Double x:Key="PageMaxWidth">1600</x:Double>
  <x:Double x:Key="ListPaneWidth">380</x:Double>
  <x:Double x:Key="DetailSideColumnWidth">340</x:Double>
  <x:Double x:Key="SummaryColumnWidth">280</x:Double>
  <x:Double x:Key="ReadingMaxWidth">720</x:Double>
  <x:Double x:Key="FormMaxWidth">560</x:Double>
  <x:Double x:Key="WelcomeMaxWidth">520</x:Double>
  <x:Double x:Key="HintMaxWidth">320</x:Double>
  <x:Double x:Key="DialogMinWidth">380</x:Double>
  <!-- Column widths (GridLength: a ColumnDefinition's Width takes no x:Double) -->
  <!-- A Settings row's label -->
  <GridLength x:Key="FormLabelWidth">140</GridLength>
  <!-- Line-item table columns (quantity, unit price and total), and the totals' amounts -->
  <GridLength x:Key="TableQtyWidth">60</GridLength>
  <GridLength x:Key="TableMoneyWidth">90</GridLength>
  <GridLength x:Key="TotalsValueWidth">120</GridLength>

  <!-- Settings: compact number fields with a unit, the logo thumbnail and file name, the preview's logo -->
  <x:Double x:Key="NumberFieldWidth">70</x:Double>
  <x:Double x:Key="CompactFieldHeight">28</x:Double>
  <x:Double x:Key="UnitLabelWidth">24</x:Double>
  <x:Double x:Key="CompactPickerMinWidth">90</x:Double>
  <x:Double x:Key="FileNameMaxWidth">120</x:Double>
  <x:Double x:Key="LogoThumbSize">32</x:Double>
  <x:Double x:Key="PreviewLogoSize">56</x:Double>

  <!-- Catalog browser dialog: its least height, and the scrolling list's tallest -->
  <x:Double x:Key="BrowserMinHeight">300</x:Double>
  <x:Double x:Key="BrowserListMaxHeight">320</x:Double>

  <!-- Shell -->
  <x:Double x:Key="RailWidth">156</x:Double>
  <x:Double x:Key="RailCollapsedWidth">56</x:Double>
  <x:Double x:Key="RailBrandHeight">61</x:Double>
  <x:Double x:Key="AccentBarHeight">3</x:Double>
  <x:Double x:Key="BottomTabBarHeight">56</x:Double>
  <Thickness x:Key="RailItemInset">12,8</Thickness>
  <Thickness x:Key="RailItemMargin">6,2</Thickness>
  <Thickness x:Key="RailActionMargin">6,8,6,0</Thickness>
  <Thickness x:Key="RailLastActionMargin">6,4,6,12</Thickness>

  <!-- Text areas' least heights -->
  <x:Double x:Key="NotesMinHeight">80</x:Double>
  <x:Double x:Key="MessageMinHeight">140</x:Double>

  <!-- The empty and error states' large glyph (the theme's largest icon size is 32) -->
  <x:Double x:Key="HeroIconSize">48</x:Double>

  <!-- Avatars, badges and marks -->
  <x:Double x:Key="AvatarSize">40</x:Double>
  <x:Double x:Key="AvatarSizeSm">36</x:Double>
  <x:Double x:Key="DotSize">8</x:Double>
  <x:Double x:Key="LogoSize">48</x:Double>
  <x:Double x:Key="LogoSizeLarge">64</x:Double>
  <x:Double x:Key="LogoSizeHero">80</x:Double>
  <x:Double x:Key="ThumbnailSize">100</x:Double>
  <x:Double x:Key="SparklineHeight">50</x:Double>
  <x:Double x:Key="StepBarWidth">40</x:Double>
  <x:Double x:Key="StepBarHeight">4</x:Double>
  <x:Double x:Key="HairlineThickness">1</x:Double>
  <x:Double x:Key="RuleThickness">2</x:Double>

  <!-- A document header and a table header round only their top corners, which no Radius*CornerRadius token says -->
  <CornerRadius x:Key="RadiusTopLg">12,12,0,0</CornerRadius>
  <CornerRadius x:Key="RadiusTopMd">8,8,0,0</CornerRadius>
</ResourceDictionary>
