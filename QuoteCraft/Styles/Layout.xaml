<!--
  Layout tokens (hand-authored). Pages, dialogs and controls reference these keys instead of literal spacing, insets,
  widths and touch sizes, so one edit here retunes every screen. Colours live in ColorPaletteOverride.xaml (Material
  roles), StatusColors.xaml (quote statuses) and App.xaml (brand and app roles); type comes from the Material ramp.

  Spacing scale: 4-based (2, 4, 8, 12, 16, 20, 24, 28, 32, 48). Off-scale gaps the pages had (6, 10, 14) snap to the
  nearest step. Thickness names:
    Inset{n}        n on all sides               Inset{h}x{v}    h left and right, v top and bottom
    GapTop{n} / GapBottom{n} / GapStart{n} / GapEnd{n}           one side only
  Responsive insets come per category and pages pick them with utu:Responsive:
    Narrow  (below 600)      phones: bottom tab bar, one pane, 16 px sides
    Normal  (600 to 800)     small tablets: bottom tab bar, one pane, 24 px sides
    Wide    (800 to 1080)    side rail, one pane, 32 px sides
    Widest  (1080 and up)    side rail, list and detail side by side, content capped at PageMaxWidth
  WinUI cannot StaticResource across sibling merged dictionaries, so the values here are literals.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:utu="using:Uno.Toolkit.UI">

  <!--
    Breakpoints: the Toolkit defaults (Narrow 300, Normal 600, Wide 800, Widest 1080) everywhere, with one exception for
    two-column splits inside a pane (the quote and client detail with their side column, Settings with its live quote
    preview). From 1080 the side rail (156) and the list (380) leave the detail about 470 px, where a 300 px side column
    squeezes the line-item table below its content. They split at 1400 instead, where the detail has the ~800 px both
    columns need (measured at 1080 x 640 and 1920 x 640).
  -->
  <utu:ResponsiveLayout x:Key="SplitLayout" Narrowest="150" Narrow="300" Normal="600" Wide="800" Widest="1400" />

  <!-- Spacing scale (Spacing, RowSpacing, ColumnSpacing) -->
  <x:Double x:Key="Space2">2</x:Double>
  <x:Double x:Key="Space4">4</x:Double>
  <x:Double x:Key="Space8">8</x:Double>
  <x:Double x:Key="Space12">12</x:Double>
  <x:Double x:Key="Space16">16</x:Double>
  <x:Double x:Key="Space20">20</x:Double>
  <x:Double x:Key="Space24">24</x:Double>
  <x:Double x:Key="Space28">28</x:Double>
  <x:Double x:Key="Space32">32</x:Double>

  <!-- Uniform and axis insets on the scale -->
  <Thickness x:Key="Inset4">4</Thickness>
  <Thickness x:Key="Inset8">8</Thickness>
  <Thickness x:Key="Inset12">12</Thickness>
  <Thickness x:Key="Inset16">16</Thickness>
  <Thickness x:Key="Inset24">24</Thickness>
  <Thickness x:Key="Inset32">32</Thickness>
  <Thickness x:Key="Inset8x2">8,2</Thickness>
  <Thickness x:Key="Inset8x4">8,4</Thickness>
  <Thickness x:Key="Inset12x4">12,4</Thickness>
  <Thickness x:Key="Inset12x8">12,8</Thickness>
  <Thickness x:Key="Inset16x8">16,8</Thickness>
  <Thickness x:Key="Inset16x12">16,12</Thickness>
  <Thickness x:Key="Inset20x0">20,0</Thickness>
  <Thickness x:Key="Inset20x12">20,12</Thickness>
  <Thickness x:Key="Inset20x16">20,16</Thickness>
  <Thickness x:Key="Inset24x12">24,12</Thickness>
  <Thickness x:Key="Inset32x12">32,12</Thickness>
  <Thickness x:Key="Inset32x16">32,16</Thickness>
  <Thickness x:Key="Inset32x24">32,24</Thickness>
  <Thickness x:Key="InsetY4">0,4</Thickness>
  <Thickness x:Key="InsetY8">0,8</Thickness>
  <Thickness x:Key="InsetY12">0,12</Thickness>
  <Thickness x:Key="InsetY16">0,16</Thickness>
  <Thickness x:Key="InsetY20">0,20</Thickness>
  <Thickness x:Key="InsetY24">0,24</Thickness>
  <Thickness x:Key="InsetX4">4,0</Thickness>
  <Thickness x:Key="InsetX8">8,0</Thickness>
  <Thickness x:Key="InsetX12">12,0</Thickness>
  <Thickness x:Key="InsetX16">16,0</Thickness>

  <!-- Button content insets: the accent button, and its compact form on banners -->
  <Thickness x:Key="ButtonInset">20,10</Thickness>
  <Thickness x:Key="ButtonInsetCompact">16,6</Thickness>
  <Thickness x:Key="ButtonInsetWide">32,12</Thickness>

  <!-- One-sided gaps (where a parent Spacing can't express it) -->
  <Thickness x:Key="GapTop2">0,2,0,0</Thickness>
  <Thickness x:Key="GapTop4">0,4,0,0</Thickness>
  <Thickness x:Key="GapTop8">0,8,0,0</Thickness>
  <Thickness x:Key="GapTop12">0,12,0,0</Thickness>
  <Thickness x:Key="GapTop16">0,16,0,0</Thickness>
  <Thickness x:Key="GapTop24">0,24,0,0</Thickness>
  <Thickness x:Key="GapBottom2">0,0,0,2</Thickness>
  <Thickness x:Key="GapBottom4">0,0,0,4</Thickness>
  <Thickness x:Key="GapBottom8">0,0,0,8</Thickness>
  <Thickness x:Key="GapBottom20">0,0,0,20</Thickness>
  <Thickness x:Key="GapBottom24">0,0,0,24</Thickness>
  <Thickness x:Key="GapStart4">4,0,0,0</Thickness>
  <Thickness x:Key="GapStart8">8,0,0,0</Thickness>
  <Thickness x:Key="GapStart12">12,0,0,0</Thickness>
  <Thickness x:Key="GapStart32">32,0,0,0</Thickness>
  <Thickness x:Key="GapEnd4">0,0,4,0</Thickness>
  <Thickness x:Key="GapEnd8">0,0,8,0</Thickness>
  <Thickness x:Key="GapEnd12">0,0,12,0</Thickness>
  <Thickness x:Key="GapEnd16">0,0,16,0</Thickness>
  <Thickness x:Key="GapEnd24">0,0,24,0</Thickness>
  <!-- A list row's 1 px separator, and the unread dot's offset to the first text line -->
  <Thickness x:Key="RowSeparatorGap">0,0,0,1</Thickness>
  <Thickness x:Key="DotMargin">0,6,12,0</Thickness>
  <!-- A text button whose leading icon lines up with the content edge below it -->
  <Thickness x:Key="LeadingIconNudge">-12,0,0,0</Thickness>
  <!-- A card's section label: card inset on the sides, a little less below -->
  <Thickness x:Key="SectionLabelInset">16,16,16,8</Thickness>
  <!-- The detail's side column (client, details, totals) beside the line items -->
  <Thickness x:Key="SideColumnMargin">8,0,16,0</Thickness>
  <!-- Text set against a 2 px taller neighbour (a count next to a headline figure) -->
  <Thickness x:Key="BaselineNudge">0,0,0,2</Thickness>

  <!-- Page header band (title, count, search, primary action). Narrow stacks the search under the title row. -->
  <Thickness x:Key="PageHeaderInsetNarrow">16,8</Thickness>
  <Thickness x:Key="PageHeaderInsetNormal">24,0</Thickness>
  <Thickness x:Key="PageHeaderInsetWide">32,0</Thickness>
  <x:Double x:Key="PageHeaderHeight">64</x:Double>
  <x:Double x:Key="SearchMaxWidth">360</x:Double>
  <!-- On Narrow the search has its own row and fills it (Narrow ends at 600) -->
  <x:Double x:Key="SearchMaxWidthNarrow">600</x:Double>
  <x:Double x:Key="SearchMinWidth">240</x:Double>
  <x:Double x:Key="SearchHeight">40</x:Double>

  <!-- Bands under the header (analytics cards, chips) and the list pane -->
  <Thickness x:Key="BandInsetNarrow">16,12</Thickness>
  <Thickness x:Key="BandInsetNormal">24,12</Thickness>
  <Thickness x:Key="BandInsetWide">32,12</Thickness>
  <Thickness x:Key="ChipBandInsetNarrow">16,8,16,4</Thickness>
  <Thickness x:Key="ChipBandInsetNormal">24,8,24,4</Thickness>
  <Thickness x:Key="ListInsetNarrow">12,8,12,16</Thickness>
  <Thickness x:Key="ListInsetNormal">20,8,20,16</Thickness>
  <Thickness x:Key="ListInsetWidest">12,8,12,16</Thickness>

  <!-- Detail panes and full-page forms -->
  <Thickness x:Key="PaneInsetNarrow">16,16,16,24</Thickness>
  <Thickness x:Key="PaneInsetNormal">24,20,24,32</Thickness>
  <Thickness x:Key="PaneInsetWide">32,24,32,32</Thickness>
  <Thickness x:Key="PaneInsetWidest">36,28,36,32</Thickness>
  <!-- The quote preview: the gutter around the document, and the document's own margins -->
  <Thickness x:Key="PreviewGutterNarrow">8,16</Thickness>
  <Thickness x:Key="PreviewGutterWide">40,32</Thickness>
  <Thickness x:Key="DocumentInsetNarrow">16,16</Thickness>
  <Thickness x:Key="DocumentInsetWide">32,24</Thickness>
  <Thickness x:Key="FormRowInset">20,0</Thickness>
  <Thickness x:Key="CardInset">16,12</Thickness>
  <Thickness x:Key="PillInset">8,2</Thickness>
  <Thickness x:Key="BannerInset">20,16</Thickness>
  <Thickness x:Key="TableCellInset">16,12</Thickness>
  <Thickness x:Key="TableHeaderInset">16,8</Thickness>

  <!-- Content widths -->
  <x:Double x:Key="PageMaxWidth">1600</x:Double>
  <x:Double x:Key="ListPaneWidth">380</x:Double>
  <x:Double x:Key="DetailSideColumnWidth">340</x:Double>
  <x:Double x:Key="SummaryColumnWidth">280</x:Double>
  <x:Double x:Key="ReadingMaxWidth">720</x:Double>
  <x:Double x:Key="FormMaxWidth">560</x:Double>
  <x:Double x:Key="WelcomeMaxWidth">520</x:Double>
  <x:Double x:Key="HintMaxWidth">320</x:Double>
  <x:Double x:Key="DialogMinWidth">380</x:Double>
  <!-- Width a ContentDialog takes around its content (its padding and its margin to the window) -->
  <x:Double x:Key="DialogChromeWidth">96</x:Double>
  <x:Double x:Key="FormLabelWidth">140</x:Double>
  <x:Double x:Key="FormLabelWidthNarrow">112</x:Double>
  <!-- Line-item table columns (quantity, unit price, total) -->
  <x:Double x:Key="TableQtyWidth">60</x:Double>
  <x:Double x:Key="TableMoneyWidth">90</x:Double>
  <x:Double x:Key="TotalsValueWidth">120</x:Double>

  <!-- Settings: compact number fields with a unit, the logo thumbnail and file name, the preview's logo -->
  <x:Double x:Key="NumberFieldWidth">70</x:Double>
  <x:Double x:Key="CompactFieldHeight">28</x:Double>
  <Thickness x:Key="CompactFieldInset">10,6</Thickness>
  <x:Double x:Key="UnitLabelWidth">24</x:Double>
  <x:Double x:Key="CompactPickerMinWidth">90</x:Double>
  <x:Double x:Key="FileNameMaxWidth">120</x:Double>
  <x:Double x:Key="LogoThumbSize">32</x:Double>
  <x:Double x:Key="PreviewLogoSize">56</x:Double>

  <!-- Catalog browser dialog: its least height, and the scrolling list's tallest -->
  <x:Double x:Key="BrowserMinHeight">300</x:Double>
  <x:Double x:Key="BrowserListMaxHeight">320</x:Double>

  <!-- Shell -->
  <x:Double x:Key="RailWidth">156</x:Double>
  <x:Double x:Key="RailCollapsedWidth">56</x:Double>
  <x:Double x:Key="RailBrandHeight">61</x:Double>
  <x:Double x:Key="AccentBarHeight">3</x:Double>
  <x:Double x:Key="BottomTabBarHeight">56</x:Double>
  <x:Double x:Key="RailItemHeight">44</x:Double>
  <Thickness x:Key="RailItemInset">12,8</Thickness>
  <Thickness x:Key="RailItemMargin">6,2</Thickness>
  <Thickness x:Key="RailActionMargin">6,8,6,0</Thickness>
  <Thickness x:Key="RailLastActionMargin">6,4,6,12</Thickness>

  <!-- Touch targets and row heights -->
  <x:Double x:Key="TouchTarget">44</x:Double>
  <x:Double x:Key="TouchTargetComfortable">48</x:Double>
  <x:Double x:Key="FormRowMinHeightNarrow">48</x:Double>
  <x:Double x:Key="FormRowMinHeight">40</x:Double>
  <x:Double x:Key="NotesMinHeight">80</x:Double>
  <x:Double x:Key="MessageMinHeight">140</x:Double>

  <!-- Icon sizes (FontIcon FontSize) -->
  <x:Double x:Key="IconSizeXs">10</x:Double>
  <x:Double x:Key="IconSizeSm">12</x:Double>
  <x:Double x:Key="IconSizeMd">14</x:Double>
  <x:Double x:Key="IconSizeLg">16</x:Double>
  <x:Double x:Key="IconSizeXl">18</x:Double>
  <x:Double x:Key="IconSize2xl">20</x:Double>
  <x:Double x:Key="IconSizeEmpty">36</x:Double>
  <x:Double x:Key="IconSizeHero">48</x:Double>

  <!-- Avatars, badges and marks -->
  <x:Double x:Key="AvatarSize">40</x:Double>
  <x:Double x:Key="AvatarSizeSm">36</x:Double>
  <x:Double x:Key="DotSize">8</x:Double>
  <x:Double x:Key="LogoSize">48</x:Double>
  <x:Double x:Key="LogoSizeLarge">64</x:Double>
  <x:Double x:Key="LogoSizeHero">80</x:Double>
  <x:Double x:Key="ThumbnailSize">100</x:Double>
  <x:Double x:Key="SparklineHeight">50</x:Double>
  <x:Double x:Key="StepBarWidth">40</x:Double>
  <x:Double x:Key="StepBarHeight">4</x:Double>
  <x:Double x:Key="HairlineThickness">1</x:Double>
  <x:Double x:Key="RuleThickness">2</x:Double>

  <!-- Corner radii -->
  <CornerRadius x:Key="RadiusXs">2</CornerRadius>
  <CornerRadius x:Key="RadiusSm">4</CornerRadius>
  <CornerRadius x:Key="RadiusMd">8</CornerRadius>
  <CornerRadius x:Key="RadiusPill">10</CornerRadius>
  <CornerRadius x:Key="RadiusLg">12</CornerRadius>
  <CornerRadius x:Key="RadiusXl">16</CornerRadius>
  <CornerRadius x:Key="RadiusTopLg">12,12,0,0</CornerRadius>
  <CornerRadius x:Key="RadiusTopMd">8,8,0,0</CornerRadius>
  <!-- Circles: half the avatar or icon-disc size -->
  <CornerRadius x:Key="RadiusCircle36">18</CornerRadius>
  <CornerRadius x:Key="RadiusCircle40">20</CornerRadius>
  <CornerRadius x:Key="RadiusCircle48">24</CornerRadius>
  <x:Double x:Key="RadiusMdValue">8</x:Double>
  <!-- The onboarding step bars are Rectangles, which take the radius as a number -->
  <x:Double x:Key="RadiusXsValue">2</x:Double>
</ResourceDictionary>
