<!-- !SendQuote: the choice goes back to the caller, which saves the PDF and opens the email (DashboardModel). -->
<ContentDialog x:Class="QuoteCraft.Presentation.SendQuoteDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:uen="using:Uno.Extensions.Navigation.UI"
               xmlns:utu="using:Uno.Toolkit.UI"
               xmlns:ctrl="using:QuoteCraft.Controls"
               Style="{StaticResource ContentDialogStyle}">
  <!-- The message scrolls inside its box, so the actions stay in view in a short window -->
    <StackPanel Spacing="{StaticResource Space12}"
                MinWidth="{utu:Responsive Narrow=0, Normal={StaticResource DialogMinWidth}}">
      <ctrl:DialogHeader Glyph="&#xE724;" Title="Send Quote" Subtitle="{Binding Heading}" Margin="{StaticResource GapBottom4}" />

      <TextBox Header="Recipient Email"
               Text="{Binding Recipient, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
               PlaceholderText="client@example.com"
               InputScope="EmailSmtpAddress"
               AutomationProperties.Name="Recipient email" />
      <TextBox Header="Subject"
               Text="{Binding Subject, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
               AutomationProperties.Name="Subject" />
      <TextBox Header="Message"
               Text="{Binding Body, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
               AcceptsReturn="True"
               TextWrapping="Wrap"
               MinHeight="{StaticResource MessageMinHeight}"
               MaxHeight="{StaticResource MessageMinHeight}"
               ScrollViewer.VerticalScrollBarVisibility="Auto"
               AutomationProperties.Name="Message" />

      <utu:CardContentControl Style="{StaticResource TonalCardStyle}"
                              Background="{ThemeResource TertiaryContainerBrush}"
                              Padding="{StaticResource Inset12x8}">
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
          <FontIcon Glyph="&#xE946;" FontSize="{StaticResource IconSizeMd}"
                    Foreground="{ThemeResource OnTertiaryContainerBrush}" VerticalAlignment="Center" />
          <TextBlock Text="The PDF will be downloaded. Please attach it to the email."
                     Style="{StaticResource BodySmall}"
                     Foreground="{ThemeResource OnTertiaryContainerBrush}"
                     TextWrapping="Wrap" VerticalAlignment="Center" />
        </StackPanel>
      </utu:CardContentControl>

      <!-- Three actions do not fit side by side in a phone's dialog: Download PDF Only gets its own row -->
      <Button Content="Download PDF Only" Command="{Binding DownloadPdfOnly}"
              Style="{StaticResource OutlinedButtonStyle}"
              HorizontalAlignment="Stretch" Margin="{StaticResource GapTop8}"
              AutomationProperties.Name="Download PDF only" />
      <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}" HorizontalAlignment="Right">
        <!-- xaml-lint: allow backbar - a dialog Cancel that closes the dialog, not a page back bar -->
        <Button Content="Cancel" uen:Navigation.Request="-" Style="{StaticResource TextButtonStyle}" AutomationProperties.Name="Cancel" />
        <Button Content="Send via Email" Command="{Binding SendByEmail}" Style="{StaticResource FilledButtonStyle}" AutomationProperties.Name="Send via email" />
      </StackPanel>
    </StackPanel>
</ContentDialog>
