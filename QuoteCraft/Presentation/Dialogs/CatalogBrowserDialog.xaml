<!--
  !CatalogBrowser: stays open while items are added; Done (the dialog's own button, so it stays in view under a long
  list) closes it and the caller reloads the quote.
-->
<ContentDialog x:Class="QuoteCraft.Presentation.CatalogBrowserDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:utu="using:Uno.Toolkit.UI"
               xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
               xmlns:ctrl="using:QuoteCraft.Controls"
               Style="{StaticResource MaterialContentDialogStyle}"
               CloseButtonText="Done"
               DefaultButton="Close">

  <StackPanel x:Name="BrowserRoot"
              Spacing="{StaticResource Space12}"
              MinWidth="{utu:Responsive Narrow=0, Normal={StaticResource DialogMinWidth}}"
              MinHeight="{StaticResource BrowserMinHeight}">

    <ctrl:DialogHeader Glyph="&#xE82D;" Title="Add from Catalog" Subtitle="Browse your saved items and add to this quote"
                       Margin="{StaticResource GapBottom4}" />

    <!-- Search -->
    <utu:CardContentControl Style="{StaticResource TonalCardStyle}"
                            Padding="{StaticResource InsetX12}" Height="{StaticResource SearchHeight}">
      <Grid ColumnSpacing="{StaticResource Space8}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <FontIcon Glyph="&#xE721;" FontSize="{StaticResource IconSizeMd}"
                  Foreground="{ThemeResource OnSurfaceVariantBrush}" VerticalAlignment="Center" />
        <TextBox Grid.Column="1"
                 Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 PlaceholderText="Search catalog..."
                 AutomationProperties.Name="Search catalog"
                 BorderThickness="0" Background="Transparent"
                 Padding="0" MinHeight="0"
                 VerticalAlignment="Center" />
      </Grid>
    </utu:CardContentControl>

    <!-- Categories: one row that scrolls sideways (a ChipGroup does not wrap) -->
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                  HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
      <utu:ChipGroup ItemsSource="{Binding Categories}"
                     SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                     SelectionMode="Single"
                     Style="{StaticResource MaterialFilterChipGroupStyle}"
                     ItemContainerStyle="{StaticResource MaterialChipStyle}"
                     AutomationProperties.Name="Category" />
    </ScrollViewer>

    <!-- Items -->
    <ScrollViewer MaxHeight="{StaticResource BrowserListMaxHeight}">
      <muxc:ItemsRepeater ItemsSource="{Binding Items}">
        <muxc:ItemsRepeater.Layout>
          <muxc:StackLayout Spacing="{StaticResource Space4}" />
        </muxc:ItemsRepeater.Layout>
        <muxc:ItemsRepeater.ItemTemplate>
          <DataTemplate>
            <utu:CardContentControl Style="{StaticResource StaticCardStyle}"
                                    CornerRadius="{StaticResource RadiusMd}"
                                    Padding="{StaticResource Inset12x8}">
              <Grid ColumnSpacing="{StaticResource Space8}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Spacing="{StaticResource Space2}">
                  <TextBlock Text="{Binding Description}" Style="{StaticResource BodyMedium}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Category}" Style="{StaticResource LabelSmall}"
                             Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Text="{Binding UnitPrice, Converter={StaticResource CurrencyFormatConverter}}"
                           FontFamily="{StaticResource MonospaceFontFamily}"
                           Style="{StaticResource BodyMedium}"
                           VerticalAlignment="Center" />
                <Button Grid.Column="2"
                        Command="{Binding DataContext.AddItem, ElementName=BrowserRoot}"
                        CommandParameter="{Binding}"
                        AutomationProperties.Name="Add to quote"
                        ToolTipService.ToolTip="Add to quote"
                        Style="{StaticResource MaterialTextButtonStyle}"
                        Padding="{StaticResource Inset8x4}" MinWidth="{StaticResource TouchTarget}" MinHeight="{StaticResource TouchTarget}">
                  <FontIcon Glyph="&#xE710;" FontSize="{StaticResource IconSizeLg}" />
                </Button>
              </Grid>
            </utu:CardContentControl>
          </DataTemplate>
        </muxc:ItemsRepeater.ItemTemplate>
      </muxc:ItemsRepeater>
    </ScrollViewer>

    <TextBlock Text="{Binding Status}"
               Style="{StaticResource BodySmall}"
               Foreground="{ThemeResource OnSurfaceVariantBrush}"
               TextWrapping="Wrap"
               AutomationProperties.LiveSetting="Polite" />
  </StackPanel>
</ContentDialog>
