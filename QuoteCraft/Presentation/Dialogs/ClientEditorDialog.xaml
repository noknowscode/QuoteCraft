<!-- !ClientEditor: Save writes the client and closes; it stays open with a message when something is wrong. -->
<ContentDialog x:Class="QuoteCraft.Presentation.ClientEditorDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:uen="using:Uno.Extensions.Navigation.UI"
               xmlns:utu="using:Uno.Toolkit.UI"
               xmlns:ctrl="using:QuoteCraft.Controls"
               Style="{StaticResource MaterialContentDialogStyle}">
  <StackPanel Spacing="{StaticResource Space16}"
              MinWidth="{utu:Responsive Narrow=0, Normal={StaticResource DialogMinWidth}}">
    <ctrl:DialogHeader Glyph="&#xE77B;" Title="{Binding Heading}" Subtitle="{Binding Subheading}"
                       Margin="{StaticResource GapBottom4}" />

    <TextBox Header="Name"
             Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
             PlaceholderText="Client or business name" />
    <TextBox Header="Email"
             Text="{Binding Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
             PlaceholderText="email@example.com"
             InputScope="EmailSmtpAddress" />
    <TextBox Header="Phone"
             Text="{Binding Phone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
             PlaceholderText="(555) 123-4567"
             InputScope="TelephoneNumber" />
    <TextBox Header="Address"
             Text="{Binding Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
             PlaceholderText="Street, City, State/Province"
             AcceptsReturn="True"
             TextWrapping="Wrap"
             MinHeight="{StaticResource NotesMinHeight}" />

    <TextBlock Text="{Binding ValidationError}"
               Style="{StaticResource BodySmall}"
               Foreground="{ThemeResource ErrorBrush}"
               TextWrapping="Wrap"
               AutomationProperties.LiveSetting="Assertive"
               Visibility="{Binding ValidationError, Converter={StaticResource EmptyToVisibleConverter}, ConverterParameter=Invert, FallbackValue=Collapsed}" />

    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}" HorizontalAlignment="Right">
      <!-- xaml-lint: allow backbar - a dialog Cancel that closes the dialog, not a page back bar -->
      <Button Content="Cancel" uen:Navigation.Request="-" Style="{StaticResource MaterialTextButtonStyle}" />
      <Button Content="Save" Command="{Binding Save}" Style="{StaticResource MaterialFilledButtonStyle}" />
    </StackPanel>
  </StackPanel>
</ContentDialog>
