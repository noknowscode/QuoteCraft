<Page x:Class="QuoteCraft.Presentation.OnboardingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="{ThemeResource BackgroundBrush}">

  <!--
    Onboarding: one centred column (WelcomeMaxWidth) at every size, scrolling when the window is short.
      Narrow   16 px sides; the two number fields of step 3 stack.
      Normal and up   32 px sides; the number fields sit side by side.
  -->
  <ScrollViewer utu:SafeArea.Insets="Top,Bottom" HorizontalScrollBarVisibility="Disabled">
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center"
          MaxWidth="{StaticResource WelcomeMaxWidth}"
          Padding="{utu:Responsive Narrow={StaticResource Space200Thickness}, Normal={StaticResource Space400Thickness}}">

      <!-- Step 1: Welcome -->
      <StackPanel Spacing="{StaticResource Space300}" HorizontalAlignment="Center"
                  Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibilityConverter}, ConverterParameter=1}">
        <utu:CardContentControl Style="{StaticResource ElevatedSurfaceCardStyle}" BorderThickness="0" Width="{StaticResource LogoSizeHero}" Height="{StaticResource LogoSizeHero}" CornerRadius="{StaticResource Radius400CornerRadius}"
                Background="{ThemeResource PrimaryBrush}" RequestedTheme="Light"
                AutomationProperties.AccessibilityView="Raw">
          <TextBlock Text="QC" Foreground="{ThemeResource OnPrimaryBrush}"
                     Style="{StaticResource HeadlineMediumBold}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </utu:CardContentControl>

        <TextBlock Text="Welcome to QuoteCraft"
                   Style="{StaticResource HeadlineMediumBold}"
                   AutomationProperties.HeadingLevel="Level1"
                   TextAlignment="Center" TextWrapping="Wrap"
                   HorizontalAlignment="Center" />
        <TextBlock Text="Set up your business in 60 seconds and start sending professional quotes today."
                   Style="{StaticResource BodyLarge}"
                   Foreground="{ThemeResource OnSurfaceVariantBrush}"
                   TextAlignment="Center" TextWrapping="Wrap"
                   HorizontalAlignment="Center" />

        <Button Command="{Binding NextStep}"
                Style="{StaticResource AccentButtonStyle}"
                HorizontalAlignment="Center"
                Padding="{StaticResource ButtonInsetWide}" Margin="{StaticResource Space100TopThickness}"
                AutomationProperties.Name="Get started">
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space100}">
            <TextBlock Text="Get Started" Style="{StaticResource LabelLargeSemiBold}" />
            <FontIcon Glyph="&#xE72A;" FontSize="{StaticResource BodyMediumFontSize}" />
          </StackPanel>
        </Button>

        <Button Command="{Binding Skip}"
                Style="{StaticResource TextButtonStyle}"
                MinHeight="{StaticResource ControlHeightMediumLarge}"
                HorizontalAlignment="Center"
                Content="Skip for now"
                AutomationProperties.Name="Skip for now" />

        <!-- What Skip could not do (a string state binds directly) -->
        <TextBlock Text="{Binding ValidationError}"
                   Foreground="{ThemeResource ErrorBrush}"
                   Style="{StaticResource BodyMedium}"
                   TextAlignment="Center" TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Assertive"
                   Visibility="{Binding ValidationError, Converter={StaticResource EmptyToVisibleConverter}, ConverterParameter=Invert, FallbackValue=Collapsed}" />
      </StackPanel>

      <!-- Step 2: Business Info -->
      <StackPanel Spacing="{StaticResource Space250}"
                  Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibilityConverter}, ConverterParameter=2}">
        <StackPanel Spacing="{StaticResource Space050}">
          <TextBlock Text="Your Business"
                     Style="{StaticResource TitleLargeBold}"
                     AutomationProperties.HeadingLevel="Level1" />
          <TextBlock Text="This info appears on every quote you send."
                     Style="{StaticResource BodyMedium}"
                     Foreground="{ThemeResource OnSurfaceVariantBrush}"
                     TextWrapping="Wrap" />
        </StackPanel>

        <!-- Progress: step 1 of 2, one bar per step (bars and a name, so it isn't colour alone) -->
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space100}" HorizontalAlignment="Center"
                    AutomationProperties.Name="Step 1 of 2">
          <Rectangle Width="{StaticResource StepBarWidth}" Height="{StaticResource StepBarHeight}" RadiusX="{StaticResource Radius050}" RadiusY="{StaticResource Radius050}"
                     Fill="{ThemeResource SecondaryBrush}" />
          <Rectangle Width="{StaticResource StepBarWidth}" Height="{StaticResource StepBarHeight}" RadiusX="{StaticResource Radius050}" RadiusY="{StaticResource Radius050}"
                     Fill="{ThemeResource OutlineVariantBrush}" />
        </StackPanel>

        <TextBox Header="Business Name"
                 Text="{Binding BusinessName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 PlaceholderText="e.g. Smith Plumbing LLC"
                 AutomationProperties.Name="Business name" />
        <TextBox Header="Phone"
                 Text="{Binding Phone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 PlaceholderText="(555) 123-4567"
                 InputScope="TelephoneNumber"
                 AutomationProperties.Name="Phone" />
        <TextBox Header="Email"
                 Text="{Binding Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 PlaceholderText="you@yourbusiness.com"
                 InputScope="EmailSmtpAddress"
                 AutomationProperties.Name="Email" />
        <TextBox Header="Address (optional)"
                 Text="{Binding Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 PlaceholderText="123 Trade St, Anytown USA"
                 AutomationProperties.Name="Address" />

        <!-- What stops the step (a string state binds directly; a FeedView over it never renders) -->
        <TextBlock Text="{Binding ValidationError}"
                   Foreground="{ThemeResource ErrorBrush}"
                   Style="{StaticResource BodyMedium}"
                   TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Assertive"
                   Visibility="{Binding ValidationError, Converter={StaticResource EmptyToVisibleConverter}, ConverterParameter=Invert, FallbackValue=Collapsed}" />

        <Grid ColumnSpacing="{StaticResource Space150}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Button Command="{Binding PreviousStep}"
                  Style="{StaticResource OutlinedButtonStyle}"
                  MinHeight="{StaticResource ControlHeightMediumLarge}"
                  CornerRadius="{StaticResource Radius200CornerRadius}" Content="Back"
                  AutomationProperties.Name="Back to welcome" />
          <Button Grid.Column="1" Command="{Binding NextStep}"
                  Style="{StaticResource AccentButtonStyle}"
                  AutomationProperties.Name="Next: quote settings">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space100}">
              <TextBlock Text="Next" Style="{StaticResource LabelLargeSemiBold}" />
              <FontIcon Glyph="&#xE72A;" FontSize="{StaticResource BodyMediumFontSize}" />
            </StackPanel>
          </Button>
        </Grid>
      </StackPanel>

      <!-- Step 3: Quote Settings -->
      <StackPanel Spacing="{StaticResource Space250}"
                  Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibilityConverter}, ConverterParameter=3}">
        <StackPanel Spacing="{StaticResource Space050}">
          <TextBlock Text="Quote Settings"
                     Style="{StaticResource TitleLargeBold}"
                     AutomationProperties.HeadingLevel="Level1" />
          <TextBlock Text="Set your defaults. You can change these anytime in Settings."
                     Style="{StaticResource BodyMedium}"
                     Foreground="{ThemeResource OnSurfaceVariantBrush}"
                     TextWrapping="Wrap" />
        </StackPanel>

        <!-- Progress: step 2 of 2 -->
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space100}" HorizontalAlignment="Center"
                    AutomationProperties.Name="Step 2 of 2">
          <Rectangle Width="{StaticResource StepBarWidth}" Height="{StaticResource StepBarHeight}" RadiusX="{StaticResource Radius050}" RadiusY="{StaticResource Radius050}"
                     Fill="{ThemeResource SecondaryBrush}" />
          <Rectangle Width="{StaticResource StepBarWidth}" Height="{StaticResource StepBarHeight}" RadiusX="{StaticResource Radius050}" RadiusY="{StaticResource Radius050}"
                     Fill="{ThemeResource SecondaryBrush}" />
        </StackPanel>

        <!-- The two number fields stack on Narrow -->
        <Grid ColumnSpacing="{utu:Responsive Narrow=0, Normal={StaticResource Space200}}"
              RowSpacing="{utu:Responsive Narrow={StaticResource Space250}, Normal=0}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBox Header="Default Tax Rate (%)"
                   Grid.ColumnSpan="{utu:Responsive Narrow=2, Normal=1}"
                   Text="{Binding TaxRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   InputScope="Number"
                   AutomationProperties.Name="Default tax rate (%)" />
          <TextBox Grid.Row="{utu:Responsive Narrow=1, Normal=0}"
                   Grid.Column="{utu:Responsive Narrow=0, Normal=1}"
                   Grid.ColumnSpan="{utu:Responsive Narrow=2, Normal=1}"
                   Header="Quote Valid For (days)"
                   Text="{Binding ValidDays, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   InputScope="Number"
                   AutomationProperties.Name="Quote valid for (days)" />
        </Grid>

        <TextBox Header="Quote Number Prefix"
                 Text="{Binding QuotePrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 PlaceholderText="QC-"
                 AutomationProperties.Name="Quote number prefix" />

        <!-- Catalog note (a Grid, so the text wraps: a horizontal StackPanel gives it unlimited width) -->
        <utu:CardContentControl Style="{StaticResource TonalCardStyle}" Padding="{StaticResource Inset16x12}">
          <Grid ColumnSpacing="{StaticResource Space150}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE82D;" FontSize="{StaticResource IconSizeSmall}"
                      Foreground="{ThemeResource PrimaryBrush}"
                      VerticalAlignment="Top" />
            <StackPanel Grid.Column="1" Spacing="{StaticResource Space050}">
              <TextBlock Text="Pre-loaded catalog"
                         Style="{StaticResource BodyMediumSemiBold}" />
              <TextBlock Text="We've loaded a starter catalog (plumbing, electrical, HVAC, painting, general contracting, materials and labor) with suggested prices. Review and adjust them in the Catalog tab to match your market rates."
                         Style="{StaticResource BodySmall}"
                         Foreground="{ThemeResource OnSurfaceVariantBrush}"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
        </utu:CardContentControl>

        <!-- What stops the step (a string state binds directly; a FeedView over it never renders) -->
        <TextBlock Text="{Binding ValidationError}"
                   Foreground="{ThemeResource ErrorBrush}"
                   Style="{StaticResource BodyMedium}"
                   TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Assertive"
                   Visibility="{Binding ValidationError, Converter={StaticResource EmptyToVisibleConverter}, ConverterParameter=Invert, FallbackValue=Collapsed}" />

        <Grid ColumnSpacing="{StaticResource Space150}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Button Command="{Binding PreviousStep}"
                  Style="{StaticResource OutlinedButtonStyle}"
                  MinHeight="{StaticResource ControlHeightMediumLarge}"
                  CornerRadius="{StaticResource Radius200CornerRadius}" Content="Back"
                  AutomationProperties.Name="Back to your business" />
          <Button Grid.Column="1" Command="{Binding Complete}"
                  Style="{StaticResource AccentButtonStyle}"
                  AutomationProperties.Name="Create first quote">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space100}">
              <TextBlock Text="Create First Quote" Style="{StaticResource LabelLargeSemiBold}" />
              <FontIcon Glyph="&#xE710;" FontSize="{StaticResource BodyMediumFontSize}" />
            </StackPanel>
          </Button>
        </Grid>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</Page>
