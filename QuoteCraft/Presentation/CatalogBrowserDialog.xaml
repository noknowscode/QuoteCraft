<ContentDialog x:Class="QuoteCraft.Presentation.CatalogBrowserDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:utu="using:Uno.Toolkit.UI"
               Style="{StaticResource MaterialContentDialogStyle}"
               xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
               CloseButtonText="Done"
               DefaultButton="Close">

  <StackPanel Spacing="{StaticResource Space12}" MinWidth="{utu:Responsive Narrow=0, Normal={StaticResource DialogMinWidth}}" MinHeight="{StaticResource BrowserMinHeight}">

    <!-- Gradient Header Banner -->
    <Border x:Name="HeaderBanner" Background="{StaticResource BannerGradientFixedBrush}" CornerRadius="{StaticResource RadiusLg}" Padding="{StaticResource BannerInset}" Margin="{StaticResource GapBottom4}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <FontIcon x:Name="HeaderIcon" Foreground="{StaticResource AppBarAccentInvariantBrush}" Glyph="&#xE82D;" FontSize="{StaticResource IconSize2xl}"
                  VerticalAlignment="Center" Margin="{StaticResource GapEnd12}" />
        <StackPanel Grid.Column="1" Spacing="{StaticResource Space2}">
          <TextBlock x:Name="HeaderTitle" Foreground="{StaticResource AppBarForegroundFixedBrush}" TextWrapping="Wrap" Text="Add from Catalog"
                     Style="{StaticResource TitleMediumBold}" />
          <TextBlock x:Name="HeaderSubtitle" Foreground="{StaticResource UpgradeBannerSubtitleFixedBrush}" TextWrapping="Wrap"
                     Text="Browse your saved items and add to this quote"
                     Style="{StaticResource BodySmall}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Search Box -->
    <Border Background="{ThemeResource SurfaceVariantBrush}"
            CornerRadius="{StaticResource RadiusMd}" Padding="{StaticResource InsetX12}" Height="{StaticResource SearchHeight}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <FontIcon Glyph="&#xE721;" FontSize="{StaticResource IconSizeMd}"
                  Foreground="{ThemeResource OnSurfaceVariantBrush}"
                  VerticalAlignment="Center" Margin="{StaticResource GapEnd8}" />
        <TextBox x:Name="SearchBox" Grid.Column="1"
                 PlaceholderText="Search catalog..."
                 AutomationProperties.Name="Search catalog"
                 BorderThickness="0" Background="Transparent"
                 Padding="0" MinHeight="0"
                 VerticalAlignment="Center"
                 TextChanged="SearchBox_TextChanged" />
      </Grid>
    </Border>

    <!-- Category Chips -->
    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Disabled"
                  HorizontalScrollMode="Enabled">
      <StackPanel x:Name="CategoryChips"
                  Orientation="Horizontal" Spacing="{StaticResource Space8}" />
    </ScrollViewer>

    <!-- Items List -->
    <ScrollViewer MaxHeight="{StaticResource BrowserListMaxHeight}">
      <muxc:ItemsRepeater x:Name="CatalogItemsList">
        <muxc:ItemsRepeater.Layout>
          <muxc:StackLayout Spacing="{StaticResource Space4}" />
        </muxc:ItemsRepeater.Layout>
        <muxc:ItemsRepeater.ItemTemplate>
          <DataTemplate>
            <Border Background="{ThemeResource SurfaceBrush}"
                    BorderBrush="{ThemeResource OutlineVariantBrush}"
                    BorderThickness="1" CornerRadius="{StaticResource RadiusMd}"
                    Padding="{StaticResource Inset12x8}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Spacing="{StaticResource Space2}">
                  <TextBlock Text="{Binding Description}"
                             Style="{StaticResource BodyMedium}" />
                  <TextBlock Text="{Binding Category}"
                             Style="{StaticResource LabelSmall}"
                             Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Text="{Binding UnitPrice, Converter={StaticResource CurrencyFormatConverter}}"
                           FontFamily="{StaticResource MonospaceFontFamily}"
                           Style="{StaticResource BodyMedium}"
                           VerticalAlignment="Center" Margin="{StaticResource GapEnd8}" />
                <Button Grid.Column="2" Click="AddItem_Click"
                        AutomationProperties.Name="Add to quote"
                        ToolTipService.ToolTip="Add to quote"
                        Style="{StaticResource MaterialTextButtonStyle}"
                        Padding="{StaticResource Inset8x4}" MinWidth="{StaticResource TouchTarget}" MinHeight="{StaticResource TouchTarget}">
                  <FontIcon Glyph="&#xE710;" FontSize="{StaticResource IconSizeLg}" />
                </Button>
              </Grid>
            </Border>
          </DataTemplate>
        </muxc:ItemsRepeater.ItemTemplate>
      </muxc:ItemsRepeater>
    </ScrollViewer>

  </StackPanel>
</ContentDialog>
