<Page x:Class="QuoteCraft.Presentation.QuoteEditorPage"
      x:Name="EditorRoot"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:QuoteCraft.Presentation"
      xmlns:uen="using:Uno.Extensions.Navigation.UI"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:um="using:Uno.Material"
      xmlns:mvux="using:Uno.Extensions.Reactive.UI"
      xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
      Background="{ThemeResource BackgroundBrush}">

  <!--
    Quote editor: one column at every size, capped at ReadingMaxWidth (720) and centred from Normal up.
      Narrow   16 px sides; the line-item actions go under the "Line Items" heading; status actions stack full width.
      Normal / Wide / Widest   wider insets; actions beside their headings; status actions in a row.
  -->
  <Grid utu:SafeArea.Insets="Top">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition />
    </Grid.RowDefinitions>

    <!-- The back arrow is an explicit action: it shows (and works) however the editor was opened. -->
    <utu:NavigationBar MainCommandMode="Action">
      <utu:NavigationBar.Content>
        <mvux:FeedView Source="{Binding QuoteNumber}">
          <DataTemplate>
            <TextBlock Text="{Binding Data}"
                       Style="{StaticResource TitleMedium}"
                       TextTrimming="CharacterEllipsis" />
          </DataTemplate>
        </mvux:FeedView>
      </utu:NavigationBar.Content>
      <utu:NavigationBar.MainCommand>
        <AppBarButton Click="BackButton_Click"
                      Label="Back"
                      AutomationProperties.Name="Go back"
                      ToolTipService.ToolTip="Go back">
          <AppBarButton.Icon>
            <FontIcon Glyph="&#xE72B;" />
          </AppBarButton.Icon>
        </AppBarButton>
      </utu:NavigationBar.MainCommand>
      <utu:NavigationBar.PrimaryCommands>
        <AppBarButton Label="Save"
                      AutomationProperties.Name="Save quote"
                      Command="{Binding Save}">
          <AppBarButton.Icon>
            <FontIcon Glyph="&#xE74E;" />
          </AppBarButton.Icon>
        </AppBarButton>
      </utu:NavigationBar.PrimaryCommands>
    </utu:NavigationBar>

    <!-- Saving -->
    <ProgressBar Grid.Row="1" IsIndeterminate="True"
                 AutomationProperties.Name="Saving"
                 Visibility="{Binding IsSaving, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}" />

    <ScrollViewer Grid.Row="2">
      <utu:AutoLayout Padding="{utu:Responsive Narrow={StaticResource PaneInsetNarrow}, Normal={StaticResource PaneInsetNormal}}"
                      Spacing="{StaticResource Space16}"
                      Orientation="Vertical"
                      MaxWidth="{StaticResource ReadingMaxWidth}"
                      HorizontalAlignment="Stretch">

        <!-- Quote Title -->
        <TextBox Header="Quote Title"
                 Text="{Binding Title, Mode=TwoWay}"
                 PlaceholderText="e.g. Kitchen Renovation" />

        <!-- Client Name (Material text field, like the fields around it) -->
        <AutoSuggestBox x:Name="ClientAutoSuggestBox"
                        Header="Client Name"
                        Text="{Binding ClientName, Mode=TwoWay}"
                        PlaceholderText="Search clients or type a name"
                        TextBoxStyle="{StaticResource MaterialOutlinedTextBoxStyle}"
                        BorderThickness="1" BorderBrush="{ThemeResource OutlineBrush}" Background="Transparent"
                        TextChanged="ClientAutoSuggest_TextChanged"
                        SuggestionChosen="ClientAutoSuggest_SuggestionChosen"
                        AutomationProperties.Name="Client name" />

        <!-- Tax Rate -->
        <TextBox Header="Tax Rate (%)"
                 Text="{Binding TaxRate, Mode=TwoWay}"
                 PlaceholderText="13"
                 InputScope="Number" />

        <!-- Line Items Section (the actions go under the heading on Narrow) -->
        <Grid utu:AutoLayout.PrimaryAlignment="Stretch"
              MinHeight="{StaticResource TouchTarget}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock Text="Line Items"
                     Style="{StaticResource TitleMedium}"
                     AutomationProperties.HeadingLevel="Level2"
                     VerticalAlignment="Center" />
          <StackPanel Grid.Row="{utu:Responsive Narrow=1, Normal=0}"
                      Grid.Column="{utu:Responsive Narrow=0, Normal=1}"
                      Orientation="Horizontal" Spacing="{StaticResource Space4}">
            <Button Click="OpenCatalogBrowser_Click"
                    Style="{StaticResource MaterialTextButtonStyle}"
                    MinHeight="{StaticResource TouchTarget}">
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space4}">
                <FontIcon Glyph="&#xE82D;" FontSize="{StaticResource IconSizeMd}" />
                <TextBlock Text="From Catalog" />
              </StackPanel>
            </Button>
            <Button Click="OpenAddLineItem_Click"
                    Style="{StaticResource MaterialTextButtonStyle}"
                    MinHeight="{StaticResource TouchTarget}">
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space4}">
                <FontIcon Glyph="&#xE710;" FontSize="{StaticResource IconSizeMd}" />
                <TextBlock Text="Add Item" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>

        <mvux:FeedView Source="{Binding LineItems}"
                       HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
          <DataTemplate>
            <ItemsControl ItemsSource="{Binding Data}" IsTabStop="False" HorizontalAlignment="Stretch">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <utu:CardContentControl Margin="{StaticResource InsetY4}"
                                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                          Style="{StaticResource MaterialOutlinedCardContentControlStyle}"
                                          IsTabStop="True"
                                          UseSystemFocusVisuals="True"
                                          AutomationProperties.Name="{Binding Description}"
                                          Tapped="LineItemCard_Tapped"
                                          KeyDown="LineItemCard_KeyDown">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <utu:AutoLayout Padding="{StaticResource Inset16}"
                                      Spacing="{StaticResource Space8}"
                                      Orientation="Vertical"
                                      HorizontalAlignment="Stretch">
                        <TextBlock Text="{Binding Description}"
                                   Style="{StaticResource BodyLarge}"
                                   TextWrapping="Wrap" />
                        <Grid ColumnSpacing="{StaticResource Space8}" utu:AutoLayout.CounterAlignment="Stretch">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>

                          <TextBlock Style="{StaticResource BodySmall}"
                                     Foreground="{ThemeResource OnSurfaceVariantBrush}"
                                     VerticalAlignment="Center">
                            <Run Text="Qty " /><Run Text="{Binding Quantity}" /><Run Text=" × " /><Run Text="{Binding UnitPrice, Converter={StaticResource CurrencyFormatConverter}}" />
                          </TextBlock>

                          <TextBlock Grid.Column="1"
                                     Text="{Binding LineTotal, Converter={StaticResource CurrencyFormatConverter}}"
                                     Style="{StaticResource LabelLarge}"
                                     FontFamily="{StaticResource MonospaceFontFamily}"
                                     Foreground="{ThemeResource PrimaryBrush}"
                                     VerticalAlignment="Center" />
                        </Grid>
                      </utu:AutoLayout>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                  Spacing="{StaticResource Space2}" Margin="{StaticResource GapEnd8}">
                        <Button Command="{Binding DataContext.MoveLineItemUp, ElementName=EditorRoot}"
                                CommandParameter="{Binding}"
                                AutomationProperties.Name="Move line item up"
                                ToolTipService.ToolTip="Move up"
                                Style="{StaticResource MaterialTextButtonStyle}"
                                MinWidth="{StaticResource TouchTargetComfortable}" MinHeight="{StaticResource TouchTargetComfortable}"
                                Padding="{StaticResource Inset8}"
                                VerticalAlignment="Center">
                          <FontIcon Glyph="&#xE70E;" FontSize="{StaticResource IconSizeSm}" />
                        </Button>
                        <Button Command="{Binding DataContext.MoveLineItemDown, ElementName=EditorRoot}"
                                CommandParameter="{Binding}"
                                AutomationProperties.Name="Move line item down"
                                ToolTipService.ToolTip="Move down"
                                Style="{StaticResource MaterialTextButtonStyle}"
                                MinWidth="{StaticResource TouchTargetComfortable}" MinHeight="{StaticResource TouchTargetComfortable}"
                                Padding="{StaticResource Inset8}"
                                VerticalAlignment="Center">
                          <FontIcon Glyph="&#xE70D;" FontSize="{StaticResource IconSizeSm}" />
                        </Button>
                      </StackPanel>
                    </Grid>
                  </utu:CardContentControl>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </DataTemplate>

          <mvux:FeedView.NoneTemplate>
            <DataTemplate>
              <StackPanel HorizontalAlignment="Center" Spacing="{StaticResource Space8}" Margin="{StaticResource InsetY24}">
                <FontIcon Glyph="&#xE70F;" FontSize="{StaticResource IconSizeEmpty}"
                          Foreground="{ThemeResource OnSurfaceVariantBrush}"
                          HorizontalAlignment="Center" />
                <TextBlock Text="No line items yet"
                           Style="{StaticResource BodyLarge}"
                           Foreground="{ThemeResource OnSurfaceVariantBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Add items from catalog or create custom entries"
                           Style="{StaticResource BodyMedium}"
                           Foreground="{ThemeResource OnSurfaceVariantBrush}"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
              </StackPanel>
            </DataTemplate>
          </mvux:FeedView.NoneTemplate>

          <mvux:FeedView.ProgressTemplate>
            <DataTemplate>
              <ProgressRing IsActive="True" HorizontalAlignment="Center" Margin="{StaticResource InsetY24}"
                            AutomationProperties.Name="Loading line items" />
            </DataTemplate>
          </mvux:FeedView.ProgressTemplate>

          <mvux:FeedView.ErrorTemplate>
            <DataTemplate>
              <StackPanel HorizontalAlignment="Center" Spacing="{StaticResource Space8}" Margin="{StaticResource InsetY24}"
                          AutomationProperties.LiveSetting="Polite">
                <TextBlock Text="Line items could not be loaded." Style="{StaticResource BodyLarge}"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                <Button Content="Retry"
                        Command="{Binding DataContext.Reload, ElementName=EditorRoot}"
                        Style="{StaticResource MaterialOutlinedButtonStyle}"
                        HorizontalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </mvux:FeedView.ErrorTemplate>
        </mvux:FeedView>

        <!-- Photos Section -->
        <Grid utu:AutoLayout.PrimaryAlignment="Stretch"
              MinHeight="{StaticResource TouchTarget}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="Photos"
                     Style="{StaticResource TitleMedium}"
                     AutomationProperties.HeadingLevel="Level2"
                     VerticalAlignment="Center" />
          <Button Grid.Column="1"
                  Click="AddPhoto_Click"
                  Style="{StaticResource MaterialFilledTonalButtonStyle}"
                  MinHeight="{StaticResource TouchTarget}"
                  VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
              <FontIcon Glyph="&#xE722;" FontSize="{StaticResource IconSizeMd}" />
              <TextBlock Text="Add Photo" />
            </StackPanel>
          </Button>
        </Grid>

        <mvux:FeedView Source="{Binding Photos}"
                       HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
          <DataTemplate>
            <muxc:ItemsRepeater ItemsSource="{Binding Data}">
              <muxc:ItemsRepeater.Layout>
                <muxc:UniformGridLayout MinItemWidth="{StaticResource ThumbnailSize}" MinItemHeight="{StaticResource ThumbnailSize}"
                                        MinColumnSpacing="{StaticResource Space8}" MinRowSpacing="{StaticResource Space8}" />
              </muxc:ItemsRepeater.Layout>
              <muxc:ItemsRepeater.ItemTemplate>
                <DataTemplate>
                  <Grid Width="{StaticResource ThumbnailSize}" Height="{StaticResource ThumbnailSize}">
                    <Border CornerRadius="{StaticResource RadiusMd}" BorderBrush="{ThemeResource OutlineVariantBrush}"
                            BorderThickness="1">
                      <Image Stretch="UniformToFill" AutomationProperties.Name="Job photo">
                        <Image.Source>
                          <BitmapImage UriSource="{Binding}" />
                        </Image.Source>
                      </Image>
                    </Border>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                            Command="{Binding DataContext.DeletePhoto, ElementName=EditorRoot}"
                            CommandParameter="{Binding}"
                            AutomationProperties.Name="Delete photo"
                            ToolTipService.ToolTip="Delete photo"
                            Background="{StaticResource ScrimBrush}"
                            MinWidth="{StaticResource TouchTarget}" MinHeight="{StaticResource TouchTarget}"
                            Padding="0" CornerRadius="{StaticResource RadiusMd}">
                      <FontIcon Glyph="&#xE711;" FontSize="{StaticResource IconSizeSm}" Foreground="{StaticResource AppBarForegroundBrush}" />
                    </Button>
                  </Grid>
                </DataTemplate>
              </muxc:ItemsRepeater.ItemTemplate>
            </muxc:ItemsRepeater>
          </DataTemplate>

          <mvux:FeedView.NoneTemplate>
            <DataTemplate>
              <StackPanel HorizontalAlignment="Center" Spacing="{StaticResource Space8}" Margin="{StaticResource InsetY16}">
                <FontIcon Glyph="&#xE722;" FontSize="{StaticResource IconSizeEmpty}"
                          Foreground="{ThemeResource OnSurfaceVariantBrush}"
                          HorizontalAlignment="Center" />
                <TextBlock Text="No photos attached"
                           Style="{StaticResource BodyLarge}"
                           Foreground="{ThemeResource OnSurfaceVariantBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Add photos to document the job"
                           Style="{StaticResource BodyMedium}"
                           Foreground="{ThemeResource OnSurfaceVariantBrush}"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
              </StackPanel>
            </DataTemplate>
          </mvux:FeedView.NoneTemplate>

          <mvux:FeedView.ErrorTemplate>
            <DataTemplate>
              <StackPanel HorizontalAlignment="Center" Spacing="{StaticResource Space8}" Margin="{StaticResource InsetY16}"
                          AutomationProperties.LiveSetting="Polite">
                <TextBlock Text="Photos could not be loaded." Style="{StaticResource BodyLarge}"
                           HorizontalAlignment="Center" />
                <Button Content="Retry"
                        Command="{Binding DataContext.Reload, ElementName=EditorRoot}"
                        Style="{StaticResource MaterialOutlinedButtonStyle}"
                        HorizontalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </mvux:FeedView.ErrorTemplate>
        </mvux:FeedView>

        <!-- Notes -->
        <TextBox Header="Notes"
                 Text="{Binding Notes, Mode=TwoWay}"
                 PlaceholderText="Additional notes for the client"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 MinHeight="{StaticResource NotesMinHeight}" />

        <!-- Validation Error -->
        <mvux:FeedView Source="{Binding ValidationError}">
          <DataTemplate>
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}"
                        AutomationProperties.LiveSetting="Assertive"
                        Visibility="{Binding Data, Converter={StaticResource EmptyToVisibleConverter}, ConverterParameter=Invert}">
              <FontIcon Glyph="&#xE783;" FontSize="{StaticResource IconSizeMd}" Foreground="{ThemeResource ErrorBrush}" />
              <TextBlock Text="{Binding Data}"
                         Foreground="{ThemeResource ErrorBrush}"
                         Style="{StaticResource BodyMedium}"
                         TextWrapping="Wrap" />
            </StackPanel>
          </DataTemplate>
        </mvux:FeedView>

        <!-- Export PDF (a note takes its place on the heads without a PDF engine) -->
        <Button Content="Export PDF"
                Command="{Binding ExportPdf}"
                Visibility="{Binding PdfUnavailableNote, Converter={StaticResource EmptyToVisibleConverter}}"
                HorizontalAlignment="Stretch"
                MinHeight="{StaticResource TouchTarget}"
                Style="{StaticResource MaterialFilledTonalButtonStyle}"
                Margin="{StaticResource GapTop8}" />
        <TextBlock Text="{Binding PdfUnavailableNote}"
                   Visibility="{Binding PdfUnavailableNote, Converter={StaticResource EmptyToVisibleConverter}, ConverterParameter=Invert}"
                   Style="{StaticResource BodySmall}"
                   Foreground="{ThemeResource OnSurfaceVariantBrush}"
                   TextWrapping="Wrap"
                   Margin="{StaticResource GapTop8}" />

        <!-- Status Actions (stacked full width on Narrow) -->
        <TextBlock Text="Status Actions"
                   Style="{StaticResource TitleMedium}"
                   AutomationProperties.HeadingLevel="Level2"
                   Margin="{StaticResource GapTop8}" />

        <StackPanel Spacing="{StaticResource Space8}"
                    Orientation="{utu:Responsive Narrow=Vertical, Normal=Horizontal}">
          <Button Content="Mark Sent"
                  Command="{Binding MarkSent}"
                  HorizontalAlignment="{utu:Responsive Narrow=Stretch, Normal=Left}"
                  MinHeight="{StaticResource TouchTarget}"
                  Style="{StaticResource MaterialOutlinedButtonStyle}" />
          <Button Content="Accepted"
                  Command="{Binding MarkAccepted}"
                  HorizontalAlignment="{utu:Responsive Narrow=Stretch, Normal=Left}"
                  MinHeight="{StaticResource TouchTarget}"
                  Style="{StaticResource MaterialFilledButtonStyle}" />
          <Button Content="Declined"
                  Command="{Binding MarkDeclined}"
                  HorizontalAlignment="{utu:Responsive Narrow=Stretch, Normal=Left}"
                  MinHeight="{StaticResource TouchTarget}"
                  Style="{StaticResource MaterialOutlinedButtonStyle}" />
        </StackPanel>

      </utu:AutoLayout>
    </ScrollViewer>
  </Grid>
</Page>
