<Page x:Class="QuoteCraft.Presentation.QuoteEditorPage"
      x:Name="EditorRoot"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:QuoteCraft.Presentation"
      xmlns:uen="using:Uno.Extensions.Navigation.UI"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:um="using:Uno.Material"
      xmlns:mvux="using:Uno.Extensions.Reactive.UI"
      xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
      Background="{ThemeResource BackgroundBrush}">

  <!--
    Quote editor: one column at every size, capped at ReadingMaxWidth (720) and centred from Normal up. From the top:
    title, client, tax rate, valid until, line items, totals, photos (a tap opens one enlarged), notes, export, status
    actions, history.
    The text fields write to the model as they are typed (UpdateSourceTrigger=PropertyChanged): the top bar's Save
    takes no focus, so a field that only committed when left would lose its last edit.
      Narrow   16 px sides; the line-item actions go under the "Line Items" heading; status actions stack full width.
      Normal / Wide / Widest   wider insets; actions beside their headings; status actions in a row.
  -->
  <Grid utu:SafeArea.Insets="Top">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition />
    </Grid.RowDefinitions>

    <!-- The back arrow is an explicit action: it shows (and works) however the editor was opened. -->
    <utu:NavigationBar IsTabStop="False" MainCommandMode="Action">
      <utu:NavigationBar.Content>
        <!-- A string state binds directly: a FeedView over IState<string> gets a plain string and never renders -->
        <TextBlock Text="{Binding QuoteNumber}"
                   Style="{StaticResource TitleMedium}"
                   TextTrimming="CharacterEllipsis" />
      </utu:NavigationBar.Content>
      <utu:NavigationBar.MainCommand>
        <AppBarButton Command="{Binding Back}"
                      Label="Back"
                      AutomationProperties.Name="Go back"
                      ToolTipService.ToolTip="Go back">
          <AppBarButton.Icon>
            <FontIcon Glyph="&#xE72B;" />
          </AppBarButton.Icon>
        </AppBarButton>
      </utu:NavigationBar.MainCommand>
      <utu:NavigationBar.PrimaryCommands>
        <AppBarButton Label="Save"
                      AutomationProperties.Name="Save quote"
                      Command="{Binding Save}">
          <AppBarButton.Icon>
            <FontIcon Glyph="&#xE74E;" />
          </AppBarButton.Icon>
        </AppBarButton>
      </utu:NavigationBar.PrimaryCommands>
    </utu:NavigationBar>

    <!-- IsIndeterminate follows IsSaving too: a collapsed indeterminate bar keeps animating (a full CPU core on Skia) -->
    <ProgressBar Grid.Row="1" IsIndeterminate="{Binding IsSaving}"
                 AutomationProperties.Name="Saving"
                 Visibility="{Binding IsSaving, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}" />

    <!--
      What Save, Export PDF or a status button could not do: under the bar, so it is in view whatever the scroll (the
      top bar's Save is far from the fields below the fold).
    -->
    <Border Grid.Row="2"
            Background="{ThemeResource ErrorContainerBrush}"
            Padding="{StaticResource Inset16x12}"
            Visibility="{Binding ValidationError, Converter={StaticResource EmptyToVisibleConverter}, ConverterParameter=Invert, FallbackValue=Collapsed}">
      <Grid ColumnSpacing="{StaticResource Space100}" MaxWidth="{StaticResource ReadingMaxWidth}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <FontIcon Glyph="&#xE783;" FontSize="{StaticResource BodyMediumFontSize}" Foreground="{ThemeResource OnErrorContainerBrush}"
                  VerticalAlignment="Center" />
        <TextBlock Grid.Column="1"
                   Text="{Binding ValidationError}"
                   Foreground="{ThemeResource OnErrorContainerBrush}"
                   Style="{StaticResource BodyMedium}"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"
                   AutomationProperties.LiveSetting="Assertive" />
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="3">
      <utu:AutoLayout Padding="{utu:Responsive Narrow={StaticResource PaneInsetNarrow}, Normal={StaticResource PaneInsetNormal}}"
                      Spacing="{StaticResource Space200}"
                      Orientation="Vertical"
                      MaxWidth="{StaticResource ReadingMaxWidth}"
                      HorizontalAlignment="Stretch">

        <TextBox Header="Quote Title"
                 Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 PlaceholderText="e.g. Kitchen Renovation"
                 AutomationProperties.Name="Quote title" />

        <!-- Client Name (Material text field, like the fields around it) -->
        <AutoSuggestBox Header="Client Name"
                        Text="{Binding ClientName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="Search clients or type a name"
                        TextBoxStyle="{StaticResource OutlinedTextBoxStyle}"
                        BorderThickness="1" BorderBrush="{ThemeResource OutlineBrush}" Background="Transparent"
                        ItemsSource="{Binding ClientSuggestions}"
                        AutomationProperties.Name="Client name" />

        <TextBox Header="Tax Rate (%)"
                 Text="{Binding TaxRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 PlaceholderText="13"
                 InputScope="Number"
                 AutomationProperties.Name="Tax rate (%)" />

        <!-- Valid Until (PRD F1.8): starts at the Settings default; expiry, the Send email and the PDF use it -->
        <CalendarDatePicker Header="Valid Until"
                            Date="{Binding ValidUntil, Mode=TwoWay}"
                            PlaceholderText="Pick a date"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="Valid until" />

        <!-- Line Items Section (the actions go under the heading on Narrow) -->
        <Grid utu:AutoLayout.PrimaryAlignment="Stretch"
              MinHeight="{StaticResource ControlHeightMediumLarge}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock Text="Line Items"
                     Style="{StaticResource TitleMedium}"
                     AutomationProperties.HeadingLevel="Level2"
                     VerticalAlignment="Center" />
          <StackPanel Grid.Row="{utu:Responsive Narrow=1, Normal=0}"
                      Grid.Column="{utu:Responsive Narrow=0, Normal=1}"
                      Orientation="Horizontal" Spacing="{StaticResource Space050}">
            <Button Command="{Binding OpenCatalog}"
                    Style="{StaticResource TextButtonStyle}"
                    MinHeight="{StaticResource ControlHeightMediumLarge}"
                    AutomationProperties.Name="Add from catalog">
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space050}">
                <FontIcon Glyph="&#xE82D;" FontSize="{StaticResource BodyMediumFontSize}" />
                <TextBlock Text="From Catalog" />
              </StackPanel>
            </Button>
            <Button Command="{Binding AddLineItem}"
                    Style="{StaticResource TextButtonStyle}"
                    MinHeight="{StaticResource ControlHeightMediumLarge}"
                    AutomationProperties.Name="Add line item">
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space050}">
                <FontIcon Glyph="&#xE710;" FontSize="{StaticResource BodyMediumFontSize}" />
                <TextBlock Text="Add Item" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>

        <mvux:FeedView Source="{Binding LineItems}"
                       HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
          <DataTemplate>
            <ItemsControl ItemsSource="{Binding Data}" IsTabStop="False" HorizontalAlignment="Stretch">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <!-- The item is a button (tap, Enter or Space opens it); Move up and down sit beside it in the card -->
                  <utu:CardContentControl Margin="{StaticResource Space050VerticalThickness}"
                                          Style="{StaticResource StaticCardStyle}"
                                          CornerRadius="{StaticResource Radius200CornerRadius}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Button Command="{Binding DataContext.EditLineItem, ElementName=EditorRoot}"
                              CommandParameter="{Binding}"
                              AutomationProperties.Name="{Binding Description}"
                              Style="{StaticResource TextButtonStyle}"
                              Foreground="{ThemeResource OnSurfaceBrush}"
                              CornerRadius="{StaticResource Radius200CornerRadius}"
                              Padding="{StaticResource Space200Thickness}"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <utu:AutoLayout Spacing="{StaticResource Space100}"
                                        Orientation="Vertical"
                                        HorizontalAlignment="Stretch">
                          <TextBlock Text="{Binding Description}"
                                     Style="{StaticResource BodyLarge}"
                                     TextWrapping="Wrap" />
                          <Grid ColumnSpacing="{StaticResource Space100}" utu:AutoLayout.CounterAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Style="{StaticResource BodySmall}"
                                       Foreground="{ThemeResource OnSurfaceVariantBrush}"
                                       VerticalAlignment="Center">
                              <Run Text="Qty " /><Run Text="{Binding Quantity}" /><Run Text=" × " /><Run Text="{Binding UnitPrice, Converter={StaticResource CurrencyFormatConverter}}" />
                            </TextBlock>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding LineTotal, Converter={StaticResource CurrencyFormatConverter}}"
                                       Style="{StaticResource LabelLarge}"
                                       FontFamily="{StaticResource MonospaceFontFamily}"
                                       Foreground="{ThemeResource PrimaryBrush}"
                                       VerticalAlignment="Center" />
                          </Grid>
                        </utu:AutoLayout>
                      </Button>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                  Spacing="{StaticResource Space025}" Margin="{StaticResource Space100RightThickness}">
                        <Button Command="{Binding DataContext.MoveLineItemUp, ElementName=EditorRoot}"
                                CommandParameter="{Binding}"
                                AutomationProperties.Name="Move line item up"
                                ToolTipService.ToolTip="Move up"
                                Style="{StaticResource TextButtonStyle}"
                                MinWidth="{StaticResource TouchTargetMinSize}" MinHeight="{StaticResource TouchTargetMinSize}"
                                Padding="{StaticResource Space100Thickness}"
                                VerticalAlignment="Center">
                          <FontIcon Glyph="&#xE70E;" FontSize="{StaticResource BodySmallFontSize}" />
                        </Button>
                        <Button Command="{Binding DataContext.MoveLineItemDown, ElementName=EditorRoot}"
                                CommandParameter="{Binding}"
                                AutomationProperties.Name="Move line item down"
                                ToolTipService.ToolTip="Move down"
                                Style="{StaticResource TextButtonStyle}"
                                MinWidth="{StaticResource TouchTargetMinSize}" MinHeight="{StaticResource TouchTargetMinSize}"
                                Padding="{StaticResource Space100Thickness}"
                                VerticalAlignment="Center">
                          <FontIcon Glyph="&#xE70D;" FontSize="{StaticResource BodySmallFontSize}" />
                        </Button>
                      </StackPanel>
                    </Grid>
                  </utu:CardContentControl>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </DataTemplate>

          <mvux:FeedView.NoneTemplate>
            <DataTemplate>
              <StackPanel HorizontalAlignment="Center" Spacing="{StaticResource Space100}" Margin="{StaticResource Space300VerticalThickness}">
                <FontIcon Glyph="&#xE70F;" FontSize="{StaticResource IconSizeLarge}"
                          Foreground="{ThemeResource OnSurfaceVariantBrush}"
                          HorizontalAlignment="Center" />
                <TextBlock Text="No line items yet"
                           Style="{StaticResource BodyLarge}"
                           Foreground="{ThemeResource OnSurfaceVariantBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Add items from catalog or create custom entries"
                           Style="{StaticResource BodyMedium}"
                           Foreground="{ThemeResource OnSurfaceVariantBrush}"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
              </StackPanel>
            </DataTemplate>
          </mvux:FeedView.NoneTemplate>

          <mvux:FeedView.ProgressTemplate>
            <DataTemplate>
              <ProgressRing IsActive="True" HorizontalAlignment="Center" Margin="{StaticResource Space300VerticalThickness}"
                            AutomationProperties.Name="Loading line items" />
            </DataTemplate>
          </mvux:FeedView.ProgressTemplate>

          <mvux:FeedView.ErrorTemplate>
            <DataTemplate>
              <StackPanel HorizontalAlignment="Center" Spacing="{StaticResource Space100}" Margin="{StaticResource Space300VerticalThickness}"
                          AutomationProperties.LiveSetting="Polite">
                <TextBlock Text="Line items could not be loaded." Style="{StaticResource BodyLarge}"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                <Button Content="Retry"
                        Command="{Binding DataContext.Reload, ElementName=EditorRoot}"
                        Style="{StaticResource OutlinedButtonStyle}"
                        HorizontalAlignment="Center"
                        AutomationProperties.Name="Retry loading line items" />
              </StackPanel>
            </DataTemplate>
          </mvux:FeedView.ErrorTemplate>
        </mvux:FeedView>

        <!-- Totals (PRD F1.5): what the PDF will show; recomputed as items change and as the tax rate is typed -->
        <mvux:FeedView Source="{Binding Totals}"
                       HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
          <DataTemplate>
            <utu:CardContentControl Style="{StaticResource TonalCardStyle}"
                                    CornerRadius="{StaticResource Radius300CornerRadius}" Padding="{StaticResource Space200Thickness}">
              <Grid RowSpacing="{StaticResource Space100}" ColumnSpacing="{StaticResource Space200}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Subtotal" Style="{StaticResource BodyMedium}"
                           Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                <TextBlock Grid.Column="1"
                           Text="{Binding Data.Subtotal, Converter={StaticResource CurrencyFormatConverter}}"
                           Style="{StaticResource BodyMedium}" FontFamily="{StaticResource MonospaceFontFamily}"
                           HorizontalAlignment="Right" />
                <TextBlock Grid.Row="1" Text="{Binding Data.TaxLabel}" Style="{StaticResource BodyMedium}"
                           Foreground="{ThemeResource OnSurfaceVariantBrush}" TextWrapping="Wrap" />
                <TextBlock Grid.Row="1" Grid.Column="1"
                           Text="{Binding Data.Tax, Converter={StaticResource CurrencyFormatConverter}}"
                           Style="{StaticResource BodyMedium}" FontFamily="{StaticResource MonospaceFontFamily}"
                           HorizontalAlignment="Right" />
                <TextBlock Grid.Row="2" Text="Total" Style="{StaticResource TitleMediumBold}" />
                <TextBlock Grid.Row="2" Grid.Column="1"
                           Text="{Binding Data.Total, Converter={StaticResource CurrencyFormatConverter}}"
                           Style="{StaticResource TitleMediumBold}" FontFamily="{StaticResource MonospaceFontFamily}"
                           Foreground="{ThemeResource PrimaryBrush}"
                           HorizontalAlignment="Right"
                           AutomationProperties.Name="Total" />
              </Grid>
            </utu:CardContentControl>
          </DataTemplate>
        </mvux:FeedView>

        <!-- Photos Section -->
        <Grid utu:AutoLayout.PrimaryAlignment="Stretch"
              MinHeight="{StaticResource ControlHeightMediumLarge}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="Photos"
                     Style="{StaticResource TitleMedium}"
                     AutomationProperties.HeadingLevel="Level2"
                     VerticalAlignment="Center" />
          <Button Grid.Column="1"
                  Command="{Binding AddPhoto}"
                  Style="{StaticResource FilledTonalButtonStyle}"
                  MinHeight="{StaticResource ControlHeightMediumLarge}"
                  VerticalAlignment="Center"
                  AutomationProperties.Name="Add photo">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space100}">
              <FontIcon Glyph="&#xE722;" FontSize="{StaticResource BodyMediumFontSize}" />
              <TextBlock Text="Add Photo" />
            </StackPanel>
          </Button>
        </Grid>

        <mvux:FeedView Source="{Binding Photos}"
                       HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
          <DataTemplate>
            <muxc:ItemsRepeater ItemsSource="{Binding Data}">
              <muxc:ItemsRepeater.Layout>
                <muxc:UniformGridLayout MinItemWidth="{StaticResource ThumbnailSize}" MinItemHeight="{StaticResource ThumbnailSize}"
                                        MinColumnSpacing="{StaticResource Space100}" MinRowSpacing="{StaticResource Space100}" />
              </muxc:ItemsRepeater.Layout>
              <muxc:ItemsRepeater.ItemTemplate>
                <DataTemplate>
                  <Grid Width="{StaticResource ThumbnailSize}" Height="{StaticResource ThumbnailSize}">
                    <!-- The thumbnail is a button: tap, Enter or Space opens the photo enlarged in a dialog (PRD F14.8) -->
                    <Button Command="{Binding DataContext.ViewPhoto, ElementName=EditorRoot}"
                            CommandParameter="{Binding}"
                            AutomationProperties.Name="View photo enlarged"
                            ToolTipService.ToolTip="View larger"
                            Style="{StaticResource ListCardButtonStyle}"
                            Padding="0">
                      <!-- xaml-lint: allow card - clips the photo to rounded corners with a hairline stroke -->
                      <Border CornerRadius="{StaticResource Radius200CornerRadius}" BorderBrush="{ThemeResource OutlineVariantBrush}"
                              BorderThickness="1">
                        <Image Stretch="UniformToFill" AutomationProperties.Name="Job photo">
                          <Image.Source>
                            <BitmapImage UriSource="{Binding}" />
                          </Image.Source>
                        </Image>
                      </Border>
                    </Button>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                            Command="{Binding DataContext.DeletePhoto, ElementName=EditorRoot}"
                            CommandParameter="{Binding}"
                            AutomationProperties.Name="Delete photo"
                            ToolTipService.ToolTip="Delete photo"
                            Background="{ThemeResource SurfaceInverseMediumBrush}"
                            MinWidth="{StaticResource ControlHeightMediumLarge}" MinHeight="{StaticResource ControlHeightMediumLarge}"
                            Padding="0" CornerRadius="{StaticResource Radius200CornerRadius}">
                      <FontIcon Glyph="&#xE711;" FontSize="{StaticResource BodySmallFontSize}" Foreground="{ThemeResource OnSurfaceInverseBrush}" />
                    </Button>
                  </Grid>
                </DataTemplate>
              </muxc:ItemsRepeater.ItemTemplate>
            </muxc:ItemsRepeater>
          </DataTemplate>

          <mvux:FeedView.NoneTemplate>
            <DataTemplate>
              <StackPanel HorizontalAlignment="Center" Spacing="{StaticResource Space100}" Margin="{StaticResource Space200VerticalThickness}">
                <FontIcon Glyph="&#xE722;" FontSize="{StaticResource IconSizeLarge}"
                          Foreground="{ThemeResource OnSurfaceVariantBrush}"
                          HorizontalAlignment="Center" />
                <TextBlock Text="No photos attached"
                           Style="{StaticResource BodyLarge}"
                           Foreground="{ThemeResource OnSurfaceVariantBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Add photos to document the job"
                           Style="{StaticResource BodyMedium}"
                           Foreground="{ThemeResource OnSurfaceVariantBrush}"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
              </StackPanel>
            </DataTemplate>
          </mvux:FeedView.NoneTemplate>

          <mvux:FeedView.ErrorTemplate>
            <DataTemplate>
              <StackPanel HorizontalAlignment="Center" Spacing="{StaticResource Space100}" Margin="{StaticResource Space200VerticalThickness}"
                          AutomationProperties.LiveSetting="Polite">
                <TextBlock Text="Photos could not be loaded." Style="{StaticResource BodyLarge}"
                           HorizontalAlignment="Center" />
                <Button Content="Retry"
                        Command="{Binding DataContext.Reload, ElementName=EditorRoot}"
                        Style="{StaticResource OutlinedButtonStyle}"
                        HorizontalAlignment="Center"
                        AutomationProperties.Name="Retry loading photos" />
              </StackPanel>
            </DataTemplate>
          </mvux:FeedView.ErrorTemplate>
        </mvux:FeedView>

        <TextBox Header="Notes"
                 Text="{Binding Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 PlaceholderText="Additional notes for the client"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 MinHeight="{StaticResource NotesMinHeight}"
                 AutomationProperties.Name="Notes" />

        <Button Content="Export PDF"
                Command="{Binding ExportPdf}"
                HorizontalAlignment="Stretch"
                MinHeight="{StaticResource ControlHeightMediumLarge}"
                Style="{StaticResource FilledTonalButtonStyle}"
                Margin="{StaticResource Space100TopThickness}"
                AutomationProperties.Name="Export PDF" />

        <!-- Status Actions (stacked full width on Narrow) -->
        <TextBlock Text="Status Actions"
                   Style="{StaticResource TitleMedium}"
                   AutomationProperties.HeadingLevel="Level2"
                   Margin="{StaticResource Space100TopThickness}" />

        <StackPanel Spacing="{StaticResource Space100}"
                    Orientation="{utu:Responsive Narrow=Vertical, Normal=Horizontal}">
          <Button Content="Mark Sent"
                  Command="{Binding MarkSent}"
                  HorizontalAlignment="{utu:Responsive Narrow=Stretch, Normal=Left}"
                  MinHeight="{StaticResource ControlHeightMediumLarge}"
                  Style="{StaticResource OutlinedButtonStyle}"
                  AutomationProperties.Name="Mark as sent" />
          <Button Content="Accepted"
                  Command="{Binding MarkAccepted}"
                  HorizontalAlignment="{utu:Responsive Narrow=Stretch, Normal=Left}"
                  MinHeight="{StaticResource ControlHeightMediumLarge}"
                  Style="{StaticResource FilledButtonStyle}"
                  AutomationProperties.Name="Mark as accepted" />
          <Button Content="Declined"
                  Command="{Binding MarkDeclined}"
                  HorizontalAlignment="{utu:Responsive Narrow=Stretch, Normal=Left}"
                  MinHeight="{StaticResource ControlHeightMediumLarge}"
                  Style="{StaticResource OutlinedButtonStyle}"
                  AutomationProperties.Name="Mark as declined" />
        </StackPanel>

        <!-- Status history (PRD F3.4), one line per change -->
        <TextBlock Text="History"
                   Style="{StaticResource TitleMedium}"
                   AutomationProperties.HeadingLevel="Level2"
                   Margin="{StaticResource Space100TopThickness}" />
        <mvux:FeedView Source="{Binding StatusHistory}"
                       HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
          <DataTemplate>
            <ItemsControl ItemsSource="{Binding Data}" IsTabStop="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Style="{StaticResource BodyMedium}" Margin="{StaticResource Space050VerticalThickness}">
                    <Run Text="{Binding Status}" FontWeight="SemiBold" /><Run Text=" · " /><Run Text="{Binding ChangedAt, Converter={StaticResource ShortDateConverter}}" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                  </TextBlock>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </DataTemplate>
          <mvux:FeedView.NoneTemplate>
            <DataTemplate>
              <TextBlock Text="No status changes yet. Sending, accepting or declining the quote adds a line here."
                         Style="{StaticResource BodyMedium}"
                         Foreground="{ThemeResource OnSurfaceVariantBrush}"
                         TextWrapping="Wrap" />
            </DataTemplate>
          </mvux:FeedView.NoneTemplate>
          <mvux:FeedView.ErrorTemplate>
            <DataTemplate>
              <TextBlock Text="The history could not be loaded."
                         Style="{StaticResource BodyMedium}"
                         Foreground="{ThemeResource OnSurfaceVariantBrush}" />
            </DataTemplate>
          </mvux:FeedView.ErrorTemplate>
        </mvux:FeedView>

      </utu:AutoLayout>
    </ScrollViewer>
  </Grid>
</Page>
