<!--
  Notifications: a drawer from the right (route !Notifications, Presentation/DrawerFlyout), opened by
  MainModel.OpenNotifications from the rail's bell (from 800 px) and the Alerts tab (below 800 px, D18). One layout at
  every width: the drawer is 420 px wide, or the whole window when that is narrower.
-->
<Page x:Class="QuoteCraft.Presentation.NotificationsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:uen="using:Uno.Extensions.Navigation.UI"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:mvux="using:Uno.Extensions.Reactive.UI"
      Background="{ThemeResource BackgroundBrush}">

  <Grid utu:SafeArea.Insets="VisibleBounds">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition />
    </Grid.RowDefinitions>

    <utu:NavigationBar IsTabStop="False" Content="Notifications" MainCommandMode="Action">
      <utu:NavigationBar.MainCommand>
        <AppBarButton uen:Navigation.Request="-"
                      Label="Close"
                      AutomationProperties.Name="Close notifications"
                      ToolTipService.ToolTip="Close notifications">
          <AppBarButton.Icon>
            <FontIcon Glyph="&#xE711;" />
          </AppBarButton.Icon>
        </AppBarButton>
      </utu:NavigationBar.MainCommand>
      <utu:NavigationBar.PrimaryCommands>
        <AppBarButton Label="Mark all read"
                      AutomationProperties.Name="Mark all notifications as read"
                      Command="{Binding MarkAllRead}">
          <AppBarButton.Icon>
            <FontIcon Glyph="&#xE8FB;" />
          </AppBarButton.Icon>
        </AppBarButton>
      </utu:NavigationBar.PrimaryCommands>
    </utu:NavigationBar>

    <!-- What Mark all read could not do -->
    <TextBlock Grid.Row="1"
               Text="{Binding ActionError}"
               Style="{StaticResource BodyMedium}"
               Foreground="{ThemeResource ErrorBrush}"
               TextWrapping="Wrap"
               Margin="{StaticResource Space200HorizontalThickness}"
               AutomationProperties.LiveSetting="Assertive"
               Visibility="{Binding ActionError, Converter={StaticResource EmptyToVisibleConverter}, ConverterParameter=Invert, FallbackValue=Collapsed}" />

    <mvux:FeedView x:Name="NotificationsFeed" Grid.Row="2" Source="{Binding Notifications}">
      <DataTemplate>
        <ListView ItemsSource="{Binding Data}"
                  SelectionMode="None"
                  Padding="{StaticResource Space100VerticalThickness}">
          <ListView.ItemTemplate>
            <DataTemplate>
              <Grid Padding="{StaticResource Inset20x16}" Margin="{StaticResource RowSeparatorGap}"
                    Background="{ThemeResource SurfaceBrush}"
                    AutomationProperties.Name="{Binding Message}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Unread: a dot plus the bold title, so the state is not carried by colour alone -->
                <Ellipse Width="{StaticResource DotSize}" Height="{StaticResource DotSize}"
                         Fill="{ThemeResource PrimaryBrush}"
                         VerticalAlignment="Top" Margin="{StaticResource DotMargin}"
                         Visibility="{Binding IsRead, Converter={StaticResource InverseBoolConverter}}" />

                <StackPanel Grid.Column="1" Spacing="{StaticResource Space050}">
                  <TextBlock Text="{Binding Title}"
                             Style="{StaticResource BodyMediumSemiBold}"
                             TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Message}"
                             Style="{StaticResource BodySmall}"
                             Foreground="{ThemeResource OnSurfaceVariantBrush}"
                             TextWrapping="Wrap" MaxLines="2" />
                </StackPanel>

                <TextBlock Grid.Column="2"
                           Text="{Binding CreatedAt, Converter={StaticResource RelativeDateConverter}}"
                           Style="{StaticResource LabelSmall}"
                           Foreground="{ThemeResource OnSurfaceVariantBrush}"
                           Margin="{StaticResource Space100LeftThickness}"
                           VerticalAlignment="Top" />
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
      </DataTemplate>

      <mvux:FeedView.NoneTemplate>
        <DataTemplate>
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                      Spacing="{StaticResource Space150}" Padding="{StaticResource Space400Thickness}">
            <FontIcon Glyph="&#xEA8F;" FontSize="{StaticResource HeroIconSize}"
                      Foreground="{ThemeResource OnSurfaceVariantBrush}"
                      HorizontalAlignment="Center" />
            <TextBlock Text="No notifications yet"
                       Style="{StaticResource BodyMedium}"
                       Foreground="{ThemeResource OnSurfaceVariantBrush}"
                       HorizontalAlignment="Center" />
          </StackPanel>
        </DataTemplate>
      </mvux:FeedView.NoneTemplate>

      <mvux:FeedView.ProgressTemplate>
        <DataTemplate>
          <ProgressRing IsActive="True" HorizontalAlignment="Center" VerticalAlignment="Center"
                        AutomationProperties.Name="Loading notifications" />
        </DataTemplate>
      </mvux:FeedView.ProgressTemplate>

      <!-- The template's DataContext is the exception: Retry reaches the FeedView by name. -->
      <mvux:FeedView.ErrorTemplate>
        <DataTemplate>
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                      Spacing="{StaticResource Space150}" Padding="{StaticResource Space400Thickness}"
                      AutomationProperties.LiveSetting="Polite">
            <FontIcon Glyph="&#xE783;" FontSize="{StaticResource HeroIconSize}"
                      Foreground="{ThemeResource ErrorBrush}"
                      HorizontalAlignment="Center" />
            <TextBlock Text="Notifications could not be loaded."
                       Style="{StaticResource BodyMedium}"
                       Foreground="{ThemeResource OnSurfaceVariantBrush}"
                       HorizontalAlignment="Center" />
            <Button Content="Retry"
                    Command="{Binding Refresh, ElementName=NotificationsFeed}"
                    Style="{StaticResource OutlinedButtonStyle}"
                    HorizontalAlignment="Center"
                    AutomationProperties.Name="Retry loading notifications" />
          </StackPanel>
        </DataTemplate>
      </mvux:FeedView.ErrorTemplate>
    </mvux:FeedView>
  </Grid>
</Page>
