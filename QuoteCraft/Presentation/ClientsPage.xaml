<Page x:Class="QuoteCraft.Presentation.ClientsPage"
      x:Name="ClientsRoot"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:QuoteCraft.Presentation"
      xmlns:uen="using:Uno.Extensions.Navigation.UI"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:um="using:Uno.Material"
      xmlns:mvux="using:Uno.Extensions.Reactive.UI"
      xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
      xmlns:ctrl="using:QuoteCraft.Controls"
      Background="{ThemeResource BackgroundBrush}">

  <!--
    Clients per category (same frame as Quotes):
      Narrow   header on two rows; the totals card and the list scroll as one page; a client opens over the list.
      Normal   header on one row; otherwise as Narrow.
      Wide     the three total cards stay above the list; one pane.
      Widest   list (380) and detail side by side; from 1400 (SplitLayout) the summary sits beside the quote history.
  -->
  <Grid utu:SafeArea.Insets="Top">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition />
    </Grid.RowDefinitions>

    <!-- Header band -->
    <Border Background="{ThemeResource SurfaceBrush}"
            BorderBrush="{ThemeResource OutlineVariantBrush}"
            BorderThickness="0,0,0,1">
      <Grid MaxWidth="{StaticResource PageMaxWidth}"
            MinHeight="{StaticResource PageHeaderHeight}"
            Padding="{utu:Responsive Narrow={StaticResource PageHeaderInsetNarrow}, Normal={StaticResource PageHeaderInsetNormal}, Wide={StaticResource PageHeaderInsetWide}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Uid="ClientsPage.Label.Title"
                   Text="Clients"
                   Style="{StaticResource TitleLargeBold}"
                   AutomationProperties.HeadingLevel="Level1"
                   VerticalAlignment="Center" />

        <!-- A primitive feed binds directly: a FeedView over IFeed<int> never leaves its progress template -->
        <TextBlock Grid.Column="1"
                   Style="{StaticResource BodyMedium}"
                   Foreground="{ThemeResource OnSurfaceVariantBrush}"
                   VerticalAlignment="Center" Margin="{StaticResource GapStart8}">
          <Run Text="{Binding ClientCount}" /><Run Text=" contacts" />
        </TextBlock>

        <!-- Search (under the title row on Narrow) -->
        <utu:CardContentControl Style="{StaticResource TonalCardStyle}" Grid.Row="{utu:Responsive Narrow=1, Normal=0}"
                Grid.Column="{utu:Responsive Narrow=0, Normal=2}"
                Grid.ColumnSpan="{utu:Responsive Narrow=4, Normal=1}"
                Padding="{StaticResource InsetX12}"
                Height="{StaticResource SearchHeight}"
                MinWidth="{utu:Responsive Narrow=0, Normal={StaticResource SearchMinWidth}}"
                MaxWidth="{utu:Responsive Narrow={StaticResource SearchMaxWidthNarrow}, Normal={StaticResource SearchMaxWidth}}"
                HorizontalAlignment="{utu:Responsive Narrow=Stretch, Normal=Right}"
                VerticalAlignment="Center"
                Margin="{utu:Responsive Narrow={StaticResource InsetY8}, Normal={StaticResource InsetX16}}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE721;" FontSize="{StaticResource IconSizeMd}"
                      Foreground="{ThemeResource OnSurfaceVariantBrush}"
                      VerticalAlignment="Center" Margin="{StaticResource GapEnd8}" />
            <TextBox Grid.Column="1"
                     x:Uid="ClientsPage.TextBox.Search"
                     Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="Search clients..."
                     AutomationProperties.Name="Search clients"
                     BorderThickness="0" Background="Transparent"
                     Padding="0" MinHeight="0"
                     VerticalAlignment="Center"
                     VerticalContentAlignment="Center" />
          </Grid>
        </utu:CardContentControl>

        <Button Grid.Column="3"
                x:Uid="ClientsPage.Button.AddClient"
                Command="{Binding AddClient}"
                AutomationProperties.Name="Add new client"
                Style="{StaticResource AccentButtonStyle}">
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
            <FontIcon Glyph="&#xE710;" FontSize="{StaticResource IconSizeSm}" Foreground="{StaticResource OnAccentFixedBrush}" />
            <TextBlock Text="Add Client" Foreground="{StaticResource OnAccentFixedBrush}" Style="{StaticResource LabelLargeSemiBold}" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <!-- Total cards (Wide and Widest) -->
    <mvux:FeedView Grid.Row="1" Source="{Binding Analytics}"
                   Visibility="{utu:Responsive Narrow=Collapsed, Wide=Visible}">
      <DataTemplate>
        <Grid MaxWidth="{StaticResource PageMaxWidth}" Padding="{StaticResource BandInsetWide}" ColumnSpacing="{StaticResource Space16}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <utu:CardContentControl Style="{StaticResource PaddedCardStyle}">
            <StackPanel Spacing="{StaticResource Space4}" VerticalAlignment="Center">
              <TextBlock Text="TOTAL CLIENTS" Style="{StaticResource LabelSmall}"
                         Foreground="{ThemeResource OnSurfaceVariantBrush}" FontWeight="SemiBold" />
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space4}">
                <TextBlock Text="{Binding Data.TotalClients}"
                           Style="{StaticResource HeadlineSmallBold}" />
                <TextBlock Text="contacts" Style="{StaticResource BodyMedium}"
                           Foreground="{ThemeResource OnSurfaceVariantBrush}"
                           VerticalAlignment="Bottom" Margin="{StaticResource BaselineNudge}" />
              </StackPanel>
            </StackPanel>
          </utu:CardContentControl>

          <utu:CardContentControl Style="{StaticResource PaddedCardStyle}" Grid.Column="1">
            <StackPanel Spacing="{StaticResource Space4}" VerticalAlignment="Center">
              <TextBlock Text="ACCEPTED REVENUE" Style="{StaticResource LabelSmall}"
                         Foreground="{ThemeResource OnSurfaceVariantBrush}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Data.TotalRevenue, Converter={StaticResource CurrencyFormatConverter}}"
                         Style="{StaticResource HeadlineSmallBold}"
                         FontFamily="{StaticResource MonospaceFontFamily}" />
            </StackPanel>
          </utu:CardContentControl>

          <utu:CardContentControl Style="{StaticResource PaddedCardStyle}" Grid.Column="2">
            <StackPanel Spacing="{StaticResource Space4}" VerticalAlignment="Center">
              <TextBlock Text="AVG PER CLIENT" Style="{StaticResource LabelSmall}"
                         Foreground="{ThemeResource OnSurfaceVariantBrush}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Data.AvgPerClient, Converter={StaticResource CurrencyFormatConverter}}"
                         Style="{StaticResource HeadlineSmallBold}"
                         FontFamily="{StaticResource MonospaceFontFamily}" />
            </StackPanel>
          </utu:CardContentControl>
        </Grid>
      </DataTemplate>

      <mvux:FeedView.NoneTemplate>
        <DataTemplate>
          <Border Height="0" />
        </DataTemplate>
      </mvux:FeedView.NoneTemplate>
      <mvux:FeedView.ErrorTemplate>
        <DataTemplate>
          <Border Height="0" />
        </DataTemplate>
      </mvux:FeedView.ErrorTemplate>
    </mvux:FeedView>

    <!-- Body: list pane, and the detail (beside it from 1080, over it below) -->
    <Grid Grid.Row="2" MaxWidth="{StaticResource PageMaxWidth}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Grid Grid.ColumnSpan="{utu:Responsive Narrow=2, Widest=1}"
            Width="{utu:Responsive Narrow=NaN, Widest={StaticResource ListPaneWidth}}"
            BorderBrush="{ThemeResource OutlineVariantBrush}"
            BorderThickness="{utu:Responsive Narrow='0', Widest='0,0,1,0'}">
        <ScrollViewer VerticalScrollBarVisibility="{utu:Responsive Narrow=Auto, Wide=Disabled}"
                      VerticalScrollMode="{utu:Responsive Narrow=Auto, Wide=Disabled}"
                      HorizontalScrollBarVisibility="Disabled">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition />
            </Grid.RowDefinitions>

            <!-- Compact totals (Narrow and Normal) -->
            <mvux:FeedView Source="{Binding Analytics}"
                           Visibility="{utu:Responsive Narrow=Visible, Wide=Collapsed}">
              <DataTemplate>
                <utu:CardContentControl Style="{StaticResource PaddedCardStyle}" Margin="{utu:Responsive Narrow={StaticResource BandInsetNarrow}, Normal={StaticResource BandInsetNormal}}">
                  <Grid RowSpacing="{StaticResource Space8}" ColumnSpacing="{StaticResource Space12}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="TOTAL CLIENTS" Style="{StaticResource LabelSmall}" VerticalAlignment="Center"
                               Foreground="{ThemeResource OnSurfaceVariantBrush}" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="{Binding Data.TotalClients}" Style="{StaticResource TitleMediumBold}" />
                    <TextBlock Grid.Row="1" Text="ACCEPTED REVENUE" Style="{StaticResource LabelSmall}" VerticalAlignment="Center"
                               Foreground="{ThemeResource OnSurfaceVariantBrush}" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Data.TotalRevenue, Converter={StaticResource CurrencyFormatConverter}}"
                               Style="{StaticResource TitleMediumBold}" FontFamily="{StaticResource MonospaceFontFamily}" />
                    <TextBlock Grid.Row="2" Text="AVG PER CLIENT" Style="{StaticResource LabelSmall}" VerticalAlignment="Center"
                               Foreground="{ThemeResource OnSurfaceVariantBrush}" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Data.AvgPerClient, Converter={StaticResource CurrencyFormatConverter}}"
                               Style="{StaticResource TitleMediumBold}" FontFamily="{StaticResource MonospaceFontFamily}" />
                  </Grid>
                </utu:CardContentControl>
              </DataTemplate>
              <mvux:FeedView.NoneTemplate>
                <DataTemplate>
                  <Border Height="0" />
                </DataTemplate>
              </mvux:FeedView.NoneTemplate>
              <mvux:FeedView.ErrorTemplate>
                <DataTemplate>
                  <Border Height="0" />
                </DataTemplate>
              </mvux:FeedView.ErrorTemplate>
            </mvux:FeedView>

            <!-- Client Cards -->
            <mvux:FeedView Grid.Row="1" Source="{Binding Clients}">
              <DataTemplate>
                <ScrollViewer Padding="{utu:Responsive Narrow={StaticResource ListInsetNarrow}, Normal={StaticResource ListInsetNormal}, Widest={StaticResource ListInsetWidest}}">
                  <muxc:ItemsRepeater ItemsSource="{Binding Data}">
                    <muxc:ItemsRepeater.Layout>
                      <muxc:StackLayout Spacing="{StaticResource Space4}" />
                    </muxc:ItemsRepeater.Layout>
                    <muxc:ItemsRepeater.ItemTemplate>
                      <DataTemplate>
                        <!-- The card is a button: tap, Enter or Space opens the client -->
                        <utu:CardContentControl Style="{StaticResource StaticCardStyle}" CornerRadius="{StaticResource RadiusMd}">
                          <Button Command="{Binding DataContext.SelectClient, ElementName=ClientsRoot}"
                                  CommandParameter="{Binding}"
                                  AutomationProperties.Name="{Binding Name}"
                                  Style="{StaticResource ListCardButtonStyle}"
                                  Padding="{StaticResource Inset12}">
                            <Grid ColumnSpacing="{StaticResource Space12}">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                              </Grid.ColumnDefinitions>

                              <!-- Avatar -->
                              <utu:CardContentControl Style="{StaticResource AvatarCardStyle}" Width="{StaticResource AvatarSize}" Height="{StaticResource AvatarSize}" CornerRadius="{StaticResource RadiusCircle40}" AutomationProperties.AccessibilityView="Raw">
                                <TextBlock Text="{Binding Initials}" Style="{StaticResource LabelLarge}"
                                           Foreground="{ThemeResource OnPrimaryContainerBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                              </utu:CardContentControl>

                              <!-- Info -->
                              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="{StaticResource Space2}">
                                <TextBlock Text="{Binding Name}" Style="{StaticResource BodyMediumSemiBold}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Summary}"
                                           Style="{StaticResource BodySmall}"
                                           Foreground="{ThemeResource OnSurfaceVariantBrush}"
                                           TextTrimming="CharacterEllipsis" />
                              </StackPanel>

                              <!-- Value -->
                              <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                          HorizontalAlignment="Right">
                                <TextBlock Text="{Binding TotalValue, Converter={StaticResource CurrencyFormatConverter}}"
                                           FontFamily="{StaticResource MonospaceFontFamily}"
                                           Style="{StaticResource BodySmallSemiBold}"
                                           HorizontalAlignment="Right" />
                                <TextBlock Text="total" Style="{StaticResource LabelSmall}"
                                           Foreground="{ThemeResource OnSurfaceVariantBrush}"
                                           HorizontalAlignment="Right" />
                              </StackPanel>
                            </Grid>
                          </Button>
                        </utu:CardContentControl>
                      </DataTemplate>
                    </muxc:ItemsRepeater.ItemTemplate>
                  </muxc:ItemsRepeater>
                </ScrollViewer>
              </DataTemplate>

              <mvux:FeedView.NoneTemplate>
                <DataTemplate>
                  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                              Spacing="{StaticResource Space12}" Padding="{StaticResource Inset24}">
                    <FontIcon Glyph="&#xE77B;" FontSize="{StaticResource IconSizeEmpty}"
                              Foreground="{ThemeResource OnSurfaceVariantBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="No clients here" Style="{StaticResource TitleSmall}"
                               HorizontalAlignment="Center" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                    <TextBlock Text="Add a client, or clear the search."
                               Style="{StaticResource BodyMedium}"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                    <Button Command="{Binding DataContext.AddClient, ElementName=ClientsRoot}"
                            Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Center" Margin="{StaticResource GapTop8}">
                      <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
                        <FontIcon Glyph="&#xE710;" FontSize="{StaticResource IconSizeSm}" Foreground="{StaticResource OnAccentFixedBrush}" />
                        <TextBlock Text="Add Client" Foreground="{StaticResource OnAccentFixedBrush}" Style="{StaticResource LabelLargeSemiBold}" />
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </DataTemplate>
              </mvux:FeedView.NoneTemplate>

              <mvux:FeedView.ProgressTemplate>
                <DataTemplate>
                  <ProgressRing IsActive="True" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{StaticResource Inset24}" AutomationProperties.Name="Loading clients" />
                </DataTemplate>
              </mvux:FeedView.ProgressTemplate>

              <mvux:FeedView.ErrorTemplate>
                <DataTemplate>
                  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                              Spacing="{StaticResource Space12}" Padding="{StaticResource Inset24}"
                              AutomationProperties.LiveSetting="Polite">
                    <FontIcon Glyph="&#xE783;" FontSize="{StaticResource IconSizeEmpty}"
                              Foreground="{ThemeResource ErrorBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="Clients could not be loaded." Style="{StaticResource TitleSmall}"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                    <Button Content="Retry"
                            Command="{Binding DataContext.RefreshList, ElementName=ClientsRoot}"
                            Style="{StaticResource MaterialOutlinedButtonStyle}"
                            HorizontalAlignment="Center" />
                  </StackPanel>
                </DataTemplate>
              </mvux:FeedView.ErrorTemplate>
            </mvux:FeedView>
          </Grid>
        </ScrollViewer>
      </Grid>

      <!-- Client Detail: beside the list from 1080, over it below -->
      <mvux:FeedView Grid.Column="{utu:Responsive Narrow=0, Widest=1}"
                     Grid.ColumnSpan="{utu:Responsive Narrow=2, Widest=1}"
                     Source="{Binding SelectedClientDetail}">
        <DataTemplate>
          <ScrollViewer Background="{ThemeResource BackgroundBrush}"
                        Padding="{utu:Responsive Narrow={StaticResource PaneInsetNarrow}, Normal={StaticResource PaneInsetNormal}, Wide={StaticResource PaneInsetWide}, Widest={StaticResource PaneInsetWidest}}">
            <StackPanel Spacing="{StaticResource Space20}" HorizontalAlignment="Stretch">

              <!-- Back to the list (one-pane layouts) -->
              <Button Command="{Binding DataContext.BackToList, ElementName=ClientsRoot}"
                      Visibility="{utu:Responsive Narrow=Visible, Widest=Collapsed}"
                      Style="{StaticResource MaterialTextButtonStyle}"
                      MinHeight="{StaticResource TouchTarget}"
                      Margin="{StaticResource LeadingIconNudge}"
                      AutomationProperties.Name="Back to clients">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
                  <FontIcon Glyph="&#xE72B;" FontSize="{StaticResource IconSizeMd}" />
                  <TextBlock Text="Clients" />
                </StackPanel>
              </Button>

              <!-- Name + Actions (actions under the name until the detail is wide) -->
              <Grid ColumnSpacing="{StaticResource Space16}"
                    RowSpacing="{utu:Responsive Narrowest={StaticResource Space12}, Widest=0, Layout={StaticResource SplitLayout}}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding Data.Client.Name}"
                           Grid.ColumnSpan="{utu:Responsive Narrowest=2, Widest=1, Layout={StaticResource SplitLayout}}"
                           Style="{StaticResource HeadlineMedium}"
                           AutomationProperties.HeadingLevel="Level2"
                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Row="{utu:Responsive Narrowest=1, Widest=0, Layout={StaticResource SplitLayout}}"
                            Grid.Column="{utu:Responsive Narrowest=0, Widest=1, Layout={StaticResource SplitLayout}}"
                            Orientation="Horizontal" Spacing="{StaticResource Space8}" VerticalAlignment="Center">
                  <Button Command="{Binding DataContext.EditClient, ElementName=ClientsRoot}"
                          AutomationProperties.Name="Edit client"
                          ToolTipService.ToolTip="Edit client"
                          Style="{StaticResource MaterialOutlinedButtonStyle}"
                          MinHeight="{StaticResource TouchTarget}" MinWidth="{StaticResource TouchTarget}"
                          CornerRadius="{StaticResource RadiusMd}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
                      <FontIcon Glyph="&#xE70F;" FontSize="{StaticResource IconSizeMd}" />
                      <TextBlock Text="Edit" Visibility="{utu:Responsive Narrow=Collapsed, Normal=Visible}" />
                    </StackPanel>
                  </Button>

                  <Button Command="{Binding DataContext.DeleteClient, ElementName=ClientsRoot}"
                          AutomationProperties.Name="Delete client"
                          ToolTipService.ToolTip="Delete client"
                          Style="{StaticResource MaterialOutlinedButtonStyle}"
                          BorderBrush="{ThemeResource ErrorBrush}"
                          MinHeight="{StaticResource TouchTarget}" MinWidth="{StaticResource TouchTarget}"
                          CornerRadius="{StaticResource RadiusMd}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
                      <FontIcon Glyph="&#xE74D;" FontSize="{StaticResource IconSizeMd}"
                                Foreground="{ThemeResource ErrorBrush}" />
                      <TextBlock Text="Delete" Visibility="{utu:Responsive Narrow=Collapsed, Normal=Visible}"
                                 Foreground="{ThemeResource ErrorBrush}" />
                    </StackPanel>
                  </Button>

                  <Button Command="{Binding DataContext.CreateQuoteForClient, ElementName=ClientsRoot}"
                          AutomationProperties.Name="Create new quote for client"
                          Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
                      <FontIcon Glyph="&#xE710;" FontSize="{StaticResource IconSizeSm}" Foreground="{StaticResource OnAccentFixedBrush}" />
                      <TextBlock Text="New Quote" Foreground="{StaticResource OnAccentFixedBrush}" Style="{StaticResource LabelLargeSemiBold}" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Grid>

              <!-- Contact Info (stacked until the detail is wide) -->
              <StackPanel Orientation="{utu:Responsive Narrowest=Vertical, Widest=Horizontal, Layout={StaticResource SplitLayout}}"
                          Spacing="{utu:Responsive Narrowest={StaticResource Space8}, Widest={StaticResource Space16}, Layout={StaticResource SplitLayout}}">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space4}">
                  <FontIcon Glyph="&#xE715;" FontSize="{StaticResource IconSizeSm}" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                  <TextBlock Text="{Binding Data.Client.Entity.Email}" Style="{StaticResource BodySmall}"
                             Foreground="{ThemeResource OnSurfaceVariantBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space4}">
                  <FontIcon Glyph="&#xE717;" FontSize="{StaticResource IconSizeSm}" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                  <TextBlock Text="{Binding Data.Client.Entity.Phone}" Style="{StaticResource BodySmall}"
                             Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space4}">
                  <FontIcon Glyph="&#xE707;" FontSize="{StaticResource IconSizeSm}" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                  <TextBlock Text="{Binding Data.Client.Entity.Address}" Style="{StaticResource BodySmall}"
                             Foreground="{ThemeResource OnSurfaceVariantBrush}" TextWrapping="Wrap" />
                </StackPanel>
              </StackPanel>

              <!-- Quote History + Summary (summary below until the detail is wide) -->
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Quote History -->
                <utu:CardContentControl Style="{StaticResource ElevatedSurfaceCardStyle}" Padding="{StaticResource Inset16}"
                        Grid.ColumnSpan="{utu:Responsive Narrowest=2, Widest=1, Layout={StaticResource SplitLayout}}"
                        Margin="{utu:Responsive Narrowest='0', Widest={StaticResource GapEnd24}, Layout={StaticResource SplitLayout}}">
                  <StackPanel Spacing="{StaticResource Space8}">
                    <TextBlock Style="{StaticResource LabelSmall}"
                               Foreground="{ThemeResource OnSurfaceVariantBrush}" FontWeight="SemiBold">
                      <Run Text="QUOTE HISTORY (" /><Run Text="{Binding Data.Client.QuoteCount}" /><Run Text=")" />
                    </TextBlock>

                    <!-- Quotes list (directly from composite detail, no nested FeedView) -->
                    <muxc:ItemsRepeater ItemsSource="{Binding Data.Quotes}">
                      <muxc:ItemsRepeater.Layout>
                        <muxc:StackLayout Spacing="0" />
                      </muxc:ItemsRepeater.Layout>
                      <muxc:ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                          <!-- Each quote is a button: tap, Enter or Space opens it in the editor -->
                          <Button Command="{Binding DataContext.OpenQuote, ElementName=ClientsRoot}"
                                  CommandParameter="{Binding}"
                                  AutomationProperties.Name="{Binding Title}"
                                  Style="{StaticResource MaterialTextButtonStyle}"
                                  Foreground="{ThemeResource OnSurfaceBrush}"
                                  BorderBrush="{ThemeResource OutlineVariantBrush}"
                                  BorderThickness="0,0,0,1"
                                  CornerRadius="0"
                                  MinHeight="{StaticResource TouchTargetComfortable}"
                                  Padding="{StaticResource InsetY12}"
                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                          <Grid ColumnSpacing="{StaticResource Space12}">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="{StaticResource Space2}">
                              <TextBlock Text="{Binding Title}" Style="{StaticResource BodyMedium}" TextTrimming="CharacterEllipsis" />
                              <TextBlock Style="{StaticResource BodySmall}"
                                         Foreground="{ThemeResource OnSurfaceVariantBrush}" TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding QuoteNumber}" />
                                <Run Text=" · " />
                                <Run Text="{Binding CreatedAt, Converter={StaticResource RelativeDateConverter}}" />
                              </TextBlock>
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Total, Converter={StaticResource CurrencyFormatConverter}}"
                                       FontFamily="{StaticResource MonospaceFontFamily}"
                                       Style="{StaticResource BodyMediumSemiBold}"
                                       VerticalAlignment="Center" />
                            <ctrl:StatusPill Grid.Column="2" Status="{Binding Status}" />
                          </Grid>
                          </Button>
                        </DataTemplate>
                      </muxc:ItemsRepeater.ItemTemplate>
                    </muxc:ItemsRepeater>
                    <TextBlock Text="No quotes for this client yet."
                               Visibility="{Binding Data.Client.QuoteCount, Converter={StaticResource ZeroToVisibleConverter}}"
                               Style="{StaticResource BodyMedium}"
                               Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                  </StackPanel>
                </utu:CardContentControl>

                <!-- Summary -->
                <utu:CardContentControl Style="{StaticResource ElevatedSurfaceCardStyle}" Grid.Row="{utu:Responsive Narrowest=1, Widest=0, Layout={StaticResource SplitLayout}}"
                        Grid.Column="{utu:Responsive Narrowest=0, Widest=1, Layout={StaticResource SplitLayout}}"
                        Grid.ColumnSpan="{utu:Responsive Narrowest=2, Widest=1, Layout={StaticResource SplitLayout}}"
                        Margin="{utu:Responsive Narrowest={StaticResource GapTop16}, Widest='0', Layout={StaticResource SplitLayout}}"
                        Width="{utu:Responsive Narrowest=NaN, Widest={StaticResource SummaryColumnWidth}, Layout={StaticResource SplitLayout}}" Padding="{StaticResource Inset16}"
                        VerticalAlignment="Top">
                  <StackPanel Spacing="{StaticResource Space12}">
                    <TextBlock Text="SUMMARY" Style="{StaticResource LabelSmall}"
                               Foreground="{ThemeResource OnSurfaceVariantBrush}" FontWeight="SemiBold" />
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="Total Quotes" Style="{StaticResource BodySmall}"
                                 Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                      <TextBlock Grid.Column="1" Text="{Binding Data.Client.QuoteCount}" Style="{StaticResource BodySmall}" />
                    </Grid>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="Total Value" Style="{StaticResource BodySmall}"
                                 Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                      <TextBlock Grid.Column="1"
                                 Text="{Binding Data.Client.TotalValue, Converter={StaticResource CurrencyFormatConverter}}"
                                 FontFamily="{StaticResource MonospaceFontFamily}"
                                 Style="{StaticResource BodySmallSemiBold}" />
                    </Grid>
                  </StackPanel>
                </utu:CardContentControl>
              </Grid>
            </StackPanel>
          </ScrollViewer>
        </DataTemplate>

        <mvux:FeedView.NoneTemplate>
          <DataTemplate>
            <!-- Only beside the list: in the one-pane layouts the list shows until a client is picked. -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{utu:Responsive Narrow=Collapsed, Widest=Visible}"
                        Spacing="{StaticResource Space12}" Padding="{StaticResource Inset32}">
              <FontIcon Glyph="&#xE77B;" FontSize="{StaticResource IconSizeHero}"
                        Foreground="{ThemeResource OnSurfaceVariantBrush}" HorizontalAlignment="Center" />
              <TextBlock Text="Select a client" Style="{StaticResource TitleSmall}"
                         HorizontalAlignment="Center"
                         Foreground="{ThemeResource OnSurfaceVariantBrush}" />
              <TextBlock Text="Choose a client from the list to view their details and quote history."
                         Style="{StaticResource BodyMedium}" HorizontalAlignment="Center"
                         Foreground="{ThemeResource OnSurfaceVariantBrush}"
                         TextAlignment="Center" TextWrapping="Wrap" MaxWidth="{StaticResource HintMaxWidth}" />
            </StackPanel>
          </DataTemplate>
        </mvux:FeedView.NoneTemplate>

        <mvux:FeedView.ProgressTemplate>
          <DataTemplate>
            <ProgressRing IsActive="True" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Visibility="{utu:Responsive Narrow=Collapsed, Widest=Visible}"
                          AutomationProperties.Name="Loading client" />
          </DataTemplate>
        </mvux:FeedView.ProgressTemplate>

        <mvux:FeedView.ErrorTemplate>
          <DataTemplate>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{ThemeResource BackgroundBrush}"
                        Spacing="{StaticResource Space12}" Padding="{StaticResource Inset32}"
                        AutomationProperties.LiveSetting="Polite">
              <FontIcon Glyph="&#xE783;" FontSize="{StaticResource IconSizeHero}"
                        Foreground="{ThemeResource ErrorBrush}" HorizontalAlignment="Center" />
              <TextBlock Text="This client could not be loaded." Style="{StaticResource TitleSmall}"
                         HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}" HorizontalAlignment="Center">
                <Button Content="Back"
                        Command="{Binding DataContext.BackToList, ElementName=ClientsRoot}"
                        Style="{StaticResource MaterialTextButtonStyle}" />
                <Button Content="Retry"
                        Command="{Binding DataContext.RefreshList, ElementName=ClientsRoot}"
                        Style="{StaticResource MaterialOutlinedButtonStyle}" />
              </StackPanel>
            </StackPanel>
          </DataTemplate>
        </mvux:FeedView.ErrorTemplate>
      </mvux:FeedView>
    </Grid>
  </Grid>
</Page>
