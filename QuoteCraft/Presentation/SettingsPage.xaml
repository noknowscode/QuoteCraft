<Page x:Class="QuoteCraft.Presentation.SettingsPage"
      x:Name="SettingsRoot"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:QuoteCraft.Presentation"
      xmlns:uen="using:Uno.Extensions.Navigation.UI"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:um="using:Uno.Material"
      xmlns:mvux="using:Uno.Extensions.Reactive.UI"
      Background="{ThemeResource BackgroundBrush}">

  <Grid utu:SafeArea.Insets="Top">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition />
    </Grid.RowDefinitions>

    <!-- Header band -->
    <Border Background="{ThemeResource SurfaceBrush}"
            BorderBrush="{ThemeResource OutlineVariantBrush}"
            BorderThickness="0,0,0,1">
      <Grid MaxWidth="{StaticResource PageMaxWidth}"
            Height="{StaticResource PageHeaderHeight}"
            Padding="{utu:Responsive Narrow={StaticResource InsetX16}, Normal={StaticResource PageHeaderInsetNormal}, Wide={StaticResource PageHeaderInsetWide}}">
        <TextBlock x:Uid="SettingsPage.Label.Title"
                   Text="Settings"
                   Style="{StaticResource TitleLargeBold}"
                   AutomationProperties.HeadingLevel="Level1"
                   VerticalAlignment="Center" />
      </Grid>
    </Border>

    <!--
      Settings per category: one form column (FormMaxWidth, centred) below 1400; from 1400 (SplitLayout) the live quote
      preview sits beside it. Rows are 48 px tall on Narrow (touch) and 40 px from Wide.
    -->
    <Grid Grid.Row="1" MaxWidth="{StaticResource PageMaxWidth}"
          Padding="{utu:Responsive Narrow={StaticResource PaneInsetNarrow}, Normal={StaticResource PaneInsetNormal}, Wide={StaticResource PaneInsetWide}, Widest={StaticResource PaneInsetWidest}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Left Column: Settings Form -->
      <ScrollViewer Grid.ColumnSpan="{utu:Responsive Narrowest=2, Widest=1, Layout={StaticResource SplitLayout}}"
                    Width="{utu:Responsive Narrowest=NaN, Widest={StaticResource FormMaxWidth}, Layout={StaticResource SplitLayout}}"
                    MaxWidth="{StaticResource FormMaxWidth}"
                    HorizontalScrollBarVisibility="Disabled"
                    Padding="{utu:Responsive Narrow='0', Wide={StaticResource GapEnd24}}">
        <StackPanel Spacing="{StaticResource Space28}">

        <!-- Load error, with Retry -->
        <mvux:FeedView Source="{Binding LoadError}">
          <DataTemplate>
            <utu:CardContentControl Style="{StaticResource StaticCardStyle}" BorderThickness="0" Background="{ThemeResource ErrorContainerBrush}"
                    CornerRadius="{StaticResource RadiusLg}" Padding="{StaticResource Inset16x12}"
                    AutomationProperties.LiveSetting="Assertive"
                    Visibility="{Binding Data, Converter={StaticResource EmptyToVisibleConverter}, ConverterParameter=Invert}">
              <Grid ColumnSpacing="{StaticResource Space12}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Data}" Style="{StaticResource BodyMedium}"
                           Foreground="{ThemeResource OnErrorContainerBrush}"
                           TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Retry"
                        Command="{Binding DataContext.Reload, ElementName=SettingsRoot}"
                        Style="{StaticResource MaterialOutlinedButtonStyle}" />
              </Grid>
            </utu:CardContentControl>
          </DataTemplate>
        </mvux:FeedView>

        <!-- Upgrade Banner (only where billing is configured) -->
        <utu:CardContentControl Style="{StaticResource BannerCardStyle}" Padding="{StaticResource Inset24}"
                Visibility="{Binding LocalModeNote, Converter={StaticResource EmptyToVisibleConverter}}">
          <StackPanel Spacing="{StaticResource Space16}">
            <StackPanel Spacing="{StaticResource Space4}">
              <TextBlock Text="Unlock QuoteCraft Pro"
                         Style="{StaticResource TitleMedium}"
                         Foreground="{StaticResource AppBarForegroundFixedBrush}" FontWeight="Bold" />
              <TextBlock Text="Unlimited quotes, custom branding, and priority support"
                         Style="{StaticResource BodySmall}"
                         Foreground="{StaticResource UpgradeBannerSubtitleFixedBrush}"
                         TextWrapping="Wrap" />
            </StackPanel>
            <Button Style="{StaticResource AccentButtonStyle}"
                    Command="{Binding UpgradeToPro}"
                    HorizontalAlignment="Left"
                    AutomationProperties.Name="Upgrade to Pro">
              <TextBlock Text="Upgrade — $15/mo" Foreground="{StaticResource OnAccentFixedBrush}"
                         Style="{StaticResource LabelLargeSemiBold}" />
            </Button>
          </StackPanel>
        </utu:CardContentControl>

        <!-- BUSINESS INFO -->
        <StackPanel Spacing="{StaticResource Space8}">
          <TextBlock Text="BUSINESS INFO"
                     Style="{StaticResource LabelSmall}"
                     Foreground="{ThemeResource OnSurfaceVariantBrush}"
                     FontWeight="Bold" Margin="{StaticResource GapStart4}" AutomationProperties.HeadingLevel="Level2" />

          <utu:CardContentControl Style="{StaticResource StaticCardStyle}">
            <StackPanel>
              <Grid Padding="{StaticResource FormRowInset}" MinHeight="{utu:Responsive Narrow={StaticResource FormRowMinHeightNarrow}, Wide={StaticResource FormRowMinHeight}}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="140" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Business Name" Style="{StaticResource BodyMedium}"
                           FontWeight="Medium" VerticalAlignment="Center" />
                <TextBox Grid.Column="1"
                         Text="{Binding BusinessName, Mode=TwoWay}"
                         PlaceholderText="Your company name"
                         AutomationProperties.Name="Business name"
                         Style="{StaticResource InlineTextBoxStyle}"
                         HorizontalAlignment="Stretch" TextAlignment="Right" />
              </Grid>
              <Border Height="{StaticResource HairlineThickness}" Background="{ThemeResource OutlineVariantBrush}" Margin="{StaticResource FormRowInset}" />

              <Grid Padding="{StaticResource FormRowInset}" MinHeight="{utu:Responsive Narrow={StaticResource FormRowMinHeightNarrow}, Wide={StaticResource FormRowMinHeight}}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="140" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Phone" Style="{StaticResource BodyMedium}"
                           FontWeight="Medium" VerticalAlignment="Center" />
                <TextBox Grid.Column="1"
                         Text="{Binding Phone, Mode=TwoWay}"
                         PlaceholderText="(555) 123-4567"
                         AutomationProperties.Name="Phone number"
                         InputScope="TelephoneNumber"
                         Style="{StaticResource InlineTextBoxStyle}"
                         HorizontalAlignment="Stretch" TextAlignment="Right" />
              </Grid>
              <Border Height="{StaticResource HairlineThickness}" Background="{ThemeResource OutlineVariantBrush}" Margin="{StaticResource FormRowInset}" />

              <Grid Padding="{StaticResource FormRowInset}" MinHeight="{utu:Responsive Narrow={StaticResource FormRowMinHeightNarrow}, Wide={StaticResource FormRowMinHeight}}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="140" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Email" Style="{StaticResource BodyMedium}"
                           FontWeight="Medium" VerticalAlignment="Center" />
                <TextBox Grid.Column="1"
                         Text="{Binding Email, Mode=TwoWay}"
                         PlaceholderText="you@company.com"
                         AutomationProperties.Name="Email address"
                         InputScope="EmailSmtpAddress"
                         Style="{StaticResource InlineTextBoxStyle}"
                         HorizontalAlignment="Stretch" TextAlignment="Right" />
              </Grid>
              <Border Height="{StaticResource HairlineThickness}" Background="{ThemeResource OutlineVariantBrush}" Margin="{StaticResource FormRowInset}" />

              <Grid Padding="{StaticResource FormRowInset}" MinHeight="{utu:Responsive Narrow={StaticResource FormRowMinHeightNarrow}, Wide={StaticResource FormRowMinHeight}}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="140" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Address" Style="{StaticResource BodyMedium}"
                           FontWeight="Medium" VerticalAlignment="Center" />
                <TextBox Grid.Column="1"
                         Text="{Binding Address, Mode=TwoWay}"
                         PlaceholderText="123 Trade St, Anytown USA"
                         AutomationProperties.Name="Business address"
                         Style="{StaticResource InlineTextBoxStyle}"
                         HorizontalAlignment="Stretch" TextAlignment="Right" />
              </Grid>
              <Border Height="{StaticResource HairlineThickness}" Background="{ThemeResource OutlineVariantBrush}" Margin="{StaticResource FormRowInset}" />

              <Grid Padding="{StaticResource FormRowInset}" MinHeight="{utu:Responsive Narrow={StaticResource FormRowMinHeightNarrow}, Wide={StaticResource FormRowMinHeight}}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="140" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Website" Style="{StaticResource BodyMedium}"
                           FontWeight="Medium" VerticalAlignment="Center" />
                <TextBox Grid.Column="1"
                         Text="{Binding Website, Mode=TwoWay}"
                         PlaceholderText="www.yourcompany.com"
                         AutomationProperties.Name="Website"
                         InputScope="Url"
                         Style="{StaticResource InlineTextBoxStyle}"
                         HorizontalAlignment="Stretch" TextAlignment="Right" />
              </Grid>
              <Border Height="{StaticResource HairlineThickness}" Background="{ThemeResource OutlineVariantBrush}" Margin="{StaticResource FormRowInset}" />

              <Grid Padding="{StaticResource FormRowInset}" MinHeight="{utu:Responsive Narrow={StaticResource FormRowMinHeightNarrow}, Wide={StaticResource FormRowMinHeight}}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="140" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Business #" Style="{StaticResource BodyMedium}"
                           FontWeight="Medium" VerticalAlignment="Center" />
                <TextBox Grid.Column="1"
                         Text="{Binding BusinessNumber, Mode=TwoWay}"
                         PlaceholderText="e.g. BN123456789"
                         AutomationProperties.Name="Business number"
                         Style="{StaticResource InlineTextBoxStyle}"
                         HorizontalAlignment="Stretch" TextAlignment="Right" />
              </Grid>
              <Border Height="{StaticResource HairlineThickness}" Background="{ThemeResource OutlineVariantBrush}" Margin="{StaticResource FormRowInset}" />

              <Grid Padding="{StaticResource FormRowInset}" MinHeight="{utu:Responsive Narrow={StaticResource FormRowMinHeightNarrow}, Wide={StaticResource FormRowMinHeight}}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="140" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Logo" Style="{StaticResource BodyMedium}"
                           FontWeight="Medium" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Right" Spacing="{StaticResource Space8}" VerticalAlignment="Center">
                  <!-- xaml-lint: allow card - clips the logo thumbnail to rounded corners with a hairline stroke -->
                  <Border Width="{StaticResource LogoThumbSize}" Height="{StaticResource LogoThumbSize}" CornerRadius="{StaticResource RadiusSm}"
                          BorderBrush="{ThemeResource OutlineVariantBrush}" BorderThickness="1"
                          Visibility="{Binding LogoPath, Converter={StaticResource EmptyToVisibleConverter}, ConverterParameter=Invert, FallbackValue=Collapsed}">
                    <Image Source="{Binding LogoPath}" Stretch="UniformToFill" AutomationProperties.Name="Business logo" />
                  </Border>
                  <TextBlock Text="{Binding LogoFileName}"
                             Style="{StaticResource BodySmall}"
                             Foreground="{ThemeResource OnSurfaceVariantBrush}"
                             VerticalAlignment="Center"
                             MaxWidth="{StaticResource FileNameMaxWidth}" TextTrimming="CharacterEllipsis"
                             Visibility="{Binding LogoPath, Converter={StaticResource EmptyToVisibleConverter}, ConverterParameter=Invert, FallbackValue=Collapsed}" />
                  <Button Command="{Binding UploadLogo}"
                          AutomationProperties.Name="Upload logo"
                          Style="{StaticResource MaterialTextButtonStyle}"
                          MinHeight="{StaticResource TouchTarget}" Padding="{StaticResource InsetX8}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space4}">
                      <TextBlock Text="Upload" Style="{StaticResource BodyMedium}"
                                 Foreground="{ThemeResource PrimaryBrush}" />
                      <FontIcon Glyph="&#xE898;" FontSize="{StaticResource IconSizeSm}"
                                Foreground="{ThemeResource PrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Grid>
              <!-- What Upload could not do -->
              <TextBlock Text="{Binding LogoError}"
                         Style="{StaticResource BodySmall}"
                         Foreground="{ThemeResource ErrorBrush}"
                         TextWrapping="Wrap"
                         Margin="{StaticResource InsetX16}"
                         AutomationProperties.LiveSetting="Assertive"
                         Visibility="{Binding LogoError, Converter={StaticResource EmptyToVisibleConverter}, ConverterParameter=Invert, FallbackValue=Collapsed}" />
            </StackPanel>
          </utu:CardContentControl>
        </StackPanel>

        <!-- QUOTE SETTINGS -->
        <StackPanel Spacing="{StaticResource Space8}">
          <TextBlock Text="QUOTE SETTINGS"
                     Style="{StaticResource LabelSmall}"
                     Foreground="{ThemeResource OnSurfaceVariantBrush}"
                     FontWeight="Bold" Margin="{StaticResource GapStart4}" AutomationProperties.HeadingLevel="Level2" />

          <utu:CardContentControl Style="{StaticResource StaticCardStyle}">
            <StackPanel>
              <Grid Padding="{StaticResource FormRowInset}" MinHeight="{utu:Responsive Narrow={StaticResource FormRowMinHeightNarrow}, Wide={StaticResource FormRowMinHeight}}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Default Tax Rate" Style="{StaticResource BodyMedium}"
                           FontWeight="Medium" VerticalAlignment="Center" />
                <TextBox Grid.Column="1"
                         Text="{Binding DefaultTaxRate, Mode=TwoWay}"
                         PlaceholderText="8.5" InputScope="Number"
                         AutomationProperties.Name="Default tax rate"
                         Width="{StaticResource NumberFieldWidth}" MinHeight="{StaticResource CompactFieldHeight}" Padding="{StaticResource CompactFieldInset}"
                         BorderBrush="{ThemeResource OutlineVariantBrush}"
                         BorderThickness="1" CornerRadius="{StaticResource RadiusMd}"
                         Background="Transparent" TextAlignment="Right"
                         VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="%" Style="{StaticResource BodyMedium}"
                           Foreground="{ThemeResource OnSurfaceVariantBrush}"
                           VerticalAlignment="Center" Margin="{StaticResource GapStart4}"
                           Width="{StaticResource UnitLabelWidth}" TextAlignment="Left" />
              </Grid>
              <Border Height="{StaticResource HairlineThickness}" Background="{ThemeResource OutlineVariantBrush}" Margin="{StaticResource FormRowInset}" />

              <Grid Padding="{StaticResource FormRowInset}" MinHeight="{utu:Responsive Narrow={StaticResource FormRowMinHeightNarrow}, Wide={StaticResource FormRowMinHeight}}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Default Markup" Style="{StaticResource BodyMedium}"
                           FontWeight="Medium" VerticalAlignment="Center" />
                <TextBox Grid.Column="1"
                         Text="{Binding DefaultMarkup, Mode=TwoWay}"
                         PlaceholderText="15" InputScope="Number"
                         AutomationProperties.Name="Default markup percentage"
                         Width="{StaticResource NumberFieldWidth}" MinHeight="{StaticResource CompactFieldHeight}" Padding="{StaticResource CompactFieldInset}"
                         BorderBrush="{ThemeResource OutlineVariantBrush}"
                         BorderThickness="1" CornerRadius="{StaticResource RadiusMd}"
                         Background="Transparent" TextAlignment="Right"
                         VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="%" Style="{StaticResource BodyMedium}"
                           Foreground="{ThemeResource OnSurfaceVariantBrush}"
                           VerticalAlignment="Center" Margin="{StaticResource GapStart4}"
                           Width="{StaticResource UnitLabelWidth}" TextAlignment="Left" />
              </Grid>
              <Border Height="{StaticResource HairlineThickness}" Background="{ThemeResource OutlineVariantBrush}" Margin="{StaticResource FormRowInset}" />

              <Grid Padding="{StaticResource FormRowInset}" MinHeight="{utu:Responsive Narrow={StaticResource FormRowMinHeightNarrow}, Wide={StaticResource FormRowMinHeight}}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space4}" VerticalAlignment="Center">
                  <TextBlock Text="Valid For" Style="{StaticResource BodyMedium}"
                             FontWeight="Medium" />
                  <TextBlock Text="(days)" Style="{StaticResource BodySmall}"
                             Foreground="{ThemeResource OnSurfaceVariantBrush}"
                             VerticalAlignment="Center" />
                </StackPanel>
                <TextBox Grid.Column="1"
                         Text="{Binding QuoteValidDays, Mode=TwoWay}"
                         PlaceholderText="14" InputScope="Number"
                         AutomationProperties.Name="Quote valid days"
                         Width="{StaticResource NumberFieldWidth}" MinHeight="{StaticResource CompactFieldHeight}" Padding="{StaticResource CompactFieldInset}"
                         BorderBrush="{ThemeResource OutlineVariantBrush}"
                         BorderThickness="1" CornerRadius="{StaticResource RadiusMd}"
                         Background="Transparent" TextAlignment="Right"
                         VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="" Style="{StaticResource BodyMedium}"
                           Width="{StaticResource UnitLabelWidth}" />
              </Grid>
              <Border Height="{StaticResource HairlineThickness}" Background="{ThemeResource OutlineVariantBrush}" Margin="{StaticResource FormRowInset}" />

              <Grid Padding="{StaticResource FormRowInset}" MinHeight="{utu:Responsive Narrow={StaticResource FormRowMinHeightNarrow}, Wide={StaticResource FormRowMinHeight}}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Currency" Style="{StaticResource BodyMedium}"
                           FontWeight="Medium" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1"
                          SelectedItem="{Binding CurrencyCode, Mode=TwoWay}"
                          VerticalAlignment="Center"
                          MinWidth="{StaticResource CompactPickerMinWidth}" BorderThickness="0"
                          Background="Transparent">
                  <x:String>USD</x:String>
                  <x:String>CAD</x:String>
                </ComboBox>
                <TextBlock Grid.Column="2" Text="" Style="{StaticResource BodyMedium}"
                           Width="{StaticResource UnitLabelWidth}" />
              </Grid>
              <Border Height="{StaticResource HairlineThickness}" Background="{ThemeResource OutlineVariantBrush}" Margin="{StaticResource FormRowInset}" />

              <Grid Padding="{StaticResource FormRowInset}" MinHeight="{utu:Responsive Narrow={StaticResource FormRowMinHeightNarrow}, Wide={StaticResource FormRowMinHeight}}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Quote Prefix" Style="{StaticResource BodyMedium}"
                           FontWeight="Medium" VerticalAlignment="Center" />
                <TextBox Grid.Column="1"
                         Text="{Binding QuoteNumberPrefix, Mode=TwoWay}"
                         PlaceholderText="QC-"
                         AutomationProperties.Name="Quote number prefix"
                         Width="{StaticResource NumberFieldWidth}" MinHeight="{StaticResource CompactFieldHeight}" Padding="{StaticResource CompactFieldInset}"
                         BorderBrush="{ThemeResource OutlineVariantBrush}"
                         BorderThickness="1" CornerRadius="{StaticResource RadiusMd}"
                         Background="Transparent" TextAlignment="Right"
                         VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="" Style="{StaticResource BodyMedium}"
                           Width="{StaticResource UnitLabelWidth}" />
              </Grid>
              <Border Height="{StaticResource HairlineThickness}" Background="{ThemeResource OutlineVariantBrush}" Margin="{StaticResource FormRowInset}" />

              <Grid Padding="{StaticResource FormRowInset}" MinHeight="{utu:Responsive Narrow={StaticResource FormRowMinHeightNarrow}, Wide={StaticResource FormRowMinHeight}}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="140" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Custom Footer" Style="{StaticResource BodyMedium}"
                           FontWeight="Medium" VerticalAlignment="Center" />
                <TextBox Grid.Column="1"
                         Text="{Binding CustomFooter, Mode=TwoWay}"
                         PlaceholderText="e.g. Thank you for your business!"
                         AutomationProperties.Name="Custom footer text"
                         Style="{StaticResource InlineTextBoxStyle}"
                         HorizontalAlignment="Stretch" TextAlignment="Right" />
              </Grid>
            </StackPanel>
          </utu:CardContentControl>
        </StackPanel>

        <!-- MY CATALOGS -->
        <StackPanel Spacing="{StaticResource Space8}">
          <TextBlock Text="MY CATALOGS"
                     Style="{StaticResource LabelSmall}"
                     Foreground="{ThemeResource OnSurfaceVariantBrush}"
                     FontWeight="Bold" Margin="{StaticResource GapStart4}" AutomationProperties.HeadingLevel="Level2" />

          <utu:CardContentControl Style="{StaticResource StaticCardStyle}">
            <StackPanel>
              <Grid Padding="{StaticResource FormRowInset}" MinHeight="{utu:Responsive Narrow={StaticResource FormRowMinHeightNarrow}, Wide={StaticResource FormRowMinHeight}}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE82D;" FontSize="{StaticResource IconSizeLg}"
                          Foreground="{ThemeResource PrimaryBrush}"
                          VerticalAlignment="Center" Margin="{StaticResource GapEnd12}" />
                <TextBlock Grid.Column="1" Text="Catalog items"
                           Style="{StaticResource BodyMediumWeightMedium}"
                           VerticalAlignment="Center" />
                <mvux:FeedView Grid.Column="2" Source="{Binding CatalogItemCount}">
                  <DataTemplate>
                    <TextBlock Style="{StaticResource BodySmall}"
                               Foreground="{ThemeResource OnSurfaceVariantBrush}"
                               VerticalAlignment="Center">
                      <Run Text="{Binding Data}" />
                      <Run Text=" items" />
                    </TextBlock>
                  </DataTemplate>
                </mvux:FeedView>
              </Grid>
              <Border Height="{StaticResource HairlineThickness}" Background="{ThemeResource OutlineVariantBrush}" Margin="{StaticResource FormRowInset}" />

              <!-- Opens the Catalog page, where categories and items are added -->
              <Button Command="{Binding OpenCatalog}"
                      Style="{StaticResource MaterialTextButtonStyle}"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                      MinHeight="{StaticResource TouchTarget}"
                      Padding="{StaticResource FormRowInset}"
                      Content="Manage catalog" />
            </StackPanel>
          </utu:CardContentControl>
        </StackPanel>

        <!-- APPEARANCE: System (default), Light or Dark; saved and restored at launch -->
        <StackPanel Spacing="{StaticResource Space8}">
          <TextBlock Text="APPEARANCE"
                     Style="{StaticResource LabelSmall}"
                     Foreground="{ThemeResource OnSurfaceVariantBrush}"
                     FontWeight="Bold" Margin="{StaticResource GapStart4}" AutomationProperties.HeadingLevel="Level2" />

          <utu:CardContentControl Style="{StaticResource StaticCardStyle}">
            <Grid Padding="{StaticResource FormRowInset}" MinHeight="{utu:Responsive Narrow={StaticResource FormRowMinHeightNarrow}, Wide={StaticResource FormRowMinHeight}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Theme" Style="{StaticResource BodyMedium}"
                         FontWeight="Medium" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1"
                        SelectedIndex="{Binding ThemeIndex, Mode=TwoWay}"
                        AutomationProperties.Name="Theme"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="{StaticResource InsetY4}">
                <ComboBoxItem Content="System default" />
                <ComboBoxItem Content="Light" />
                <ComboBoxItem Content="Dark" />
              </ComboBox>
            </Grid>
          </utu:CardContentControl>
        </StackPanel>

        <!-- LOCAL MODE (no Supabase project configured: no account, sync or plans) -->
        <StackPanel Spacing="{StaticResource Space8}"
                    Visibility="{Binding LocalModeNote, Converter={StaticResource EmptyToVisibleConverter}, ConverterParameter=Invert}">
          <TextBlock Text="ACCOUNT"
                     Style="{StaticResource LabelSmall}"
                     Foreground="{ThemeResource OnSurfaceVariantBrush}"
                     FontWeight="Bold" Margin="{StaticResource GapStart4}" AutomationProperties.HeadingLevel="Level2" />

          <utu:CardContentControl Style="{StaticResource StaticCardStyle}" Padding="{StaticResource Inset20x12}">
            <Grid ColumnSpacing="{StaticResource Space12}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <FontIcon Glyph="&#xE977;" FontSize="{StaticResource IconSizeLg}"
                        Foreground="{ThemeResource OnSurfaceVariantBrush}"
                        VerticalAlignment="Top" Margin="{StaticResource GapTop2}" />
              <TextBlock Grid.Column="1"
                         Text="{Binding LocalModeNote}"
                         Style="{StaticResource BodyMedium}"
                         Foreground="{ThemeResource OnSurfaceVariantBrush}"
                         TextWrapping="Wrap" />
            </Grid>
          </utu:CardContentControl>
        </StackPanel>

        <!-- SUBSCRIPTION -->
        <StackPanel Spacing="{StaticResource Space8}"
                    Visibility="{Binding LocalModeNote, Converter={StaticResource EmptyToVisibleConverter}}">
          <TextBlock Text="SUBSCRIPTION"
                     Style="{StaticResource LabelSmall}"
                     Foreground="{ThemeResource OnSurfaceVariantBrush}"
                     FontWeight="Bold" Margin="{StaticResource GapStart4}" AutomationProperties.HeadingLevel="Level2" />

          <utu:CardContentControl Style="{StaticResource StaticCardStyle}">
            <StackPanel>
              <Grid Padding="{StaticResource FormRowInset}" MinHeight="{utu:Responsive Narrow={StaticResource FormRowMinHeightNarrow}, Wide={StaticResource FormRowMinHeight}}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Current Plan" Style="{StaticResource BodyMedium}"
                           FontWeight="Medium" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding CurrentPlanName}"
                           Style="{StaticResource BodyMedium}"
                           Foreground="{ThemeResource OnSurfaceVariantBrush}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
              </Grid>
              <Border Height="{StaticResource HairlineThickness}" Background="{ThemeResource OutlineVariantBrush}" Margin="{StaticResource FormRowInset}" />

              <Grid Padding="{StaticResource FormRowInset}" MinHeight="{utu:Responsive Narrow={StaticResource FormRowMinHeightNarrow}, Wide={StaticResource FormRowMinHeight}}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Quotes Used" Style="{StaticResource BodyMedium}"
                           FontWeight="Medium" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding QuotaUsage}"
                           Style="{StaticResource BodyMedium}"
                           Foreground="{ThemeResource OnSurfaceVariantBrush}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
              </Grid>
              <Border Height="{StaticResource HairlineThickness}" Background="{ThemeResource OutlineVariantBrush}" Margin="{StaticResource FormRowInset}" />

              <!-- Manage Subscription -->
              <Grid Padding="{StaticResource FormRowInset}" MinHeight="{utu:Responsive Narrow={StaticResource FormRowMinHeightNarrow}, Wide={StaticResource FormRowMinHeight}}">
                <Button Command="{Binding ManageSubscription}"
                        HorizontalAlignment="Stretch"
                        Style="{StaticResource MaterialTextButtonStyle}"
                        AutomationProperties.Name="Manage subscription">
                  <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
                    <FontIcon Glyph="&#xE8A7;" FontSize="{StaticResource IconSizeLg}"
                              Foreground="{ThemeResource PrimaryBrush}" />
                    <TextBlock Text="Manage Subscription"
                               Style="{StaticResource BodyMedium}"
                               Foreground="{ThemeResource PrimaryBrush}" />
                  </StackPanel>
                </Button>
              </Grid>
            </StackPanel>
          </utu:CardContentControl>
        </StackPanel>

        <!-- ACCOUNT (a Supabase project is configured; cloud sync is still off: DECISIONS D8) -->
        <StackPanel Spacing="{StaticResource Space8}"
                    Visibility="{Binding LocalModeNote, Converter={StaticResource EmptyToVisibleConverter}}">
          <TextBlock Text="ACCOUNT"
                     Style="{StaticResource LabelSmall}"
                     Foreground="{ThemeResource OnSurfaceVariantBrush}"
                     FontWeight="Bold" Margin="{StaticResource GapStart4}" AutomationProperties.HeadingLevel="Level2" />
          <TextBlock Text="Cloud sync is off in this version: your quotes, clients and settings stay on this device. Your account is used for your plan."
                     Style="{StaticResource BodySmall}"
                     Foreground="{ThemeResource OnSurfaceVariantBrush}"
                     TextWrapping="Wrap" Margin="{StaticResource GapStart4}" />

          <utu:CardContentControl Style="{StaticResource StaticCardStyle}">
            <Grid Padding="{StaticResource FormRowInset}" MinHeight="{utu:Responsive Narrow={StaticResource FormRowMinHeightNarrow}, Wide={StaticResource FormRowMinHeight}}">
              <Button Command="{Binding SignOut}"
                      HorizontalAlignment="Stretch"
                      Style="{StaticResource MaterialTextButtonStyle}"
                      AutomationProperties.Name="Sign out">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
                  <FontIcon Glyph="&#xE7E8;" FontSize="{StaticResource IconSizeLg}"
                            Foreground="{ThemeResource ErrorBrush}" />
                  <TextBlock Text="Sign Out"
                             Style="{StaticResource BodyMedium}"
                             Foreground="{ThemeResource ErrorBrush}" />
                </StackPanel>
              </Button>
            </Grid>
          </utu:CardContentControl>
        </StackPanel>

        <!-- Save: validation, saving and saved states -->
        <StackPanel Spacing="{StaticResource Space8}">
          <mvux:FeedView Source="{Binding ValidationError}">
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}"
                          AutomationProperties.LiveSetting="Assertive"
                          Visibility="{Binding Data, Converter={StaticResource EmptyToVisibleConverter}, ConverterParameter=Invert}">
                <FontIcon Glyph="&#xE783;" FontSize="{StaticResource IconSizeMd}" Foreground="{ThemeResource ErrorBrush}" />
                <TextBlock Text="{Binding Data}" Style="{StaticResource BodyMedium}"
                           Foreground="{ThemeResource ErrorBrush}" TextWrapping="Wrap" />
              </StackPanel>
            </DataTemplate>
          </mvux:FeedView>
          <mvux:FeedView Source="{Binding SavedMessage}">
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}"
                          AutomationProperties.LiveSetting="Polite"
                          Visibility="{Binding Data, Converter={StaticResource EmptyToVisibleConverter}, ConverterParameter=Invert}">
                <FontIcon Glyph="&#xE73E;" FontSize="{StaticResource IconSizeMd}" Foreground="{ThemeResource SuccessBrush}" />
                <TextBlock Text="{Binding Data}" Style="{StaticResource BodyMedium}" TextWrapping="Wrap" />
              </StackPanel>
            </DataTemplate>
          </mvux:FeedView>
          <ProgressBar IsIndeterminate="True" AutomationProperties.Name="Saving"
                       Visibility="{Binding IsSaving, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}" />
        </StackPanel>

        <!-- Save Button -->
        <Button x:Uid="SettingsPage.Button.Save"
                Content="Save Settings"
                Command="{Binding Save}"
                AutomationProperties.Name="Save settings"
                HorizontalAlignment="Stretch"
                MinHeight="{StaticResource TouchTarget}"
                Style="{StaticResource MaterialFilledButtonStyle}" />

        </StackPanel>
      </ScrollViewer>

      <!-- Right Column: Live Quote Preview (from 1400) -->
        <ScrollViewer Grid.Column="1"
                      Margin="{StaticResource GapStart32}"
                      Visibility="{utu:Responsive Narrowest=Collapsed, Widest=Visible, Layout={StaticResource SplitLayout}}">
          <utu:CardContentControl Style="{StaticResource StaticCardStyle}" CornerRadius="{StaticResource RadiusMd}"
                  Padding="{StaticResource Inset32x24}"
                  Margin="{StaticResource GapBottom24}"
                  MaxWidth="{StaticResource ReadingMaxWidth}"
                  HorizontalAlignment="Stretch">
              <StackPanel Spacing="0">

                <!-- Header: Logo + Business Info + Quote Number -->
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <!-- Logo placeholder (a top-aligned wrapper: the card template passes its alignment to its own fill) -->
                  <Grid VerticalAlignment="Top" Margin="{StaticResource GapEnd16}">
                  <utu:CardContentControl Style="{StaticResource TonalCardStyle}" Width="{StaticResource PreviewLogoSize}" Height="{StaticResource PreviewLogoSize}">
                    <Grid>
                      <FontIcon Glyph="&#xE91B;" FontSize="{StaticResource IconSize2xl}"
                                Foreground="{ThemeResource OutlineBrush}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding LogoPath, Converter={StaticResource EmptyToVisibleConverter}, FallbackValue=Visible}" />
                      <Image Source="{Binding LogoPath}" Stretch="UniformToFill" AutomationProperties.Name="Business logo"
                             Visibility="{Binding LogoPath, Converter={StaticResource EmptyToVisibleConverter}, ConverterParameter=Invert, FallbackValue=Collapsed}" />
                    </Grid>
                  </utu:CardContentControl>
                  </Grid>

                  <!-- Business details -->
                  <StackPanel Grid.Column="1" Spacing="{StaticResource Space2}" VerticalAlignment="Top">
                    <mvux:FeedView Source="{Binding BusinessName}">
                      <DataTemplate>
                        <TextBlock Text="{Binding Data}"
                                   Style="{StaticResource TitleMedium}"
                                   FontWeight="Bold"
                                   Foreground="{ThemeResource PrimaryBrush}"
                                   TextTrimming="CharacterEllipsis" MaxLines="1" />
                      </DataTemplate>
                      <mvux:FeedView.NoneTemplate>
                        <DataTemplate>
                          <TextBlock Text="Your Company Name"
                                     Style="{StaticResource TitleMedium}"
                                     FontWeight="Bold"
                                     Foreground="{ThemeResource OutlineBrush}" FontStyle="Italic" />
                        </DataTemplate>
                      </mvux:FeedView.NoneTemplate>
                    </mvux:FeedView>

                    <mvux:FeedView Source="{Binding Phone}">
                      <DataTemplate>
                        <TextBlock Text="{Binding Data}" Style="{StaticResource BodySmall}"
                                   Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                      </DataTemplate>
                      <mvux:FeedView.NoneTemplate>
                        <DataTemplate>
                          <TextBlock Text="(555) 123-4567" Style="{StaticResource BodySmall}"
                                     Foreground="{ThemeResource OutlineBrush}" FontStyle="Italic" />
                        </DataTemplate>
                      </mvux:FeedView.NoneTemplate>
                    </mvux:FeedView>

                    <mvux:FeedView Source="{Binding Email}">
                      <DataTemplate>
                        <TextBlock Text="{Binding Data}" Style="{StaticResource BodySmall}"
                                   Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                      </DataTemplate>
                      <mvux:FeedView.NoneTemplate>
                        <DataTemplate>
                          <TextBlock Text="you@company.com" Style="{StaticResource BodySmall}"
                                     Foreground="{ThemeResource OutlineBrush}" FontStyle="Italic" />
                        </DataTemplate>
                      </mvux:FeedView.NoneTemplate>
                    </mvux:FeedView>

                    <mvux:FeedView Source="{Binding Address}">
                      <DataTemplate>
                        <TextBlock Text="{Binding Data}" Style="{StaticResource BodySmall}"
                                   Foreground="{ThemeResource OnSurfaceVariantBrush}"
                                   TextTrimming="CharacterEllipsis" MaxLines="1" />
                      </DataTemplate>
                    </mvux:FeedView>

                    <mvux:FeedView Source="{Binding Website}">
                      <DataTemplate>
                        <TextBlock Text="{Binding Data}" Style="{StaticResource BodySmall}"
                                   Foreground="{ThemeResource PrimaryBrush}"
                                   TextTrimming="CharacterEllipsis" MaxLines="1" />
                      </DataTemplate>
                    </mvux:FeedView>

                    <mvux:FeedView Source="{Binding BusinessNumber}">
                      <DataTemplate>
                        <TextBlock Style="{StaticResource BodySmall}"
                                   Foreground="{ThemeResource OnSurfaceVariantBrush}">
                          <Run Text="Bus# " /><Run Text="{Binding Data}" />
                        </TextBlock>
                      </DataTemplate>
                    </mvux:FeedView>
                  </StackPanel>

                  <!-- Quote number -->
                  <StackPanel Grid.Column="2" HorizontalAlignment="Right" Spacing="{StaticResource Space2}">
                    <TextBlock Text="QUOTE" Style="{StaticResource TitleLarge}"
                               FontWeight="Bold" Foreground="{ThemeResource PrimaryBrush}" />
                    <mvux:FeedView Source="{Binding QuoteNumberPrefix}">
                      <DataTemplate>
                        <TextBlock Style="{StaticResource BodySmall}"
                                   Foreground="{ThemeResource OnSurfaceVariantBrush}">
                          <Run Text="#" /><Run Text="{Binding Data}" /><Run Text="001" />
                        </TextBlock>
                      </DataTemplate>
                    </mvux:FeedView>
                    <TextBlock Text="Mar 02, 2026" Style="{StaticResource BodySmall}"
                               Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                  </StackPanel>
                </Grid>

                <!-- Divider -->
                <Border Height="{StaticResource HairlineThickness}" Background="{ThemeResource OutlineVariantBrush}" Margin="{StaticResource InsetY20}" />

                <!-- Bill To -->
                <StackPanel Spacing="{StaticResource Space4}" Margin="{StaticResource GapBottom20}">
                  <TextBlock Text="BILL TO" Style="{StaticResource LabelSmall}"
                             FontWeight="Bold" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                  <TextBlock Text="Sample Client" Style="{StaticResource BodyMedium}"
                             Foreground="{ThemeResource OnSurfaceBrush}" />
                  <TextBlock Text="client@example.com" Style="{StaticResource BodySmall}"
                             Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                </StackPanel>

                <!-- Line items table header -->
                <utu:CardContentControl Style="{StaticResource TonalCardStyle}" CornerRadius="{StaticResource RadiusSm}"
                        Padding="{StaticResource Inset16x12}" Margin="{StaticResource GapBottom4}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="60" />
                      <ColumnDefinition Width="90" />
                      <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Description" Style="{StaticResource LabelSmall}"
                               FontWeight="Bold" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                    <TextBlock Grid.Column="1" Text="Qty" Style="{StaticResource LabelSmall}"
                               FontWeight="Bold" Foreground="{ThemeResource OnSurfaceVariantBrush}" TextAlignment="Right" />
                    <TextBlock Grid.Column="2" Text="Price" Style="{StaticResource LabelSmall}"
                               FontWeight="Bold" Foreground="{ThemeResource OnSurfaceVariantBrush}" TextAlignment="Right" />
                    <TextBlock Grid.Column="3" Text="Total" Style="{StaticResource LabelSmall}"
                               FontWeight="Bold" Foreground="{ThemeResource OnSurfaceVariantBrush}" TextAlignment="Right" />
                  </Grid>
                </utu:CardContentControl>

                <!-- Sample line items -->
                <Border Padding="{StaticResource Inset16x12}" Margin="{StaticResource GapBottom2}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="60" />
                      <ColumnDefinition Width="90" />
                      <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Copper pipe 1/2&quot;" Style="{StaticResource BodyMedium}"
                               Foreground="{ThemeResource OnSurfaceBrush}" />
                    <TextBlock Grid.Column="1" Text="10" Style="{StaticResource BodyMedium}"
                               Foreground="{ThemeResource OnSurfaceVariantBrush}" TextAlignment="Right" />
                    <TextBlock Grid.Column="2" Text="$12.50" Style="{StaticResource BodyMedium}"
                               FontFamily="{StaticResource MonospaceFontFamily}"
                               Foreground="{ThemeResource OnSurfaceVariantBrush}" TextAlignment="Right" />
                    <TextBlock Grid.Column="3" Text="$125.00" Style="{StaticResource BodyMedium}"
                               FontFamily="{StaticResource MonospaceFontFamily}"
                               Foreground="{ThemeResource OnSurfaceBrush}" TextAlignment="Right" />
                  </Grid>
                </Border>

                <utu:CardContentControl Style="{StaticResource StaticCardStyle}" BorderThickness="0" Padding="{StaticResource Inset16x12}" Background="{ThemeResource AlternateRowBrush}" CornerRadius="{StaticResource RadiusSm}" Margin="{StaticResource GapBottom2}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="60" />
                      <ColumnDefinition Width="90" />
                      <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Labor - Installation" Style="{StaticResource BodyMedium}"
                               Foreground="{ThemeResource OnSurfaceBrush}" />
                    <TextBlock Grid.Column="1" Text="4" Style="{StaticResource BodyMedium}"
                               Foreground="{ThemeResource OnSurfaceVariantBrush}" TextAlignment="Right" />
                    <TextBlock Grid.Column="2" Text="$75.00" Style="{StaticResource BodyMedium}"
                               FontFamily="{StaticResource MonospaceFontFamily}"
                               Foreground="{ThemeResource OnSurfaceVariantBrush}" TextAlignment="Right" />
                    <TextBlock Grid.Column="3" Text="$300.00" Style="{StaticResource BodyMedium}"
                               FontFamily="{StaticResource MonospaceFontFamily}"
                               Foreground="{ThemeResource OnSurfaceBrush}" TextAlignment="Right" />
                  </Grid>
                </utu:CardContentControl>

                <Border Padding="{StaticResource Inset16x12}" Margin="{StaticResource GapBottom2}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="60" />
                      <ColumnDefinition Width="90" />
                      <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Fittings &amp; connectors" Style="{StaticResource BodyMedium}"
                               Foreground="{ThemeResource OnSurfaceBrush}" />
                    <TextBlock Grid.Column="1" Text="8" Style="{StaticResource BodyMedium}"
                               Foreground="{ThemeResource OnSurfaceVariantBrush}" TextAlignment="Right" />
                    <TextBlock Grid.Column="2" Text="$4.50" Style="{StaticResource BodyMedium}"
                               FontFamily="{StaticResource MonospaceFontFamily}"
                               Foreground="{ThemeResource OnSurfaceVariantBrush}" TextAlignment="Right" />
                    <TextBlock Grid.Column="3" Text="$36.00" Style="{StaticResource BodyMedium}"
                               FontFamily="{StaticResource MonospaceFontFamily}"
                               Foreground="{ThemeResource OnSurfaceBrush}" TextAlignment="Right" />
                  </Grid>
                </Border>

                <!-- Totals -->
                <Border Height="{StaticResource HairlineThickness}" Background="{ThemeResource OutlineVariantBrush}" Margin="{StaticResource InsetY16}" />

                <Grid Margin="{StaticResource GapBottom8}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Subtotal" Style="{StaticResource BodyMedium}"
                             Foreground="{ThemeResource OnSurfaceVariantBrush}"
                             HorizontalAlignment="Right" Margin="{StaticResource GapEnd16}" />
                  <TextBlock Grid.Column="1" Text="$461.00" Style="{StaticResource BodyMedium}"
                             FontFamily="{StaticResource MonospaceFontFamily}"
                             Foreground="{ThemeResource OnSurfaceBrush}" TextAlignment="Right" />
                </Grid>

                <Grid Margin="{StaticResource GapBottom8}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource BodyMedium}"
                             Foreground="{ThemeResource OnSurfaceVariantBrush}"
                             HorizontalAlignment="Right" Margin="{StaticResource GapEnd16}"
                             Text="Markup" />
                  <TextBlock Grid.Column="1" Text="$69.15" Style="{StaticResource BodyMedium}"
                             FontFamily="{StaticResource MonospaceFontFamily}"
                             Foreground="{ThemeResource OnSurfaceBrush}" TextAlignment="Right" />
                </Grid>

                <Grid Margin="{StaticResource GapBottom8}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource BodyMedium}"
                             Foreground="{ThemeResource OnSurfaceVariantBrush}"
                             HorizontalAlignment="Right" Margin="{StaticResource GapEnd16}"
                             Text="Tax" />
                  <TextBlock Grid.Column="1" Text="$59.93" Style="{StaticResource BodyMedium}"
                             FontFamily="{StaticResource MonospaceFontFamily}"
                             Foreground="{ThemeResource OnSurfaceBrush}" TextAlignment="Right" />
                </Grid>

                <Border Height="{StaticResource RuleThickness}" Background="{ThemeResource PrimaryBrush}" Margin="{StaticResource InsetY8}" />

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="TOTAL" Style="{StaticResource TitleSmall}"
                             FontWeight="Bold" Foreground="{ThemeResource PrimaryBrush}"
                             HorizontalAlignment="Right" Margin="{StaticResource GapEnd16}" />
                  <TextBlock Grid.Column="1" Text="$520.93" Style="{StaticResource TitleSmall}"
                             FontWeight="Bold" FontFamily="{StaticResource MonospaceFontFamily}"
                             Foreground="{ThemeResource PrimaryBrush}" TextAlignment="Right" />
                </Grid>

                <!-- Notes -->
                <utu:CardContentControl Style="{StaticResource TonalCardStyle}"
                        Padding="{StaticResource CardInset}" Margin="{StaticResource GapTop24}">
                  <StackPanel Spacing="{StaticResource Space8}">
                    <TextBlock Text="NOTES" Style="{StaticResource LabelSmall}"
                               FontWeight="Bold" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                    <TextBlock Text="Please review the scope of work above. This quote includes all materials and labor as described. Payment terms: 50% deposit upon acceptance, balance due on completion. Work scheduled within 5 business days of acceptance."
                               Style="{StaticResource BodySmall}"
                               Foreground="{ThemeResource OnSurfaceVariantBrush}"
                               TextWrapping="Wrap" />
                  </StackPanel>
                </utu:CardContentControl>

                <!-- Valid until + currency -->
                <StackPanel Margin="{StaticResource GapTop16}" Spacing="{StaticResource Space4}">
                  <mvux:FeedView Source="{Binding QuoteValidDays}">
                    <DataTemplate>
                      <TextBlock Style="{StaticResource BodySmall}"
                                 Foreground="{ThemeResource OnSurfaceVariantBrush}">
                        <Run Text="Valid for " /><Run Text="{Binding Data}" /><Run Text=" days from issue date" />
                      </TextBlock>
                    </DataTemplate>
                  </mvux:FeedView>
                  <mvux:FeedView Source="{Binding CurrencyCode}">
                    <DataTemplate>
                      <TextBlock Style="{StaticResource BodySmall}"
                                 Foreground="{ThemeResource OnSurfaceVariantBrush}">
                        <Run Text="All amounts in " /><Run Text="{Binding Data}" />
                      </TextBlock>
                    </DataTemplate>
                  </mvux:FeedView>
                </StackPanel>

                <!-- Custom Footer -->
                <mvux:FeedView Source="{Binding CustomFooter}" Margin="{StaticResource GapTop12}">
                  <DataTemplate>
                    <TextBlock Text="{Binding Data}" Style="{StaticResource BodySmall}"
                               Foreground="{ThemeResource OnSurfaceVariantBrush}"
                               FontStyle="Italic" TextWrapping="Wrap"
                               Visibility="{Binding Data, Converter={StaticResource EmptyToVisibleConverter}, ConverterParameter=Invert}" />
                  </DataTemplate>
                </mvux:FeedView>

              </StackPanel>
          </utu:CardContentControl>
        </ScrollViewer>

    </Grid>
  </Grid>
</Page>
