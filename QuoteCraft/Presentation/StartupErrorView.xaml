<!--
  The window's content when QuoteCraft could not start (the database could not open, say), instead of a blank window
  (App.OnLaunched). Its DataContext is the failure's message. One centred column, capped at ReadingMaxWidth, at every
  width.
-->
<UserControl x:Class="QuoteCraft.Presentation.StartupErrorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsTabStop="False">
  <Grid Background="{ThemeResource BackgroundBrush}">
    <StackPanel MaxWidth="{StaticResource ReadingMaxWidth}"
                Spacing="{StaticResource Space150}"
                Padding="{StaticResource Space300Thickness}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
      <TextBlock Text="QuoteCraft could not start"
                 Style="{StaticResource TitleLarge}"
                 TextWrapping="Wrap"
                 AutomationProperties.HeadingLevel="Level1" />
      <TextBlock Text="{Binding}"
                 Style="{StaticResource BodyMedium}"
                 TextWrapping="Wrap"
                 AutomationProperties.LiveSetting="Assertive" />
      <TextBlock Text="Close QuoteCraft and open it again. If this keeps happening, the details are in the app log."
                 Style="{StaticResource BodyMedium}"
                 TextWrapping="Wrap" />
    </StackPanel>
  </Grid>
</UserControl>
