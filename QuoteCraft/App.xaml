<Application x:Class="QuoteCraft.App"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:helpers="using:QuoteCraft.Helpers"
       xmlns:utu="using:Uno.Toolkit.UI"
       xmlns:utum="using:Uno.Toolkit.UI.Material"
       xmlns:ut="using:Uno.Themes">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
        <utum:MaterialToolkitTheme>
          <!-- Uno Themes 9: colour overrides live on Colors (ColorOverrideSource is deprecated). -->
          <utum:MaterialToolkitTheme.Colors>
            <ut:ThemeColors OverrideSource="ms-appx:///Styles/ColorPaletteOverride.xaml" />
          </utum:MaterialToolkitTheme.Colors>
          <!-- Uno Themes 9: the type ramp (BodyMedium, TitleLarge, ...) reads DefaultFontFamily, which stayed Roboto;
               the Material*FontFamily keys still feed Material control styles. Weights resolve through
               Assets/Fonts/DMSans-Regular.ttf.manifest. -->
          <utum:MaterialToolkitTheme.FontOverrideDictionary>
            <ResourceDictionary>
              <FontFamily x:Key="DefaultFontFamily">ms-appx:///Assets/Fonts/DMSans-Regular.ttf#DM Sans</FontFamily>
              <FontFamily x:Key="MaterialLightFontFamily">ms-appx:///Assets/Fonts/DMSans-Regular.ttf#DM Sans</FontFamily>
              <FontFamily x:Key="MaterialRegularFontFamily">ms-appx:///Assets/Fonts/DMSans-Regular.ttf#DM Sans</FontFamily>
              <FontFamily x:Key="MaterialMediumFontFamily">ms-appx:///Assets/Fonts/DMSans-Medium.ttf#DM Sans Medium</FontFamily>
            </ResourceDictionary>
          </utum:MaterialToolkitTheme.FontOverrideDictionary>
        </utum:MaterialToolkitTheme>
        <ResourceDictionary Source="ms-appx:///Styles/StatusColors.xaml" />
        <ResourceDictionary Source="ms-appx:///Styles/Layout.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- App roles that change with the theme (Material roles are in Styles/ColorPaletteOverride.xaml). -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <Color x:Key="AlternateRowColor">#FAFBFC</Color>
          <SolidColorBrush x:Key="AlternateRowBrush" Color="{StaticResource AlternateRowColor}" />
          <Color x:Key="SuccessColor">#16A34A</Color>
          <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
          <!-- Side rail: hover and selection washes of the primary colour -->
          <Color x:Key="NavRailHoverColor">#1F2B4C7E</Color>
          <SolidColorBrush x:Key="NavRailHoverBrush" Color="{StaticResource NavRailHoverColor}" />
          <Color x:Key="NavRailSelectionColor">#332B4C7E</Color>
          <SolidColorBrush x:Key="NavRailSelectionBrush" Color="{StaticResource NavRailSelectionColor}" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <Color x:Key="AlternateRowColor">#1A2332</Color>
          <SolidColorBrush x:Key="AlternateRowBrush" Color="{StaticResource AlternateRowColor}" />
          <Color x:Key="SuccessColor">#4ADE80</Color>
          <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
          <Color x:Key="NavRailHoverColor">#1F93B5E1</Color>
          <SolidColorBrush x:Key="NavRailHoverBrush" Color="{StaticResource NavRailHoverColor}" />
          <Color x:Key="NavRailSelectionColor">#3393B5E1</Color>
          <SolidColorBrush x:Key="NavRailSelectionBrush" Color="{StaticResource NavRailSelectionColor}" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <!-- Bold/SemiBold typography variants (derived from Material styles) -->
      <Style x:Key="HeadlineMediumBold" TargetType="TextBlock" BasedOn="{StaticResource HeadlineMedium}">
        <Setter Property="FontWeight" Value="Bold" />
      </Style>
      <Style x:Key="HeadlineSmallBold" TargetType="TextBlock" BasedOn="{StaticResource HeadlineSmall}">
        <Setter Property="FontWeight" Value="Bold" />
      </Style>
      <Style x:Key="TitleLargeBold" TargetType="TextBlock" BasedOn="{StaticResource TitleLarge}">
        <Setter Property="FontWeight" Value="Bold" />
      </Style>
      <Style x:Key="TitleMediumBold" TargetType="TextBlock" BasedOn="{StaticResource TitleMedium}">
        <Setter Property="FontWeight" Value="Bold" />
      </Style>
      <Style x:Key="LabelLargeSemiBold" TargetType="TextBlock" BasedOn="{StaticResource LabelLarge}">
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>
      <Style x:Key="BodyMediumWeightMedium" TargetType="TextBlock" BasedOn="{StaticResource BodyMedium}">
        <Setter Property="FontWeight" Value="Medium" />
      </Style>
      <Style x:Key="BodyMediumSemiBold" TargetType="TextBlock" BasedOn="{StaticResource BodyMedium}">
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>
      <Style x:Key="BodySmallSemiBold" TargetType="TextBlock" BasedOn="{StaticResource BodySmall}">
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>

      <!-- Value Converters -->
      <helpers:CurrencyFormatConverter x:Key="CurrencyFormatConverter" />
      <helpers:RateFormatConverter x:Key="RateFormatConverter" />
      <helpers:RelativeDateConverter x:Key="RelativeDateConverter" />
      <helpers:InitialsConverter x:Key="InitialsConverter" />
      <helpers:EmptyToVisibleConverter x:Key="EmptyToVisibleConverter" />
      <helpers:UpperCaseConverter x:Key="UpperCaseConverter" />
      <helpers:ShortDateConverter x:Key="ShortDateConverter" />
      <helpers:InverseBoolConverter x:Key="InverseBoolConverter" />
      <helpers:StepVisibilityConverter x:Key="StepVisibilityConverter" />
      <helpers:ChevronConverter x:Key="ChevronConverter" />
      <helpers:PluralConverter x:Key="PluralConverter" />
      <!-- WinUI's {Binding} does not turn a bool into a Visibility (only x:Bind does): every bool-bound Visibility uses this. -->
      <helpers:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
      <helpers:ZeroToVisibleConverter x:Key="ZeroToVisibleConverter" />

      <!-- Brand colours: the same in Light and Dark (the slate band, the amber accent). -->
      <SolidColorBrush x:Key="ScrimBrush" Color="#80000000" />
      <Color x:Key="AppBarBackgroundColor">#2B4C7E</Color>
      <SolidColorBrush x:Key="AppBarBackgroundBrush" Color="{StaticResource AppBarBackgroundColor}" />
      <Color x:Key="AppBarForegroundColor">#FFFFFF</Color>
      <SolidColorBrush x:Key="AppBarForegroundBrush" Color="{StaticResource AppBarForegroundColor}" />
      <Color x:Key="AppBarAccentColor">#F59E0B</Color>
      <SolidColorBrush x:Key="AppBarAccentBrush" Color="{StaticResource AppBarAccentColor}" />
      <Color x:Key="AppBarButtonBackgroundColor">#26FFFFFF</Color>
      <SolidColorBrush x:Key="AppBarButtonBackgroundBrush" Color="{StaticResource AppBarButtonBackgroundColor}" />
      <!-- Text and icons on the amber accent: 5.6:1 (the slate band colour reached 4.0:1). -->
      <Color x:Key="OnAccentColor">#1A365D</Color>
      <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}" />

      <!-- Upgrade banner and dialog header gradient -->
      <Color x:Key="UpgradeBannerStartColor">#2B4C7E</Color>
      <Color x:Key="UpgradeBannerEndColor">#1A365D</Color>
      <Color x:Key="UpgradeBannerSubtitleColor">#B0C4DE</Color>
      <SolidColorBrush x:Key="UpgradeBannerSubtitleBrush" Color="{StaticResource UpgradeBannerSubtitleColor}" />
      <LinearGradientBrush x:Key="BannerGradientBrush" StartPoint="0,0" EndPoint="1,0.5">
        <GradientStop Color="{StaticResource UpgradeBannerStartColor}" Offset="0" />
        <GradientStop Color="{StaticResource UpgradeBannerEndColor}" Offset="1" />
      </LinearGradientBrush>

      <!-- Accent hover / pressed: lighter amber keeps the dark label above 4.5:1 (darker amber dropped it to 2.4:1) -->
      <Color x:Key="AppBarAccentHoverColor">#FBBF24</Color>
      <SolidColorBrush x:Key="AppBarAccentHoverBrush" Color="{StaticResource AppBarAccentHoverColor}" />
      <Color x:Key="AppBarAccentPressedColor">#FCD34D</Color>
      <SolidColorBrush x:Key="AppBarAccentPressedBrush" Color="{StaticResource AppBarAccentPressedColor}" />

      <!-- Pill buttons on the slate band: hover and pressed washes -->
      <Color x:Key="AppBarButtonHoverColor">#40FFFFFF</Color>
      <SolidColorBrush x:Key="AppBarButtonHoverBrush" Color="{StaticResource AppBarButtonHoverColor}" />
      <Color x:Key="AppBarButtonPressedColor">#1AFFFFFF</Color>
      <SolidColorBrush x:Key="AppBarButtonPressedBrush" Color="{StaticResource AppBarButtonPressedColor}" />

      <!-- Disabled controls -->
      <x:Double x:Key="DisabledOpacity">0.4</x:Double>
      <x:Double x:Key="SecondaryOpacity">0.7</x:Double>

      <!-- Monospace Font -->
      <FontFamily x:Key="MonospaceFontFamily">ms-appx:///Assets/Fonts/JetBrainsMono-Regular.ttf#JetBrains Mono</FontFamily>

      <!-- Accent Button Style (orange with darker hover/pressed) -->
      <Style x:Key="AccentButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource AppBarAccentBrush}" />
        <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
        <Setter Property="Padding" Value="{StaticResource ButtonInset}" />
        <Setter Property="MinHeight" Value="{StaticResource TouchTarget}" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="RootBorder"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="{TemplateBinding CornerRadius}"
                      Padding="{TemplateBinding Padding}">
                <VisualStateManager.VisualStateGroups>
                  <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                      <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder"
                                                       Storyboard.TargetProperty="Background">
                          <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource AppBarAccentHoverBrush}" />
                        </ObjectAnimationUsingKeyFrames>
                      </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                      <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder"
                                                       Storyboard.TargetProperty="Background">
                          <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource AppBarAccentPressedBrush}" />
                        </ObjectAnimationUsingKeyFrames>
                      </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                      <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder"
                                                       Storyboard.TargetProperty="Opacity">
                          <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{StaticResource DisabledOpacity}" />
                        </ObjectAnimationUsingKeyFrames>
                      </Storyboard>
                    </VisualState>
                  </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <ContentPresenter Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Inline TextBox Style (compact, no Material chrome, with focus states): Settings' right-aligned value fields -->
      <Style x:Key="InlineTextBoxStyle" TargetType="TextBox">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="{StaticResource Inset8x4}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
        <Setter Property="FontSize" Value="{StaticResource BodyMediumFontSize}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="TextBox">
              <Border x:Name="RootBorder"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      Padding="{TemplateBinding Padding}"
                      CornerRadius="{StaticResource RadiusSm}">
                <VisualStateManager.VisualStateGroups>
                  <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                      <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder"
                                                       Storyboard.TargetProperty="BorderBrush">
                          <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource OnSurfaceVariantBrush}" />
                        </ObjectAnimationUsingKeyFrames>
                      </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Focused">
                      <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder"
                                                       Storyboard.TargetProperty="BorderBrush">
                          <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource PrimaryBrush}" />
                        </ObjectAnimationUsingKeyFrames>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder"
                                                       Storyboard.TargetProperty="BorderThickness">
                          <DiscreteObjectKeyFrame KeyTime="0" Value="0,0,0,2" />
                        </ObjectAnimationUsingKeyFrames>
                      </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                      <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder"
                                                       Storyboard.TargetProperty="Opacity">
                          <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource DisabledOpacity}" />
                        </ObjectAnimationUsingKeyFrames>
                      </Storyboard>
                    </VisualState>
                  </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Grid>
                  <!-- The TextBox shows this part while the text is empty (inline fields are right-aligned) -->
                  <ContentControl x:Name="PlaceholderTextContentPresenter"
                                  Content="{TemplateBinding PlaceholderText}"
                                  Foreground="{ThemeResource OnSurfaceVariantBrush}"
                                  HorizontalContentAlignment="Right"
                                  HorizontalAlignment="Stretch"
                                  IsHitTestVisible="False"
                                  IsTabStop="False" />
                  <ScrollViewer x:Name="ContentElement"
                                HorizontalScrollBarVisibility="Hidden"
                                VerticalScrollBarVisibility="Hidden"
                                HorizontalScrollMode="Auto"
                                VerticalScrollMode="Disabled"
                                IsHorizontalRailEnabled="True"
                                IsVerticalRailEnabled="False"
                                IsTabStop="False"
                                AutomationProperties.AccessibilityView="Raw" />
                </Grid>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- App Bar Pill Button Style (with full interaction states) -->
      <Style x:Key="AppBarPillButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource AppBarButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource AppBarForegroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
        <Setter Property="Padding" Value="{StaticResource Inset16x8}" />
        <Setter Property="MinHeight" Value="{StaticResource TouchTarget}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="RootBorder"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="{TemplateBinding CornerRadius}"
                      Padding="{TemplateBinding Padding}">
                <VisualStateManager.VisualStateGroups>
                  <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                      <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder"
                                                       Storyboard.TargetProperty="Background">
                          <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource AppBarButtonHoverBrush}" />
                        </ObjectAnimationUsingKeyFrames>
                      </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                      <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder"
                                                       Storyboard.TargetProperty="Background">
                          <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource AppBarButtonPressedBrush}" />
                        </ObjectAnimationUsingKeyFrames>
                      </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                      <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder"
                                                       Storyboard.TargetProperty="Opacity">
                          <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{StaticResource DisabledOpacity}" />
                        </ObjectAnimationUsingKeyFrames>
                      </Storyboard>
                    </VisualState>
                  </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <ContentPresenter Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Vertical TabBar Style (no background, no chrome) -->
      <Style x:Key="VerticalTabBarStyle" TargetType="utu:TabBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
      </Style>

      <!-- Side Nav TabBarItem Style (horizontal icon + label) -->
      <Style x:Key="SideNavTabBarItemStyle" TargetType="utu:TabBarItem">
        <Setter Property="Height" Value="{StaticResource RailItemHeight}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="utu:TabBarItem">
              <Border x:Name="RootBorder"
                      Background="Transparent"
                      CornerRadius="{StaticResource RadiusMd}"
                      Padding="{StaticResource RailItemInset}"
                      Margin="{StaticResource RailItemMargin}">
                <VisualStateManager.VisualStateGroups>
                  <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                      <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder"
                                                       Storyboard.TargetProperty="Background">
                          <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource NavRailHoverBrush}" />
                        </ObjectAnimationUsingKeyFrames>
                      </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                      <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder"
                                                       Storyboard.TargetProperty="Background">
                          <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource NavRailSelectionBrush}" />
                        </ObjectAnimationUsingKeyFrames>
                      </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                      <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder"
                                                       Storyboard.TargetProperty="Opacity">
                          <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{StaticResource DisabledOpacity}" />
                        </ObjectAnimationUsingKeyFrames>
                      </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Selected">
                      <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder"
                                                       Storyboard.TargetProperty="Background">
                          <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource NavRailSelectionBrush}" />
                        </ObjectAnimationUsingKeyFrames>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="IconHost"
                                                       Storyboard.TargetProperty="Foreground">
                          <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource PrimaryBrush}" />
                        </ObjectAnimationUsingKeyFrames>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="LabelText"
                                                       Storyboard.TargetProperty="Foreground">
                          <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource PrimaryBrush}" />
                        </ObjectAnimationUsingKeyFrames>
                      </Storyboard>
                    </VisualState>
                  </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space12}">
                  <ContentControl x:Name="IconHost"
                                  Content="{TemplateBinding Icon}"
                                  Foreground="{ThemeResource OnSurfaceVariantBrush}"
                                  IsTabStop="False"
                                  VerticalAlignment="Center"
                                  VerticalContentAlignment="Center"
                                  HorizontalContentAlignment="Center" />
                  <TextBlock x:Name="LabelText"
                             Text="{TemplateBinding Content}"
                             Foreground="{ThemeResource OnSurfaceVariantBrush}"
                             Style="{StaticResource LabelLarge}"
                             VerticalAlignment="Center" />
                </StackPanel>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

    </ResourceDictionary>
  </Application.Resources>

</Application>
