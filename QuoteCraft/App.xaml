<Application x:Class="QuoteCraft.App"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:helpers="using:QuoteCraft.Helpers"
       xmlns:utu="using:Uno.Toolkit.UI"
       xmlns:utum="using:Uno.Toolkit.UI.Material"
       xmlns:ut="using:Uno.Themes"
       xmlns:win="http://schemas.microsoft.com/winfx/2006/xaml/presentation">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
        <utum:MaterialToolkitTheme>
          <!-- Uno Themes 9: colour overrides live on Colors (ColorOverrideSource is deprecated). -->
          <utum:MaterialToolkitTheme.Colors>
            <ut:ThemeColors OverrideSource="ms-appx:///Styles/ColorPaletteOverride.xaml" />
          </utum:MaterialToolkitTheme.Colors>
          <!-- Uno Themes 9: the type ramp (BodyMedium, TitleLarge, ...) reads DefaultFontFamily, which stayed Roboto;
               the Material*FontFamily keys still feed Material control styles. Weights resolve through
               Assets/Fonts/DMSans-Regular.ttf.manifest. -->
          <utum:MaterialToolkitTheme.FontOverrideDictionary>
            <ResourceDictionary>
              <FontFamily x:Key="DefaultFontFamily">ms-appx:///Assets/Fonts/DMSans-Regular.ttf#DM Sans</FontFamily>
              <FontFamily x:Key="MaterialLightFontFamily">ms-appx:///Assets/Fonts/DMSans-Regular.ttf#DM Sans</FontFamily>
              <FontFamily x:Key="MaterialRegularFontFamily">ms-appx:///Assets/Fonts/DMSans-Regular.ttf#DM Sans</FontFamily>
              <FontFamily x:Key="MaterialMediumFontFamily">ms-appx:///Assets/Fonts/DMSans-Medium.ttf#DM Sans Medium</FontFamily>
            </ResourceDictionary>
          </utum:MaterialToolkitTheme.FontOverrideDictionary>
        </utum:MaterialToolkitTheme>
        <ResourceDictionary Source="ms-appx:///Styles/BrandColors.xaml" />
        <ResourceDictionary Source="ms-appx:///Styles/StatusColors.xaml" />
        <ResourceDictionary Source="ms-appx:///Styles/Layout.xaml" />
        <ResourceDictionary Source="ms-appx:///Styles/Cards.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- The rail's Theme button shows the window's theme: a sun in Light, a moon in Dark. -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <x:String x:Key="ThemeIconGlyph">&#xE706;</x:String>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <x:String x:Key="ThemeIconGlyph">&#xE708;</x:String>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <!-- Bold/SemiBold typography variants (derived from Material styles) -->
      <Style x:Key="HeadlineMediumBold" TargetType="TextBlock" BasedOn="{StaticResource HeadlineMedium}">
        <Setter Property="FontWeight" Value="Bold" />
      </Style>
      <Style x:Key="HeadlineSmallBold" TargetType="TextBlock" BasedOn="{StaticResource HeadlineSmall}">
        <Setter Property="FontWeight" Value="Bold" />
      </Style>
      <Style x:Key="TitleLargeBold" TargetType="TextBlock" BasedOn="{StaticResource TitleLarge}">
        <Setter Property="FontWeight" Value="Bold" />
      </Style>
      <Style x:Key="TitleMediumBold" TargetType="TextBlock" BasedOn="{StaticResource TitleMedium}">
        <Setter Property="FontWeight" Value="Bold" />
      </Style>
      <Style x:Key="LabelLargeSemiBold" TargetType="TextBlock" BasedOn="{StaticResource LabelLarge}">
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>
      <Style x:Key="BodyMediumWeightMedium" TargetType="TextBlock" BasedOn="{StaticResource BodyMedium}">
        <Setter Property="FontWeight" Value="Medium" />
      </Style>
      <Style x:Key="BodyMediumSemiBold" TargetType="TextBlock" BasedOn="{StaticResource BodyMedium}">
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>
      <Style x:Key="BodySmallSemiBold" TargetType="TextBlock" BasedOn="{StaticResource BodySmall}">
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>

      <!-- Value Converters -->
      <helpers:CurrencyFormatConverter x:Key="CurrencyFormatConverter" />
      <helpers:RateFormatConverter x:Key="RateFormatConverter" />
      <helpers:RelativeDateConverter x:Key="RelativeDateConverter" />
      <helpers:InitialsConverter x:Key="InitialsConverter" />
      <helpers:EmptyToVisibleConverter x:Key="EmptyToVisibleConverter" />
      <helpers:UpperCaseConverter x:Key="UpperCaseConverter" />
      <helpers:ShortDateConverter x:Key="ShortDateConverter" />
      <helpers:InverseBoolConverter x:Key="InverseBoolConverter" />
      <helpers:StepVisibilityConverter x:Key="StepVisibilityConverter" />
      <helpers:ChevronConverter x:Key="ChevronConverter" />
      <helpers:PluralConverter x:Key="PluralConverter" />
      <!-- WinUI's {Binding} does not turn a bool into a Visibility (only x:Bind does): every bool-bound Visibility uses this. -->
      <helpers:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
      <helpers:ZeroToVisibleConverter x:Key="ZeroToVisibleConverter" />

      <!-- Disabled controls -->
      <x:Double x:Key="DisabledOpacity">0.4</x:Double>
      <x:Double x:Key="SecondaryOpacity">0.7</x:Double>

      <!-- Monospace Font -->
      <FontFamily x:Key="MonospaceFontFamily">ms-appx:///Assets/Fonts/JetBrainsMono-Regular.ttf#JetBrains Mono</FontFamily>

      <!-- Accent Button Style (orange with darker hover/pressed) -->
      <Style x:Key="AccentButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource AppBarAccentInvariantBrush}" />
        <Setter Property="Foreground" Value="{StaticResource OnAccentFixedBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
        <Setter Property="Padding" Value="{StaticResource ButtonInset}" />
        <Setter Property="MinHeight" Value="{StaticResource TouchTarget}" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="RootBorder"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="{TemplateBinding CornerRadius}"
                      Padding="{TemplateBinding Padding}">
                <VisualStateManager.VisualStateGroups>
                  <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                      <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder"
                                                       Storyboard.TargetProperty="Background">
                          <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource AppBarAccentHoverFixedBrush}" />
                        </ObjectAnimationUsingKeyFrames>
                      </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                      <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder"
                                                       Storyboard.TargetProperty="Background">
                          <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource AppBarAccentPressedFixedBrush}" />
                        </ObjectAnimationUsingKeyFrames>
                      </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                      <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder"
                                                       Storyboard.TargetProperty="Opacity">
                          <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{StaticResource DisabledOpacity}" />
                        </ObjectAnimationUsingKeyFrames>
                      </Storyboard>
                    </VisualState>
                  </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <ContentPresenter Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Drawers opened by "!" Page routes (Presentation/DrawerFlyout): from the right, sized for a list. -->
      <Style x:Key="SideDrawerFlyoutPresenterStyle" TargetType="FlyoutPresenter" BasedOn="{StaticResource RightDrawerFlyoutPresenterStyle}">
        <Setter Property="utu:DrawerFlyoutPresenter.DrawerLength" Value="420" />
      </Style>
      <!--
        microsoft/microsoft-ui-xaml#6388 (WinAppSDK only): an attached-property setter in a style BasedOn a style whose
        template lives in another library throws when the template is created, unless the consuming assembly also
        references those properties in a template. The Toolkit docs prescribe this definition-only style; it is never used.
      -->
      <win:Style x:Key="MUX6388_Workaround_ForDefinitionOnly" TargetType="FlyoutPresenter">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="FlyoutPresenter">
              <utu:DrawerFlyoutPresenter OpenDirection="{TemplateBinding utu:DrawerFlyoutPresenter.OpenDirection}"
                                         DrawerLength="{TemplateBinding utu:DrawerFlyoutPresenter.DrawerLength}"
                                         LightDismissOverlayBackground="{TemplateBinding utu:DrawerFlyoutPresenter.LightDismissOverlayBackground}"
                                         IsGestureEnabled="{TemplateBinding utu:DrawerFlyoutPresenter.IsGestureEnabled}"
                                         IsLightDismissEnabled="{TemplateBinding utu:DrawerFlyoutPresenter.IsLightDismissEnabled}" />
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </win:Style>

      <!-- Inline TextBox Style (compact, no Material chrome, with focus states): Settings' right-aligned value fields -->
      <Style x:Key="InlineTextBoxStyle" TargetType="TextBox">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="{StaticResource Inset8x4}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
        <Setter Property="FontSize" Value="{StaticResource BodyMediumFontSize}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="TextBox">
              <Border x:Name="RootBorder"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      Padding="{TemplateBinding Padding}"
                      CornerRadius="{StaticResource RadiusSm}">
                <VisualStateManager.VisualStateGroups>
                  <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                      <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder"
                                                       Storyboard.TargetProperty="BorderBrush">
                          <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource OnSurfaceVariantBrush}" />
                        </ObjectAnimationUsingKeyFrames>
                      </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Focused">
                      <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder"
                                                       Storyboard.TargetProperty="BorderBrush">
                          <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource PrimaryBrush}" />
                        </ObjectAnimationUsingKeyFrames>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder"
                                                       Storyboard.TargetProperty="BorderThickness">
                          <DiscreteObjectKeyFrame KeyTime="0" Value="0,0,0,2" />
                        </ObjectAnimationUsingKeyFrames>
                      </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                      <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder"
                                                       Storyboard.TargetProperty="Opacity">
                          <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource DisabledOpacity}" />
                        </ObjectAnimationUsingKeyFrames>
                      </Storyboard>
                    </VisualState>
                  </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Grid>
                  <!-- The TextBox shows this part while the text is empty (inline fields are right-aligned) -->
                  <ContentControl x:Name="PlaceholderTextContentPresenter"
                                  Content="{TemplateBinding PlaceholderText}"
                                  Foreground="{ThemeResource OnSurfaceVariantBrush}"
                                  HorizontalContentAlignment="Right"
                                  HorizontalAlignment="Stretch"
                                  IsHitTestVisible="False"
                                  IsTabStop="False" />
                  <ScrollViewer x:Name="ContentElement"
                                HorizontalScrollBarVisibility="Hidden"
                                VerticalScrollBarVisibility="Hidden"
                                HorizontalScrollMode="Auto"
                                VerticalScrollMode="Disabled"
                                IsHorizontalRailEnabled="True"
                                IsVerticalRailEnabled="False"
                                IsTabStop="False"
                                AutomationProperties.AccessibilityView="Raw" />
                </Grid>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- App Bar Pill Button Style (with full interaction states) -->
      <Style x:Key="AppBarPillButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource AppBarButtonBackgroundFixedBrush}" />
        <Setter Property="Foreground" Value="{StaticResource AppBarForegroundFixedBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
        <Setter Property="Padding" Value="{StaticResource Inset16x8}" />
        <Setter Property="MinHeight" Value="{StaticResource TouchTarget}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="RootBorder"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="{TemplateBinding CornerRadius}"
                      Padding="{TemplateBinding Padding}">
                <VisualStateManager.VisualStateGroups>
                  <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                      <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder"
                                                       Storyboard.TargetProperty="Background">
                          <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource AppBarButtonHoverFixedBrush}" />
                        </ObjectAnimationUsingKeyFrames>
                      </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                      <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder"
                                                       Storyboard.TargetProperty="Background">
                          <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource AppBarButtonPressedFixedBrush}" />
                        </ObjectAnimationUsingKeyFrames>
                      </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                      <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder"
                                                       Storyboard.TargetProperty="Opacity">
                          <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{StaticResource DisabledOpacity}" />
                        </ObjectAnimationUsingKeyFrames>
                      </Storyboard>
                    </VisualState>
                  </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <ContentPresenter Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Vertical TabBar Style (no background, no chrome) -->
      <Style x:Key="VerticalTabBarStyle" TargetType="utu:TabBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
      </Style>

      <!-- Side Nav TabBarItem Style (horizontal icon + label) -->
      <Style x:Key="SideNavTabBarItemStyle" TargetType="utu:TabBarItem">
        <Setter Property="Height" Value="{StaticResource RailItemHeight}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="utu:TabBarItem">
              <Border x:Name="RootBorder"
                      Background="Transparent"
                      CornerRadius="{StaticResource RadiusMd}"
                      Padding="{StaticResource RailItemInset}"
                      Margin="{StaticResource RailItemMargin}">
                <VisualStateManager.VisualStateGroups>
                  <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                      <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder"
                                                       Storyboard.TargetProperty="Background">
                          <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource NavRailHoverBrush}" />
                        </ObjectAnimationUsingKeyFrames>
                      </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                      <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder"
                                                       Storyboard.TargetProperty="Background">
                          <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource NavRailSelectionBrush}" />
                        </ObjectAnimationUsingKeyFrames>
                      </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                      <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder"
                                                       Storyboard.TargetProperty="Opacity">
                          <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{StaticResource DisabledOpacity}" />
                        </ObjectAnimationUsingKeyFrames>
                      </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Selected">
                      <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder"
                                                       Storyboard.TargetProperty="Background">
                          <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource NavRailSelectionBrush}" />
                        </ObjectAnimationUsingKeyFrames>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="IconHost"
                                                       Storyboard.TargetProperty="Foreground">
                          <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource PrimaryBrush}" />
                        </ObjectAnimationUsingKeyFrames>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="LabelText"
                                                       Storyboard.TargetProperty="Foreground">
                          <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource PrimaryBrush}" />
                        </ObjectAnimationUsingKeyFrames>
                      </Storyboard>
                    </VisualState>
                  </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space12}">
                  <ContentControl x:Name="IconHost"
                                  Content="{TemplateBinding Icon}"
                                  Foreground="{ThemeResource OnSurfaceVariantBrush}"
                                  IsTabStop="False"
                                  VerticalAlignment="Center"
                                  VerticalContentAlignment="Center"
                                  HorizontalContentAlignment="Center" />
                  <TextBlock x:Name="LabelText"
                             Text="{TemplateBinding Content}"
                             Foreground="{ThemeResource OnSurfaceVariantBrush}"
                             Style="{StaticResource LabelLarge}"
                             VerticalAlignment="Center" />
                </StackPanel>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

    </ResourceDictionary>
  </Application.Resources>

</Application>
