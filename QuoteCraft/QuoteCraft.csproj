<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <!-- Uno.Sdk skips the heads the build OS can't build (iOS on Linux). -->
    <TargetFrameworks>net10.0-android;net10.0-ios;net10.0-browserwasm;net10.0-desktop</TargetFrameworks>
    <!--
      App-only override for single-head builds (CI, RID-specific publish): -p:QuoteCraftTargetFrameworks=net10.0-desktop.
      A global -p:TargetFrameworks would also retarget the test project.
    -->
    <TargetFrameworks Condition="'$(QuoteCraftTargetFrameworks)' != ''">$(QuoteCraftTargetFrameworks)</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>

    <!-- Display name -->
    <ApplicationTitle>QuoteCraft</ApplicationTitle>
    <!-- App Identifier -->
    <ApplicationId>com.companyname.quotecraft</ApplicationId>
    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- Package Publisher -->
    <ApplicationPublisher>QuoteCraft</ApplicationPublisher>
    <!-- Package Description -->
    <Description>QuoteCraft powered by Uno Platform.</Description>
    <!-- Uno0001 = member not implemented in Uno Platform: fail the build instead of shipping a silent no-op. -->
    <WarningsAsErrors>$(WarningsAsErrors);Uno0001</WarningsAsErrors>

    <!--
      UnoFeatures are used to quickly add and manage features enabled for your app.
      https://aka.platform.uno/singleproject-features
    -->
    <UnoFeatures>
      Material;
      Hosting;
      Toolkit;
      Logging;
      MVUX;
      Configuration;
      Navigation;
      SkiaRenderer;
    </UnoFeatures>
  </PropertyGroup>

  <ItemGroup>
    <!-- WholeFeedViewStateSelector.StatesFor: the tests' seam onto a protected override -->
    <InternalsVisibleTo Include="QuoteCraft.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite.Core" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlcipher" />
  </ItemGroup>

  <!--
    WebAssembly keeps the database and files in the browser's IndexedDB (IDBFS, mounted under ApplicationData's
    folders). Without it the file system is in memory and every page load started from scratch.
  -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-browserwasm'">
    <WasmShellEnableIDBFS>true</WasmShellEnableIDBFS>
    <!--
      WASM0001: SQLitePCLRaw declares sqlite3_config and sqlite3_db_config, which take varargs that WebAssembly cannot
      call. Microsoft.Data.Sqlite does not call them; the database opens, reads and writes in the browser.
    -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);WASM0001</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <!--
    WebAssembly: SQLitePCLRaw 2.1.10 links its net8.0 e_sqlcipher.a (built for .NET 8's emscripten) whatever the .NET
    version, and in a .NET 10 build every database write failed with "disk I/O error". The package's net9.0 build
    matches the emscripten that .NET 9 and 10 use (3.1.56), so it takes its place before the native link.
  -->
  <Target Name="QuoteCraftLinkMatchingSqlCipher"
          BeforeTargets="_PrepareForBrowserWasmBuildNative"
          Condition="'$(RuntimeIdentifier)' == 'browser-wasm'">
    <ItemGroup>
      <_QuoteCraftSqlCipher Include="@(NativeFileReference->'%(FullPath)')" Condition="'%(Filename)' == 'e_sqlcipher'" />
      <NativeFileReference Remove="@(NativeFileReference)" Condition="'%(Filename)' == 'e_sqlcipher'" />
      <NativeFileReference Include="@(_QuoteCraftSqlCipher->Replace('nativeassets/net8.0', 'nativeassets/net9.0')->Replace('nativeassets\net8.0', 'nativeassets\net9.0'))" />
    </ItemGroup>
    <Message Importance="high" Text="QuoteCraft: linking @(NativeFileReference->WithMetadataValue('Filename', 'e_sqlcipher'))" />
  </Target>

</Project>
