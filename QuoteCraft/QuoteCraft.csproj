<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <!-- Uno.Sdk skips the heads the build OS can't build (iOS on Linux, Windows off Windows). -->
    <TargetFrameworks>net10.0-android;net10.0-ios;net10.0-windows10.0.19041;net10.0-browserwasm;net10.0-desktop</TargetFrameworks>
    <!--
      App-only override for single-head builds (CI, RID-specific publish): -p:QuoteCraftTargetFrameworks=net10.0-desktop.
      A global -p:TargetFrameworks would also retarget the test project.
    -->
    <TargetFrameworks Condition="'$(QuoteCraftTargetFrameworks)' != ''">$(QuoteCraftTargetFrameworks)</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>

    <!-- Display name -->
    <ApplicationTitle>QuoteCraft</ApplicationTitle>
    <!-- App Identifier -->
    <ApplicationId>com.companyname.quotecraft</ApplicationId>
    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- Package Publisher -->
    <ApplicationPublisher>QuoteCraft</ApplicationPublisher>
    <!-- Package Description -->
    <Description>QuoteCraft powered by Uno Platform.</Description>
    <!-- Uno0001 = member not implemented in Uno Platform: fail the build instead of shipping a silent no-op. -->
    <WarningsAsErrors>$(WarningsAsErrors);Uno0001</WarningsAsErrors>

    <!--
      UnoFeatures are used to quickly add and manage features enabled for your app.
      https://aka.platform.uno/singleproject-features
    -->
    <UnoFeatures>
      Material;
      Hosting;
      Toolkit;
      Logging;
      MVUX;
      Configuration;
      Http;
      Serialization;
      Navigation;
      SkiaRenderer;
    </UnoFeatures>
    <!--
      Uno.Sdk 7.0.0-dev.115 bundles Hot Design 2.0.0-dev.31 and App MCP 2.0.0-dev.18, whose clients still reference
      Uno.UI.Lottie, an assembly Uno 7 no longer ships: every Debug launch crashed in GlobalStaticResources. Both stay off
      (Debug only; Release never had them) until a dev build drops the reference. Delete these three lines then.
    -->
    <UnoDisableHotDesign>true</UnoDisableHotDesign>
    <UnoDisableMCPSupport>true</UnoDisableMCPSupport>
    <DefineConstants>$(DefineConstants);NO_UNO_STUDIO</DefineConstants>
  </PropertyGroup>

  <!--
    WinAppSDK: build x64 or ARM64, never AnyCPU (SkiaSharp and SQLCipher ship per-architecture native libraries).
    Uno 7's WinUI libraries are built against WinRT.Runtime 2.3.1; the SDK's default projection for 19041
    (Microsoft.Windows.SDK.NET.Ref 10.0.19041.57) carries 2.2.0 and fails with CS1705, so pin a projection that matches.
  -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <Platforms>x64;ARM64</Platforms>
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <WindowsSdkPackageVersion>10.0.19041.87</WindowsSdkPackageVersion>
  </PropertyGroup>

  <!--
    QuestPDF ships native libraries for Windows, Linux and macOS only, so PDF export exists on the desktop and
    WinAppSDK heads (docs/DECISIONS-production-readiness.md, D2). QUESTPDF gates the generator in code.
  -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-desktop' or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <DefineConstants>$(DefineConstants);QUESTPDF</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite.Core" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlcipher" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-desktop' or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <PackageReference Include="QuestPDF" />
  </ItemGroup>

</Project>
